@model AplicacionCuria.Models.UsuarioRegisterRequest

@{
    ViewData["Title"] = "Gestión de Usuarios";
    var usuarios = ViewBag.Usuarios as List<AplicacionCuria.Models.Usuario> ?? new List<AplicacionCuria.Models.Usuario>();
    bool esEdicion = Model != null && Model.Id > 0;
}

<div class="mb-3 text-center">
    <h1 class="h3 mb-0 text-primary fw-bold">Gestión de Usuarios</h1>
    <p class="text-muted small">Administración de credenciales, roles y acceso de usuarios al sistema ECLESOFT</p>
</div>

<!-- Mensajes de feedback -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm py-2 px-3 small mb-3" role="alert">
        <i class="fas fa-check-circle me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close small" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm py-2 px-3 small mb-3" role="alert">
        <i class="fas fa-exclamation-circle me-1"></i> @ViewBag.Error
        <button type="button" class="btn-close small" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-warning alert-dismissible fade show shadow-sm py-2 px-3 small mb-3" role="alert">
        <i class="fas fa-exclamation-triangle me-1"></i> Corrija los errores del formulario e intente nuevamente.
        <button type="button" class="btn-close small" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row justify-content-center align-items-start g-3">
    <!-- Columna Izquierda: Formulario de Usuario -->
    <div class="col-lg-5 col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title text-primary fw-bold mb-0">
                        <i class="fas @(esEdicion ? "fa-user-edit" : "fa-user-plus") me-1"></i>
                        @(esEdicion ? "Editar Usuario" : "Registrar Nuevo Usuario")
                    </h5>
                    @if (esEdicion)
                    {
                        <span class="badge bg-warning text-dark"><i class="fas fa-pen me-1"></i>Modo Edición</span>
                    }
                </div>

                @if (esEdicion)
                {
                    <div class="alert alert-info py-1 px-2 small mb-3 d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-info-circle me-1"></i> Modificando usuario ID: <strong>#@Model.Id</strong></span>
                        <a asp-action="CrearUsuario" class="btn btn-xs btn-outline-secondary py-0 px-2 text-decoration-none" style="font-size:0.75rem;">
                            <i class="fas fa-times me-1"></i> Cancelar
                        </a>
                    </div>
                }

                <form asp-action="CrearUsuario" method="post" autocomplete="off">
                    @if (esEdicion)
                    {
                        <input type="hidden" asp-for="Id" />
                    }

                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label asp-for="Nombre" class="form-label mb-1 fw-semibold small">Nombres</label>
                            <input asp-for="Nombre" class="form-control form-control-sm" placeholder="Ingrese nombres" required />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label asp-for="Apellido" class="form-label mb-1 fw-semibold small">Apellidos</label>
                            <input asp-for="Apellido" class="form-control form-control-sm" placeholder="Ingrese apellidos" required />
                            <span asp-validation-for="Apellido" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Email" class="form-label mb-1 fw-semibold small">Correo Electrónico</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="fas fa-envelope text-muted"></i></span>
                            <input asp-for="Email" type="email" class="form-control form-control-sm" placeholder="usuario@correo.com" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label asp-for="Rol" class="form-label mb-1 fw-semibold small">Rol en el Sistema</label>
                            <select asp-for="Rol" class="form-select form-select-sm" required>
                                <option value="">Seleccione un rol</option>
                                <option value="admin">Administrador</option>
                                <option value="personal">Personal</option>
                            </select>
                            <span asp-validation-for="Rol" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-2">
                            <label asp-for="Password" class="form-label mb-1 fw-semibold small">
                                @(esEdicion ? "Nueva Contraseña" : "Contraseña")
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
                                @if (esEdicion)
                                {
                                    <input asp-for="Password" type="password" class="form-control form-control-sm" placeholder="Dejar vacío si no cambia" />
                                }
                                else
                                {
                                    <input asp-for="Password" type="password" class="form-control form-control-sm" placeholder="Mín. 6 caracteres" required />
                                }
                                <button class="btn btn-outline-secondary" type="button" id="btnTogglePasswordUsuario" tabindex="-1" title="Mostrar/ocultar contraseña">
                                    <i class="fas fa-eye" id="iconTogglePasswordUsuario"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-2">
                        @if (ViewBag.EsSuperAdmin == true)
                        {
                            var listaParrs = ViewBag.Parroquias as List<AplicacionCuria.Models.Parroquia>;
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="ParroquiaId" class="form-label mb-0 fw-semibold small">Sede / Parroquia Asignada</label>
                                <a href="/Submenus/ParroquiaView" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.72rem;" title="Ir a registrar una nueva parroquia">+ Nueva</a>
                            </div>
                            <select asp-for="ParroquiaId" class="form-select form-select-sm">
                                <option value="">Curia Central / Superadmin (Todas)</option>
                                @if (listaParrs != null)
                                {
                                    foreach (var p in listaParrs)
                                    {
                                        <option value="@p.id">🏛️ @p.nombre</option>
                                    }
                                }
                            </select>
                            @if (listaParrs == null || listaParrs.Count == 0)
                            {
                                <div class="text-danger small mt-1" style="font-size: 0.75rem;">
                                    No hay parroquias registradas. <a href="/Submenus/ParroquiaView" class="fw-bold text-decoration-underline">Registrar una aquí</a>.
                                </div>
                            }
                            <span asp-validation-for="ParroquiaId" class="text-danger small"></span>
                        }
                        else
                        {
                            var miParr = (ViewBag.Parroquias as List<AplicacionCuria.Models.Parroquia>)?.FirstOrDefault(p => p.id == (int?)ViewBag.UserParroquiaId);
                            <label class="form-label mb-1 fw-semibold small">Sede / Parroquia</label>
                            <input type="text" class="form-control form-control-sm bg-light" value="@(miParr?.nombre ?? "Parroquia Asignada")" readonly />
                            <input type="hidden" asp-for="ParroquiaId" value="@ViewBag.UserParroquiaId" />
                        }
                    </div>

                    @if (esEdicion)
                    {
                        <div class="form-text small text-muted mb-3">
                            <i class="fas fa-shield-alt me-1 text-primary"></i> Si no desea cambiar la contraseña actual, deje el campo de contraseña vacío.
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                        @if (esEdicion)
                        {
                            <a asp-action="CrearUsuario" class="btn btn-sm btn-outline-secondary">
                                <i class="fas fa-times me-1"></i> Cancelar
                            </a>
                        }
                        <button type="submit" class="btn btn-sm btn-primary px-3 shadow-sm">
                            <i class="fas @(esEdicion ? "fa-save" : "fa-user-check") me-1"></i>
                            @(esEdicion ? "Actualizar Usuario" : "Crear Usuario")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Columna Derecha: Lista de Usuarios Registrados -->
    <div class="col-lg-7 col-md-7">
        <div class="card shadow-sm">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title text-primary fw-bold mb-0">
                        <i class="fas fa-users-cog me-1"></i> Usuarios Registrados
                    </h5>
                    <span class="badge bg-light text-dark border">
                        <i class="fas fa-user-friends me-1 text-primary"></i> Total: <strong>@usuarios.Count</strong>
                    </span>
                </div>

                <!-- Buscador de usuarios -->
                <div class="mb-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="filtroUsuarios" class="form-control form-control-sm" placeholder="Buscar por nombre, apellido, correo o rol...">
                        <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('filtroUsuarios').value=''; filtrarTablaUsuarios();" title="Limpiar búsqueda">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>

                <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                    <table class="table table-sm table-hover table-bordered align-middle mb-0" id="tablaUsuarios">
                        <thead class="table-light small text-uppercase sticky-top" style="z-index: 1;">
                            <tr>
                                <th style="width: 45px;" class="text-center">ID</th>
                                <th>Usuario</th>
                                <th>Correo</th>
                                <th style="width: 130px;">Sede / Parroquia</th>
                                <th style="width: 95px;" class="text-center">Rol</th>
                                <th style="width: 80px;" class="text-center">Estado</th>
                                <th style="width: 95px;" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="small" id="tablaUsuariosBody">
                            @if (usuarios == null || usuarios.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-3">No hay usuarios registrados en el sistema.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var user in usuarios)
                                {
                                    <tr class="fila-usuario" data-busqueda="@($"{user.id} {user.nombre} {user.apellido} {user.correo} {user.rol} {user.estado}".ToLower())">
                                        <td class="text-center fw-bold text-muted">@user.id</td>
                                        <td>
                                            <div class="fw-semibold text-dark">@($"{user.nombre} {user.apellido}")</div>
                                            @if (user.fecha_creacion != default)
                                            {
                                                <div class="text-muted" style="font-size: 0.72rem;">
                                                    <i class="far fa-calendar-alt me-1"></i>@user.fecha_creacion.ToString("yyyy-MM-dd")
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <span class="text-truncate d-inline-block" style="max-width: 170px;" title="@user.correo">@user.correo</span>
                                        </td>
                                        <td>
                                            @if (user.parroquia_id.HasValue && (ViewBag.Parroquias as List<AplicacionCuria.Models.Parroquia>)?.FirstOrDefault(p => p.id == user.parroquia_id.Value) is { } parr)
                                            {
                                                <span class="badge bg-light text-dark border text-truncate d-inline-block" style="max-width: 120px;" title="@parr.nombre">
                                                    <i class="fas fa-church text-primary me-1"></i>@parr.nombre
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border">Curia Central</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (user.rol?.ToLower() == "admin")
                                            {
                                                <span class="badge bg-primary text-white"><i class="fas fa-user-shield me-1"></i>Admin</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-dark"><i class="fas fa-user me-1"></i>Personal</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (user.estado == "ACTIVO" || string.IsNullOrEmpty(user.estado))
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@user.estado</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a asp-action="EditarUsuario" asp-route-id="@user.id" class="btn btn-outline-primary btn-sm py-0 px-2" title="Editar usuario">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form asp-action="EliminarUsuario" asp-route-id="@user.id" method="post" class="d-inline"
                                                      onsubmit="return confirm('¿Está seguro de que desea eliminar al usuario @user.nombre @user.apellido (@user.correo)? Esta acción no se puede deshacer.');">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Eliminar usuario">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        function filtrarTablaUsuarios() {
            var input = document.getElementById('filtroUsuarios');
            if (!input) return;
            var filtro = input.value.toLowerCase().trim();
            var filas = document.querySelectorAll('#tablaUsuariosBody tr.fila-usuario');
            filas.forEach(function (fila) {
                var texto = fila.getAttribute('data-busqueda') || fila.textContent.toLowerCase();
                if (texto.includes(filtro)) {
                    fila.style.display = '';
                } else {
                    fila.style.display = 'none';
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            var filtroInput = document.getElementById('filtroUsuarios');
            if (filtroInput) {
                filtroInput.addEventListener('input', filtrarTablaUsuarios);
            }

            var passUsuarioInput = document.getElementById('Password');
            var btnTogglePassUsuario = document.getElementById('btnTogglePasswordUsuario');
            var iconTogglePassUsuario = document.getElementById('iconTogglePasswordUsuario');
            btnTogglePassUsuario?.addEventListener('click', function () {
                var isPass = passUsuarioInput.getAttribute('type') === 'password';
                passUsuarioInput.setAttribute('type', isPass ? 'text' : 'password');
                iconTogglePassUsuario.classList.toggle('fa-eye', !isPass);
                iconTogglePassUsuario.classList.toggle('fa-eye-slash', isPass);
            });
        });
    </script>
}
