@{
    ViewData["Title"] = "Gestión de Catequesis";
    Layout = "_Layout";
}

<div class="mb-3 text-center">
    <h1 class="h3 mb-0 text-primary fw-bold">Gestión de Catequesis</h1>
</div>

<ul class="nav nav-tabs justify-content-center mb-3" id="formTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-semibold" id="registro-alumnos-tab" data-bs-toggle="tab"
            data-bs-target="#registro-alumnos" type="button" role="tab" aria-controls="registro-alumnos"
            aria-selected="true">
            <i class="fas fa-user-graduate me-1 text-primary"></i> Registro de Alumnos
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="faltas-tab" data-bs-toggle="tab" data-bs-target="#faltas" type="button" role="tab"
            aria-controls="faltas" aria-selected="false">
            <i class="fas fa-calendar-times me-1 text-danger"></i> Registro de Faltas
        </button>
    </li>
</ul>

<div class="tab-content" id="formTabsContent">
    <!-- Pestaña para Registro de Alumnos -->
    <div class="tab-pane fade show active" id="registro-alumnos" role="tabpanel" aria-labelledby="registro-alumnos-tab">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row justify-content-center align-items-start g-3">
            <!-- Formulario de Alumno a la izquierda -->
            <div class="col-lg-5 col-md-5">
                <div class="card shadow-sm">
                    <div class="card-body p-3">
                        <form asp-action="Create" asp-controller="AlumnosCatequesis" method="post" enctype="multipart/form-data" id="crearalumno" autocomplete="off">
                            <h5 class="card-title text-primary fw-bold mb-3"><i class="fas fa-user-plus me-1 text-primary"></i> Registro de Alumno</h5>
                            
                            <!-- Foto con vista previa centrada -->
                            <div class="mb-2 text-center">
                                <div class="d-flex flex-column align-items-center">
                                    <img alt="Vista previa" width="90" height="90" id="vistaPrevia" class="mb-1 rounded border bg-light" style="object-fit: cover;" />
                                    <div class="small text-muted mb-1">Foto del Alumno</div>
                                    <input type="file" class="form-control form-control-sm" id="foto" name="foto" onchange="mostrarVistaPrevia(event)" style="max-width: 250px;" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="nombre" class="form-label mb-1 fw-semibold small">Nombre</label>
                                    <input type="text" class="form-control form-control-sm" id="nombre" name="nombre" required>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="apellido" class="form-label mb-1 fw-semibold small">Apellido</label>
                                    <input type="text" class="form-control form-control-sm" id="apellido" name="apellido" required>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="fechanacimiento" class="form-label mb-1 fw-semibold small">Fecha Nacimiento</label>
                                    <input type="date" class="form-control form-control-sm" id="fechanacimiento" name="fechanacimiento" required>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="fechabautizo" class="form-label mb-1 fw-semibold small">Fecha Bautizo</label>
                                    <input type="date" class="form-control form-control-sm" id="fechabautizo" name="fechabautizo">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="nivel" class="form-label mb-1 fw-semibold small">Nivel</label>
                                    <select class="form-select form-select-sm" id="nivel" name="nivel" required>
                                        <option value="">Seleccione un nivel</option>
                                        <option value="INICIACIÓN">INICIACIÓN</option>
                                        <option value="RECONCILIACIÓN">RECONCILIACIÓN</option>
                                        <option value="COMUNIÓN">COMUNIÓN</option>
                                        <option value="AÑO BÍBLICO">AÑO BÍBLICO</option>
                                        <option value="DISCIPULADO">DISCIPULADO</option>
                                        <option value="CONFIRMACIÓN">CONFIRMACIÓN</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="paralelo" class="form-label mb-1 fw-semibold small">Paralelo</label>
                                    <select class="form-select form-select-sm" id="paralelo" name="paralelo" required>
                                        <option value="">Seleccione un paralelo</option>
                                        <option value="A">A</option>
                                        <option value="B">B</option>
                                        <option value="C">C</option>
                                        <option value="D">D</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label for="catequista" class="form-label mb-0 fw-semibold small">Catequista Principal</label>
                                        <a href="/Submenus/MinistrosCatequistasView" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.72rem;" title="Ir a registrar catequista">+ Nuevo</a>
                                    </div>
                                    <select class="form-select form-select-sm" id="catequista" name="catequista_id" required>
                                        <option value="">Seleccione un Catequista</option>
                                    </select>
                                    <div id="alertaSinCatequistas" class="text-danger small mt-1" style="display:none; font-size: 0.75rem;">
                                        No hay catequistas. <a href="/Submenus/MinistrosCatequistasView" class="fw-bold text-decoration-underline">Registrar aquí</a>.
                                    </div>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="catequista2" class="form-label mb-1 fw-semibold small">Catequista 2 (Opcional)</label>
                                    <select class="form-select form-select-sm" id="catequista2" name="catequista_id2">
                                        <option value="">Seleccione un Catequista</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label for="periodo_id" class="form-label mb-0 fw-semibold small">Período</label>
                                        <a href="/Submenus/PeriodosView" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.72rem;" title="Ir a registrar período">+ Nuevo</a>
                                    </div>
                                    <select class="form-select form-select-sm" id="periodo_id" name="periodo_id" required>
                                        <option value="">Seleccione un período</option>
                                    </select>
                                    <div id="alertaSinPeriodos" class="text-danger small mt-1" style="display:none; font-size: 0.75rem;">
                                        No hay períodos. <a href="/Submenus/PeriodosView" class="fw-bold text-decoration-underline">Registrar aquí</a>.
                                    </div>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="cedula" class="form-label mb-1 fw-semibold small">Cédula</label>
                                    <input type="text" class="form-control form-control-sm" id="cedula" name="cedula">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="telefono" class="form-label mb-1 fw-semibold small">Teléfono</label>
                                    <input type="text" class="form-control form-control-sm" id="telefono" name="telefono">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="nacionalidad" class="form-label mb-1 fw-semibold small">Nacionalidad</label>
                                    <input type="text" class="form-control form-control-sm" id="nacionalidad" name="nacionalidad">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="estadocivil" class="form-label mb-1 fw-semibold small">Estado Civil</label>
                                    <input type="text" class="form-control form-control-sm" id="estadocivil" name="estadocivil">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="correo" class="form-label mb-1 fw-semibold small">Correo Electrónico</label>
                                    <input type="email" class="form-control form-control-sm" id="correo" name="correo">
                                </div>
                            </div>

                            <div class="mb-2">
                                <label for="direccion" class="form-label mb-1 fw-semibold small">Dirección</label>
                                <input type="text" class="form-control form-control-sm" id="direccion" name="direccion">
                            </div>

                            <div class="mb-3">
                                <label for="observaciones" class="form-label mb-1 fw-semibold small">Observaciones</label>
                                <textarea class="form-control form-control-sm" id="observaciones" name="observaciones" rows="2" required></textarea>
                            </div>

                            <!-- Bloque Datos del Representante -->
                            <div class="border rounded p-2 mb-3 bg-light">
                                <h6 class="text-secondary fw-bold mb-2 small"><i class="fas fa-user-shield me-1"></i> Datos del Representante</h6>
                                <div class="row">
                                    <div class="col-12 mb-2">
                                        <label for="nombrerepresentante" class="form-label mb-1 fw-semibold small">Nombre del Representante</label>
                                        <input type="text" class="form-control form-control-sm" id="nombrerepresentante" name="nombrerepresentante">
                                    </div>
                                    <div class="col-md-6 mb-1">
                                        <label for="telefonorepresentante" class="form-label mb-1 fw-semibold small">Teléfono</label>
                                        <input type="text" class="form-control form-control-sm" id="telefonorepresentante" name="telefonorepresentante">
                                    </div>
                                    <div class="col-md-6 mb-1">
                                        <label for="relacionconelestudiante" class="form-label mb-1 fw-semibold small">Relación / Parentesco</label>
                                        <input type="text" class="form-control form-control-sm" id="relacionconelestudiante" name="relacionconelestudiante">
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-center gap-2">
                                <button type="submit" class="btn btn-primary btn-sm px-4">Registrar Alumno</button>
                            </div>
                            <div class="text-center mt-2">
                                <label id="exito" class="text-success fw-semibold small" style="display: none;">Alumno Registrado</label>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Buscador de Alumnos a la derecha -->
            <div class="col-lg-7 col-md-7">
                <div class="card shadow-sm">
                    <div class="card-body p-3">
                        <form id="buscar-alumno" onsubmit="event.preventDefault();">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title text-primary fw-bold mb-0"><i class="fas fa-users me-1 text-primary"></i> Estudiantes Registrados</h5>
                                <button type="button" class="btn btn-success btn-sm py-1 px-3 fw-semibold" id="btnImprimirLista">
                                    <i class="fas fa-print me-1"></i> Imprimir Nómina
                                </button>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label class="form-label mb-0 small fw-semibold">Filtrar por Período Litúrgico</label>
                                    <select id="filtroPeriodo" class="form-select form-select-sm">
                                        <option value="">Todos los períodos</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label mb-0 small fw-semibold">Nivel</label>
                                    <input type="text" id="filtroNivel" class="form-control form-control-sm" placeholder="Ej: Confirmación" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label mb-0 small fw-semibold">Paralelo</label>
                                    <select id="filtroParalelo" class="form-select form-select-sm">
                                        <option value="">Todos</option>
                                        <option value="A">A</option>
                                        <option value="B">B</option>
                                        <option value="C">C</option>
                                        <option value="D">D</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-md-8">
                                    <input type="text" id="inputNombreAlumno" class="form-control form-control-sm" placeholder="Buscar por nombre, apellido o cédula..." />
                                </div>
                                <div class="col-md-4 d-flex gap-2">
                                    <button id="btnBuscar" class="btn btn-primary btn-sm flex-grow-1" type="button"><i class="fas fa-search me-1"></i> Filtrar</button>
                                    <button id="btnLimpiar" class="btn btn-secondary btn-sm flex-grow-1" type="button"><i class="fas fa-eraser me-1"></i> Limpiar</button>
                                </div>
                            </div>
                        </form>

                        <div class="table-responsive">
                            <table class="table table-bordered table-hover table-sm text-center align-middle mb-0" style="font-size: 0.86rem; width: 100%;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Foto</th>
                                        <th>Nombre</th>
                                        <th>Apellido</th>
                                        <th>Dirección</th>
                                        <th>Teléfono</th>
                                        <th>Modificar</th>
                                        <th>Eliminar</th>
                                    </tr>
                                </thead>
                                <tbody id="resultadosAlumnos">
                                    @if (Model != null && Model.Any())
                                    {
                                        @foreach (var alumno in Model)
                                        {
                                            <tr>
                                                <td>
                                                    @if (alumno.foto != null && alumno.foto.Length > 0)
                                                    {
                                                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(alumno.foto)"
                                                            alt="Foto de @alumno.nombre" width="45" height="45" style="object-fit: cover; border-radius: 4px;" />
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Sin foto</span>
                                                    }
                                                </td>
                                                <td>@alumno.nombre</td>
                                                <td>@alumno.apellido</td>
                                                <td>@alumno.direccion</td>
                                                <td>@alumno.telefono</td>
                                                <td>
                                                    <a asp-action="ModifyAlumnosView"
                                                       asp-controller="AlumnosCatequesis"
                                                       asp-route-id="@alumno.id"
                                                       class="btn btn-warning btn-sm py-0 px-2">Modificar</a>
                                                </td>
                                                <td>
                                                    <a asp-action="DeleteAlumnosView"
                                                       asp-controller="AlumnosCatequesis"
                                                       asp-route-id="@alumno.id"
                                                       class="btn btn-danger btn-sm py-0 px-2">Eliminar</a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center text-muted">No se encontraron resultados.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pestaña para Registro de Faltas de Alumnos -->
    <div class="tab-pane fade" id="faltas" role="tabpanel" aria-labelledby="faltas-tab">
        <div class="row justify-content-center align-items-start g-3">
            <!-- Formulario de Registro de Faltas a la izquierda -->
            <div class="col-lg-5 col-md-5">
                <div class="card shadow-sm">
                    <div class="card-body p-3">
                        <form asp-action="Create" asp-controller="Faltas" method="post" id="form-crear-falta" autocomplete="off">
                            <h5 class="card-title text-primary fw-bold mb-3"><i class="fas fa-calendar-times me-1 text-danger"></i> Registro de Faltas</h5>

                            <!-- Selección de alumno -->
                            <div class="border rounded p-2 mb-3 bg-light">
                                <label for="nombreAlumno" class="form-label mb-1 fw-semibold small">Buscar y Seleccionar Alumno</label>
                                <div class="input-group input-group-sm mb-2">
                                    <input type="text" class="form-control form-control-sm" id="nombreAlumno" name="nombreAlumno" autocomplete="off"
                                        placeholder="Nombre o apellido del alumno...">
                                    <button type="button" class="btn btn-primary" onclick="buscarAlumnos()"><i class="fas fa-search"></i></button>
                                    <button type="button" class="btn btn-secondary" onclick="limpiarBusquedaAlumnos()"><i class="fas fa-eraser"></i></button>
                                </div>
                                <!-- Campo oculto para almacenar el id del alumno seleccionado -->
                                <input type="hidden" id="alumnoId" name="alumno_id">

                                <!-- Tabla compacta con scroll para resultados de autocompletado -->
                                <div class="table-responsive border rounded bg-white" style="max-height: 150px; overflow-y: auto;">
                                    <table class="table table-bordered table-sm text-center align-middle mb-0" style="font-size: 0.82rem; width: 100%;">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th>Nombre</th>
                                                <th>Apellido</th>
                                                <th>Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody id="resultadosAlumnosParaFaltas">
                                            @if (Model != null && Model.Any())
                                            {
                                                @foreach (var alumno in Model)
                                                {
                                                    <tr>
                                                        <td>@alumno.nombre</td>
                                                        <td>@alumno.apellido</td>
                                                        <td>
                                                            <a class="btn btn-success btn-sm btn-seleccionar py-0 px-2" data-id="@alumno.id" onclick="seleccionarAlumno(this)">Seleccionar</a>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="3" class="text-center text-muted">No se encontraron resultados.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="mb-2">
                                <label for="fechafalta" class="form-label mb-1 fw-semibold small">Fecha de la Falta</label>
                                <input type="date" class="form-control form-control-sm" id="fechafalta" name="fechafalta" required>
                            </div>

                            <div class="mb-3">
                                <label for="observacion" class="form-label mb-1 fw-semibold small">Observación</label>
                                <textarea class="form-control form-control-sm" id="observacion" name="observacion" rows="2" placeholder="Motivo o detalle de la falta..."></textarea>
                            </div>

                            <div class="d-flex justify-content-center gap-2">
                                <button type="submit" class="btn btn-primary btn-sm px-4">Registrar Falta</button>
                            </div>
                            <div class="text-center mt-2">
                                <label id="exito2" class="text-success fw-semibold small" style="display: none;">Falta Registrada</label>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Buscador de Faltas a la derecha -->
            <div class="col-lg-7 col-md-7">
                <div class="card shadow-sm">
                    <div class="card-body p-3">
                        <form id="buscar-falta" onsubmit="event.preventDefault();">
                            <h5 class="card-title text-primary fw-bold mb-3"><i class="fas fa-search me-1 text-primary"></i> Búsqueda de Faltas</h5>
                            <div class="row g-2 mb-3">
                                <div class="col-md-8">
                                    <input type="text" class="form-control form-control-sm" id="nombreAlumnoFalta" name="nombreAlumnoFalta"
                                        placeholder="Escriba un nombre o apellido...">
                                </div>
                                <div class="col-md-4 d-flex gap-2">
                                    <button type="button" class="btn btn-primary btn-sm flex-grow-1" onclick="buscarFaltas()"><i class="fas fa-search me-1"></i> Buscar</button>
                                    <button type="button" class="btn btn-secondary btn-sm flex-grow-1" onclick="limpiarBusquedaFaltas()"><i class="fas fa-eraser me-1"></i> Limpiar</button>
                                </div>
                            </div>
                        </form>

                        <div class="table-responsive">
                            <table class="table table-bordered table-hover table-sm text-center align-middle mb-0" style="font-size: 0.86rem; width: 100%;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Alumno</th>
                                        <th>Fecha Falta</th>
                                        <th>Observaciones</th>
                                        <th>Modificar</th>
                                        <th>Eliminar</th>
                                    </tr>
                                </thead>
                                <tbody id="resultadosFaltas">
                                    @if (Model != null && Model.Any())
                                    {
                                        @foreach (var falta in Model)
                                        {
                                            <tr>
                                                <td>@falta.nombre</td>
                                                <td>@falta.fechafalta</td>
                                                <td>@falta.observacion</td>
                                                <td>
                                                    <a asp-action="ModifyFaltaAlumnosView" asp-controller="Faltas"
                                                        asp-route-id="@falta.id" class="btn btn-warning btn-sm py-0 px-2">Modificar</a>
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-danger btn-sm py-0 px-2" onclick="eliminarFalta(@falta.id)">Eliminar</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted">No se encontraron resultados.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function mostrarVistaPrevia(event) {
        const archivo = event.target.files[0];
        if (archivo) {
            const lector = new FileReader();
            lector.onload = function (e) {
                document.getElementById('vistaPrevia').src = e.target.result;
            };
            lector.readAsDataURL(archivo);
        }
    }

    function cargarAlumnos() {
        fetch('/AlumnosCatequesis/Search')
            .then(response => response.json())
            .then(data => renderResultados(data))
            .catch(error => console.error('Error al cargar alumnos:', error));
    }

    document.getElementById('btnBuscar').addEventListener('click', function () {
        const nombre = encodeURIComponent(document.getElementById('inputNombreAlumno').value.trim());
        const periodo_id = document.getElementById('filtroPeriodo').value;
        const nivel = encodeURIComponent(document.getElementById('filtroNivel').value.trim());
        const paralelo = encodeURIComponent(document.getElementById('filtroParalelo').value.trim());

        fetch(`/AlumnosCatequesis/FiltrarAlumnos?nombre=${nombre}&periodo_id=${periodo_id}&nivel=${nivel}&paralelo=${paralelo}`)
            .then(response => response.json())
            .then(data => renderResultados(data))
            .catch(error => console.error('Error al filtrar:', error));
    });

    document.getElementById('btnLimpiar').addEventListener('click', function () {
        document.getElementById('inputNombreAlumno').value = "";
        document.getElementById('filtroPeriodo').value = "";
        document.getElementById('filtroNivel').value = "";
        document.getElementById('filtroParalelo').value = "";
        cargarAlumnos();
    });

    document.getElementById('btnImprimirLista').addEventListener('click', function () {
        const periodo_id = document.getElementById('filtroPeriodo').value;
        if (!periodo_id) {
            alert("Por favor seleccione un Período antes de imprimir la nómina de alumnos.");
            document.getElementById('filtroPeriodo').focus();
            return;
        }
        const nivel = encodeURIComponent(document.getElementById('filtroNivel').value.trim());
        const paralelo = encodeURIComponent(document.getElementById('filtroParalelo').value.trim());
        window.open(`/AlumnosCatequesis/ImprimirLista?periodo_id=${periodo_id}&nivel=${nivel}&paralelo=${paralelo}`, '_blank');
    });

    function renderResultados(alumnos) {
        const tabla = document.getElementById('resultadosAlumnos');
        tabla.innerHTML = "";

        if (alumnos.length === 0) {
            tabla.innerHTML = `<tr><td colspan="7" class="text-center text-muted">No se encontraron resultados.</td></tr>`;
            return;
        }

        alumnos.forEach(alumno => {
            tabla.innerHTML += `
                <tr>
                    <td>${alumno.foto ? `<img src="data:image/jpeg;base64,${alumno.foto}" width="45" height="45" style="object-fit: cover; border-radius: 4px;" />` : '<span class="text-muted small">Sin foto</span>'}</td>
                    <td>${alumno.nombre}</td>
                    <td>${alumno.apellido}</td>
                    <td>${alumno.direccion || ''}</td>
                    <td>${alumno.telefono || ''}</td>
                    <td>
                        <a href="/AlumnosCatequesis/ModifyAlumnosView/${alumno.id}" class="btn btn-warning btn-sm py-0 px-2">Modificar</a>
                    </td>
                    <td>
                        <a href="/AlumnosCatequesis/DeleteAlumnosView/${alumno.id}" class="btn btn-danger btn-sm py-0 px-2">Eliminar</a>
                    </td>
                </tr>
            `;
        });
    }

    function cargarCatequistas() {
        fetch('/AlumnosCatequesis/GetCatequistas')
            .then(response => response.json())
            .then(data => {
                console.log("Catequistas recibidos:", data);

                const select1 = document.getElementById('catequista');
                select1.innerHTML = '<option value="">Seleccione un Catequista</option>';

                const select2 = document.getElementById('catequista2');
                select2.innerHTML = '<option value="">Seleccione un Catequista</option>';

                data.forEach(c => {
                    const optionHTML = `<option value="${c.id}">${c.nombre}</option>`;
                    select1.innerHTML += optionHTML;
                    select2.innerHTML += optionHTML;
                });
                document.getElementById('alertaSinCatequistas').style.display = (!data || data.length === 0) ? 'block' : 'none';
            })
            .catch(error => console.error('Error al cargar catequistas:', error));
    }

    function cargarPeriodos() {
        fetch('/AlumnosCatequesis/GetPeriodos')
            .then(response => response.json())
            .then(data => {
                console.log("Periodos recibidos:", data);
                const selectPeriodo = document.getElementById('periodo_id');
                const filtroPeriodo = document.getElementById('filtroPeriodo');
                
                if (selectPeriodo) selectPeriodo.innerHTML = '<option value="">Seleccione un período</option>';
                if (filtroPeriodo) filtroPeriodo.innerHTML = '<option value="">Todos los períodos</option>';

                data.forEach(periodo => {
                    const opt = `<option value="${periodo.id}">${periodo.nombre}</option>`;
                    if (selectPeriodo) selectPeriodo.innerHTML += opt;
                    if (filtroPeriodo) filtroPeriodo.innerHTML += opt;
                });
                const alerta = document.getElementById('alertaSinPeriodos');
                if (alerta) alerta.style.display = (!data || data.length === 0) ? 'block' : 'none';
            })
            .catch(error => console.error('Error al cargar períodos:', error));
    }

    function ListParaFaltas(nombre = "") {
        const resultadosBody = document.getElementById('resultadosAlumnosParaFaltas');
        if (!resultadosBody) return;

        const url = (nombre && nombre.trim().length > 0)
            ? `/AlumnosCatequesis/SearchByName?nombrecompleto=${encodeURIComponent(nombre.trim())}`
            : '/AlumnosCatequesis/Search';

        fetch(url)
            .then(response => response.json())
            .then(data => {
                resultadosBody.innerHTML = "";

                if (data && data.length > 0) {
                    data.forEach(item => {
                        const row = `<tr>
                            <td>${item.nombre}</td>
                            <td>${item.apellido}</td>
                            <td><a class="btn btn-success btn-sm btn-seleccionar py-0 px-2" data-id="${item.id}" onclick="seleccionarAlumno(this)">Seleccionar</a></td>
                        </tr>`;
                        resultadosBody.innerHTML += row;
                    });
                } else {
                    resultadosBody.innerHTML = "<tr><td colspan='3' class='text-center text-muted'>No se encontraron resultados.</td></tr>";
                }
            })
            .catch(error => console.error('Error en la búsqueda para faltas:', error));
    }

    function ListFaltas(nombre = "") {
        fetch(`/Faltas/BuscarPorNombre?nombre=${encodeURIComponent(nombre || "")}`)
            .then(response => {
                if (!response.ok) throw new Error('Error en la respuesta del servidor');
                return response.json();
            })
            .then(data => {
                const tbody = document.getElementById('resultadosFaltas');
                if (!tbody) return;
                tbody.innerHTML = '';

                if (!data || data.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="5" class="text-center text-muted">No se encontraron resultados.</td></tr>`;
                    return;
                }

                data.forEach(falta => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td>${falta.nombre || falta.id}</td>
                        <td>${falta.fechafalta}</td>
                        <td>${falta.observacion || ''}</td>
                        <td>
                            <a href="/Faltas/ModifyFaltaAlumnosView/${falta.id}" class="btn btn-warning btn-sm py-0 px-2">Modificar</a>
                        </td>
                        <td>
                            <button type="button" class="btn btn-danger btn-sm py-0 px-2" onclick="eliminarFalta(${falta.id})">Eliminar</button>
                        </td>`;
                    tbody.appendChild(row);
                });
            })
            .catch(error => {
                console.error('Error al cargar faltas:', error);
            });
    }

    function eliminarFalta(id) {
        if (!confirm("¿Seguro que deseas eliminar esta falta?")) return;

        fetch(`/Faltas/DeleteConfirmed/${id}`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            }
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                alert("Falta eliminada con éxito.");
                ListFaltas();
            } else {
                alert("No se pudo eliminar la falta.");
            }
        })
        .catch(error => {
            console.error("Error al eliminar:", error);
            alert("Error al eliminar la falta.");
        });
    }

    function seleccionarAlumno(element) {
        const alumnoId = element.getAttribute('data-id');
        document.getElementById('alumnoId').value = alumnoId;

        document.querySelectorAll('.btn-seleccionar').forEach(btn => {
            btn.classList.remove('btn-dark');
            btn.classList.add('btn-success');
            btn.textContent = "Seleccionar";
            btn.disabled = false;
        });

        element.classList.remove('btn-success');
        element.classList.add('btn-dark');
        element.textContent = "Seleccionado";
        element.disabled = true;
    }

    document.getElementById("crearalumno").addEventListener("submit", function (event) {
        event.preventDefault();

        var formData = new FormData(this);
        fetch(this.action, {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                const exitoLabel = document.getElementById("exito");
                exitoLabel.style.display = "none";

                if (data.success) {
                    exitoLabel.className = "text-success fw-semibold small";
                    exitoLabel.textContent = "Alumno Registrado con éxito";
                    exitoLabel.style.display = "block";
                    cargarAlumnos();
                    ListParaFaltas();

                    document.getElementById("crearalumno").reset();
                    const vistaPrevia = document.getElementById("vistaPrevia");
                    if (vistaPrevia) {
                        vistaPrevia.src = "";
                    }

                    setTimeout(() => {
                        exitoLabel.style.display = "none";
                    }, 3500);
                } else {
                    exitoLabel.className = "text-danger fw-semibold small";
                    if (Array.isArray(data.errors)) {
                        exitoLabel.textContent = data.errors.join(", ");
                    } else {
                        exitoLabel.textContent = data.errors || "Error desconocido al registrar alumno.";
                    }
                    exitoLabel.style.display = "block";
                }
            })
            .catch(error => {
                console.error('Error:', error);
                const exitoLabel = document.getElementById("exito");
                exitoLabel.className = "text-danger fw-semibold small";
                exitoLabel.innerText = "Error de conexión al servidor.";
                exitoLabel.style.display = "block";
            });
    });

    document.getElementById("form-crear-falta").addEventListener("submit", function (event) {
        event.preventDefault();

        var formData = new FormData(this);
        fetch(this.action, {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                const exito2 = document.getElementById("exito2");
                exito2.style.display = "none";

                if (data.success) {
                    exito2.className = "text-success fw-semibold small";
                    exito2.textContent = "Falta Registrada con éxito";
                    exito2.style.display = "block";

                    document.getElementById("form-crear-falta").reset();
                    document.getElementById("alumnoId").value = "";
                    document.querySelectorAll('.btn-seleccionar').forEach(btn => {
                        btn.classList.remove('btn-dark');
                        btn.classList.add('btn-success');
                        btn.textContent = "Seleccionar";
                        btn.disabled = false;
                    });

                    setTimeout(function () {
                        exito2.style.display = "none";
                        ListParaFaltas();
                        ListFaltas();
                    }, 2500);
                } else {
                    exito2.className = "text-danger fw-semibold small";
                    exito2.textContent = data.errors || "Error al registrar la falta.";
                    exito2.style.display = "block";
                }
            })
            .catch(error => {
                console.error('Error:', error);
                const exito2 = document.getElementById("exito2");
                exito2.className = "text-danger fw-semibold small";
                exito2.innerText = "Error de conexión al registrar la falta.";
                exito2.style.display = "block";
            });
    });

    function buscarAlumnos() {
        const input = document.getElementById('nombreAlumno').value.trim();
        ListParaFaltas(input); 
    }

    function limpiarBusquedaAlumnos() {
        document.getElementById('nombreAlumno').value = '';
        ListParaFaltas();
    }

    function buscarFaltas() {
        const input = document.getElementById('nombreAlumnoFalta').value.trim();
        ListFaltas(input);
    }

    function limpiarBusquedaFaltas() {
        document.getElementById('nombreAlumnoFalta').value = '';
        ListFaltas();
    }

    document.addEventListener("DOMContentLoaded", function () {
        cargarCatequistas();
        cargarPeriodos();
        cargarAlumnos();
        ListParaFaltas();
        ListFaltas();
    });
</script>
