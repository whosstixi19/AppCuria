@{
    ViewData["Title"] = "Agenda Parroquial";
    Layout = "_Layout";
}

<div class="mb-3 text-center">
    <h1 class="h3 mb-0 text-primary fw-bold">Agenda Parroquial</h1>
</div>

<div class="row justify-content-center align-items-start g-3">
    <!-- Formulario de Registro de Agenda a la izquierda -->
    <div class="col-lg-5 col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-3">
                <form asp-action="Create" asp-controller="Agenda" method="post" id="crearagenda" autocomplete="off">
                    <h5 class="card-title text-primary fw-bold mb-3">
                        <i class="fas fa-calendar-plus me-1 text-primary"></i> Registro de Evento
                    </h5>

                    <div class="row">
                        <div class="col-md-7 mb-2">
                            <label for="titulo" class="form-label mb-1 fw-semibold small">Título</label>
                            <input type="text" class="form-control form-control-sm" id="titulo" name="titulo" required placeholder="Ej: Bautizo Comunitario">
                        </div>
                        <div class="col-md-5 mb-2">
                            <label for="tipo_evento" class="form-label mb-1 fw-semibold small">Tipo de Evento</label>
                            <select class="form-select form-select-sm" id="tipo_evento" name="tipo_evento">
                                <option value="Bautizo">Bautizo</option>
                                <option value="Matrimonio">Matrimonio</option>
                                <option value="Misa Especial">Misa Especial</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label for="fechaagenda" class="form-label mb-1 fw-semibold small">Fecha</label>
                            <input type="date" class="form-control form-control-sm" id="fechaagenda" name="fechaagenda" required>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="hora" class="form-label mb-1 fw-semibold small">Hora</label>
                            <input type="time" class="form-control form-control-sm" id="hora" name="hora" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-7 mb-2">
                            <label for="lugar" class="form-label mb-1 fw-semibold small">Lugar</label>
                            <input type="text" class="form-control form-control-sm" id="lugar" name="lugar" required placeholder="Templo Parroquial, Capilla...">
                        </div>
                        <div class="col-md-5 mb-2">
                            <label for="estado" class="form-label mb-1 fw-semibold small">Estado</label>
                            <select class="form-select form-select-sm" id="estado" name="estado">
                                <option value="ACTIVO">ACTIVO</option>
                                <option value="INACTIVO">INACTIVO</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label for="descripcion" class="form-label mb-1 fw-semibold small">Descripción</label>
                        <textarea class="form-control form-control-sm" id="descripcion" name="descripcion" rows="2" required placeholder="Detalles de la ceremonia o evento..."></textarea>
                    </div>

                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="buscarResponsable" class="form-label mb-0 fw-semibold small">Responsables Asignados <span class="text-danger">*</span></label>
                            <div class="d-flex gap-1">
                                <a href="/Submenus/SacerdoteView" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.72rem;" title="Ir a registrar sacerdote">+ Sacerdote</a>
                                <a href="/Submenus/EncargadosView" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.72rem;" title="Ir a registrar encargado">+ Encargado</a>
                            </div>
                        </div>
                        <input type="text" id="buscarResponsable" class="form-control form-control-sm mb-1" placeholder="Buscar sacerdote o encargado por nombre o correo..." oninput="filtrarResponsables(this.value)">
                        <div id="listaResponsablesCheck" class="border rounded p-2 bg-white" style="max-height: 120px; overflow-y: auto; font-size: 0.84rem;">
                            <!-- Los checkboxes se cargarán dinámicamente -->
                        </div>
                        <div id="alertaSinResponsables" class="text-danger small mt-1" style="display:none; font-size: 0.75rem;">
                            No hay personas registradas. Registre un <a href="/Submenus/SacerdoteView" class="fw-bold text-decoration-underline">Sacerdote</a> o un <a href="/Submenus/EncargadosView" class="fw-bold text-decoration-underline">Encargado</a>.
                        </div>
                        <div class="small text-muted" style="font-size: 0.75rem;">Marque uno o varios responsables para que reciban la invitación y el recordatorio en su correo.</div>
                    </div>

                    <!-- Configuración de Recordatorio -->
                    <div class="border rounded p-2 mb-3 bg-light">
                        <h6 class="text-secondary fw-bold mb-2 small"><i class="fas fa-bell me-1 text-warning"></i> Configuración de Recordatorio</h6>
                        <div class="row">
                            <div class="col-md-6 mb-1">
                                <label for="notificar" class="form-label mb-1 fw-semibold small">¿Enviar Notificación?</label>
                                <select class="form-select form-select-sm" id="notificar" name="notificar">
                                    <option value="true">Sí (Por Correo)</option>
                                    <option value="false">No</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-1">
                                <label for="recordatorio_anticipacion" class="form-label mb-1 fw-semibold small">Días de Anticipación</label>
                                <input type="number" class="form-control form-control-sm" id="recordatorio_anticipacion" name="recordatorio_anticipacion" value="1" min="0" max="30">
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-primary btn-sm px-4">Registrar Evento</button>
                        <button type="button" class="btn btn-secondary btn-sm px-3" onclick="document.getElementById('crearagenda').reset();">Limpiar</button>
                    </div>
                    <div class="text-center mt-2">
                        <label id="exito" class="text-success fw-semibold small" style="display: none;">Agenda Registrada con éxito</label>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Listado y Búsqueda de Agendas a la derecha -->
    <div class="col-lg-7 col-md-7">
        <div class="card shadow-sm">
            <div class="card-body p-3">
                <form id="buscar-agenda" onsubmit="event.preventDefault(); List();">
                    <h5 class="card-title text-primary fw-bold mb-3">
                        <i class="fas fa-search me-1 text-primary"></i> Búsqueda de Eventos
                    </h5>
                    <div class="row g-2 mb-3">
                        <div class="col-md-8">
                            <input type="text" class="form-control form-control-sm" id="descripcionbusqueda" name="descripcionbusqueda" onkeyup="List()" placeholder="Buscar por descripción, título o lugar...">
                        </div>
                        <div class="col-md-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="fas fa-search me-1"></i> Buscar</button>
                            <button type="button" class="btn btn-secondary btn-sm flex-grow-1" onclick="document.getElementById('descripcionbusqueda').value=''; List();"><i class="fas fa-eraser me-1"></i> Limpiar</button>
                        </div>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-sm text-center align-middle mb-0" style="font-size: 0.86rem; width: 100%;">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Lugar</th>
                                <th>Descripción</th>
                                <th>Responsable</th>
                                <th>Estado</th>
                                <th>Modificar</th>
                                <th>Eliminar</th>
                            </tr>
                        </thead>
                        <tbody id="resultadosAgendas">
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var agenda in Model)
                                {
                                    <tr>
                                        <td>@agenda.fechaagenda.ToShortDateString()</td>
                                        <td>@agenda.hora</td>
                                        <td>@agenda.lugar</td>
                                        <td>@agenda.descripcion</td>
                                        <td>@agenda.responsables_ids</td>
                                        <td>@agenda.estado</td>
                                        <td>
                                            <a asp-action="ModifyAgendaView" asp-controller="Agenda" asp-route-id="@agenda.id" class="btn btn-warning btn-sm py-0 px-2">Modificar</a>
                                        </td>
                                        <td>
                                            <a asp-action="DeleteAgendaView" asp-controller="Agenda" asp-route-id="@agenda.id" class="btn btn-danger btn-sm py-0 px-2">Eliminar</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted">Cargando eventos...</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function List() {
        const nombre = document.getElementById('descripcionbusqueda').value;
        const resultadosBody = document.getElementById('resultadosAgendas');

        const formatoHora12Horas = (hora24) => {
            if (!hora24) return '';
            const partes = hora24.split(':');
            let horas = parseInt(partes[0]);
            const minutos = partes[1];
            const sufijo = horas >= 12 ? 'p. m.' : 'a. m.';
            horas = horas % 12 || 12;
            return `${horas}:${minutos} ${sufijo}`;
        };

        const renderRows = (data) => {
            resultadosBody.innerHTML = "";
            if (data && data.length > 0) {
                data.forEach(item => {
                    const row = `<tr>
                        <td>${new Date(item.fechaagenda).toLocaleDateString('es-EC')}</td>
                        <td>${formatoHora12Horas(item.hora) ?? ''}</td>
                        <td>${item.lugar ?? ''}</td>
                        <td>${item.descripcion ?? ''}</td>
                        <td>${item.responsables || ''}</td>
                        <td><span class="badge ${item.estado === 'ACTIVO' ? 'bg-success' : 'bg-secondary'}">${item.estado ?? 'ACTIVO'}</span></td>
                        <td><a href="/Agenda/ModifyAgendaView/${item.id}" class="btn btn-warning btn-sm py-0 px-2">Modificar</a></td>
                        <td><a href="/Agenda/DeleteAgendaView/${item.id}" class="btn btn-danger btn-sm py-0 px-2" id="btnEliminar">Eliminar</a></td>
                    </tr>`;
                    resultadosBody.innerHTML += row;
                });
            } else {
                resultadosBody.innerHTML = "<tr><td colspan='8' class='text-center text-muted'>No se encontraron resultados.</td></tr>";
            }
        };

        const url = nombre.length > 0
            ? `/Agenda/SearchByName?nombrecompleto=${encodeURIComponent(nombre)}`
            : '/Agenda/GetAgendas';

        fetch(url)
            .then(response => response.json())
            .then(data => renderRows(data))
            .catch(error => console.error('Error en la búsqueda:', error));
    }

    document.getElementById("crearagenda").addEventListener("submit", function (event) {
        event.preventDefault();

        var formData = new FormData(this);

        const responsablesSeleccionados = Array.from(document.querySelectorAll(".chk-responsable:checked"))
                                            .map(chk => parseInt(chk.value))
                                            .filter(val => !isNaN(val));

        const faltantes = [];
        if (!document.getElementById("titulo").value.trim()) faltantes.push("Título");
        if (!document.getElementById("fechaagenda").value.trim()) faltantes.push("Fecha");
        if (!document.getElementById("hora").value.trim()) faltantes.push("Hora");
        if (!document.getElementById("lugar").value.trim()) faltantes.push("Lugar");
        if (!document.getElementById("descripcion").value.trim()) faltantes.push("Descripción");
        if (responsablesSeleccionados.length === 0) faltantes.push("Responsables Asignados (marque al menos un Sacerdote o Encargado)");

        if (faltantes.length > 0) {
            const exito = document.getElementById("exito");
            exito.className = "text-danger fw-semibold small";
            exito.textContent = "Falta ingresar los siguientes datos obligatorios: " + faltantes.join(", ") + ".";
            exito.style.display = "block";
            return;
        }

        formData.append("responsables_ids", JSON.stringify(responsablesSeleccionados));

        fetch(this.action, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            const exito = document.getElementById("exito");
            exito.style.display = "none";
            if (data.success) {
                exito.className = "text-success fw-semibold small";
                exito.textContent = "Agenda Registrada con éxito";
                exito.style.display = "block";
                document.getElementById("crearagenda").reset();
                filtrarResponsables("");
                setTimeout(function () {
                    exito.style.display = "none";
                    List();
                }, 2000);
            } else {
                exito.className = "text-danger fw-semibold small";
                exito.textContent = "Error: " + (data.message || "No se pudo registrar la agenda.");
                exito.style.display = "block";
            }
        })
        .catch(error => {
            console.error('Error:', error);
            const exito = document.getElementById("exito");
            exito.className = "text-danger fw-semibold small";
            exito.innerText = "Error de conexión al guardar.";
            exito.style.display = "block";
        });
    });

    function filtrarResponsables(texto) {
        const filtro = (texto || "").trim().toLowerCase();
        document.querySelectorAll(".item-responsable").forEach(item => {
            const contenido = (item.getAttribute("data-search") || "").toLowerCase();
            item.style.display = (!filtro || contenido.includes(filtro)) ? "" : "none";
        });
    }

    function cargarListaPersonas() {
        fetch('/Agenda/GetAllPersonas')
            .then(response => response.json())
            .then(data => {
                const contenedor = document.getElementById("listaResponsablesCheck");
                contenedor.innerHTML = "";

                if (!data || data.length === 0) {
                    contenedor.innerHTML = "<div class='text-muted small'>No hay personas registradas</div>";
                    document.getElementById("alertaSinResponsables").style.display = "block";
                } else {
                    document.getElementById("alertaSinResponsables").style.display = "none";
                    data.forEach(p => {
                        const rol = p.rol || "Encargado";
                        const badgeClass = rol === "Sacerdote" ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle";
                        const searchText = `${rol} ${p.nombre} ${p.email}`;
                        contenedor.innerHTML += `
                            <div class="form-check mb-1 item-responsable" data-search="${searchText}">
                                <input class="form-check-input chk-responsable" type="checkbox" value="${p.id}" id="resp_${p.id}">
                                <label class="form-check-label d-flex align-items-center gap-1" for="resp_${p.id}" style="cursor:pointer;">
                                    <span class="badge ${badgeClass}" style="font-size: 0.68rem;">${rol}</span>
                                    <span class="fw-semibold">${p.nombre}</span>
                                    <span class="text-muted small">(${p.email})</span>
                                </label>
                            </div>`;
                    });
                }
            })
            .catch(error => console.error("Error al cargar personas:", error));
    }

    document.addEventListener("DOMContentLoaded", function () {
        List();
        cargarListaPersonas();
    });
</script>
