@model AplicacionCuria.Models.Usuario

@{
    ViewData["Title"] = "Home Page";
}

<div class="d-flex justify-content-center align-items-center">
    @if (User?.Identity?.IsAuthenticated != true)
    {
        <div id="loginDiv" class="col-md-6">
            <h1 class="display-4 text-center">Iniciar Sesión</h1>
            <form asp-controller="Auth" id="loginForm" asp-action="Login" method="post">
                <div class="form-group">
                    <label for="correo">Correo:</label>
                    <input type="Email" class="form-control" id="Email" name="Email" placeholder="Ingresa tu correo"
                        required>
                </div>
                <div class="form-group">
                    <label for="Password">Contraseña:</label>
                    <input type="Password" class="form-control" id="Password" name="Password" placeholder="Ingresa tu contraseña"
                        required>
                </div>
                <div class="form-group text-center">
                    <button type="submit" class="btn btn-primary">Iniciar Sesión</button>
                </div>
            </form>

            <!-- Label para mostrar el mensaje de error -->
            <label id="errorLabel" class="text-danger" style="display: none;">Credenciales incorrectas</label>
        </div>
    }
    else
    {
        <div class="container mt-5">
            <div class="p-5 text-center bg-light rounded-3 shadow-sm">
                <h1 class="display-5 fw-bold">
                    <i class="fas fa-user-circle text-primary me-2"></i> Bienvenido, @User.Identity.Name
                </h1>
                <p class="lead text-muted">
                    ¡Nos alegra tenerte de vuelta!
                </p>
                <p class="small text-secondary">
                    Tu rol: <strong>@User.FindFirst("http://schemas.microsoft.com/ws/2008/06/identity/claims/role")?.Value</strong> | Fecha: @DateTime.Now.ToString("dd MMM yyyy")
                </p>
            </div>
        </div>
    }

</div>
