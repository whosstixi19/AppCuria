<title>@ViewData["Title"] - Ayuda Social</title>
@{
    Layout = "_Layout";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<style>
    nav {
        background-color: #f7f9fc;
        border-bottom: 2px solid #d4af37;
    }

        nav ul {
            list-style-type: none;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: space-around;
            align-items: center;
            flex-wrap: wrap;
        }

            nav ul li {
                position: relative;
            }

                nav ul li a {
                    color: #343a40;
                    /* font-weight: bold; */
                    padding: 15px 20px;
                    text-decoration: none;
                }

                    nav ul li a:hover,
                    nav ul li a.active {
                        color: #d4af37;
                    }

                nav ul li ul {
                    position: absolute;
                    top: 100%;
                    left: 0;
                    background-color: #f7f9fc;
                    display: none;
                    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                    padding: 0;
                }

                nav ul li:hover ul {
                    display: block;
                }

                nav ul li ul li {
                    width: 200px;
                }

                    nav ul li ul li a {
                        display: block;
                        padding: 10px;
                        color: #343a40;
                    }

                        nav ul li ul li a:hover {
                            background-color: #d4af37;
                            color: #fff;
                        }

    /* Estilo responsivo */
    media (max-width: 768px) {
        nav ul

    {
        flex-direction: column;
        align-items: flex-start;
    }

    nav ul li {
        width: 100%;
    }

        nav ul li ul {
            position: static;
            box-shadow: none;
        }

    }

    .menu-icon {
        margin-right: 8px;
    }

    .christian-background {
        background: url('https://example.com/church-background.jpg') no-repeat center center fixed;
        background-size: cover;
    }
</style>
<h1 class="mt-3 mb-3 text-center">Registro de Ayuda Social</h1>

