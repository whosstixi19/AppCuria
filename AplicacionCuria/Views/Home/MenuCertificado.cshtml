@{
    ViewData["Title"] = "Certificados";
    Layout = "_Layout";
}

<partial name="_SubmenuCertificados" />

<div class="container-fluid px-2 text-center py-5">
    <div class="card shadow-sm p-4 mx-auto" style="max-width: 600px;">
        <i class="fas fa-certificate fa-3x text-warning mb-3"></i>
        <h3 class="text-primary fw-bold mb-2">Módulo de Certificados</h3>
        <p class="text-muted mb-4">Seleccione uno de los tipos de certificados en la barra superior para buscar e imprimir actas oficiales.</p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a href="@Url.Action("BautizosCView", "Submenus")" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-water me-1"></i> Bautizos
            </a>
            <a href="@Url.Action("PrimeraComunionCView", "Submenus")" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-bread-slice me-1"></i> Primera Comunión
            </a>
            <a href="@Url.Action("ConfirmacionCView", "Submenus")" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-dove me-1"></i> Confirmación
            </a>
            <a href="@Url.Action("MatrimoniosCView", "Submenus")" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-ring me-1"></i> Matrimonios
            </a>
            <a href="@Url.Action("DispensasCView", "Submenus")" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-file-signature me-1"></i> Dispensas
            </a>
            <a href="@Url.Action("PaseDeNivelView", "Submenus")" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-graduation-cap me-1"></i> Pase de Nivel
            </a>
        </div>
    </div>
</div>
