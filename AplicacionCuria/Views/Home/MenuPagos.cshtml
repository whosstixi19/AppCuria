@{
    ViewData["Title"] = "Gestión de Pagos";
    Layout = "_Layout";
}

<div class="mb-3 text-center">
    <h1 class="h3 mb-0 text-primary fw-bold">Gestión de Pagos</h1>
    <p class="text-muted small">Registro de aranceles por sacramentos y consulta de pagos realizados</p>
</div>

<ul class="nav nav-tabs justify-content-center mb-3" id="formTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-semibold small py-2 px-4" id="nuevo-pago-tab" data-bs-toggle="tab" data-bs-target="#nuevo-pago" type="button" role="tab" aria-controls="nuevo-pago" aria-selected="true">
            <i class="fas fa-cash-register me-1 text-primary"></i> Registrar Pago
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold small py-2 px-4" id="ver-pagos-tab" data-bs-toggle="tab" data-bs-target="#ver-pagos" type="button" role="tab" aria-controls="ver-pagos" aria-selected="false">
            <i class="fas fa-list-alt me-1 text-success"></i> Historial de Pagos
        </button>
    </li>
</ul>

<div class="tab-content" id="formTabsContent">
    <!-- Pestaña 1: Registrar Nuevo Pago -->
    <div class="tab-pane fade show active" id="nuevo-pago" role="tabpanel" aria-labelledby="nuevo-pago-tab">
        <div class="row justify-content-center align-items-start g-3">
            <!-- Formulario lado izquierdo -->
            <div class="col-lg-5 col-md-5">
                <div class="card shadow-sm">
                    <div class="card-body p-3">
                        <form id="nuevoPagoForm" method="post" action="/Pagos/Create" autocomplete="off">
                            <h5 class="card-title text-primary fw-bold mb-3">
                                <i class="fas fa-file-invoice-dollar me-1 text-primary"></i> Detalle del Pago
                            </h5>

                            <!-- Datos del Pagador -->
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="nombres" class="form-label mb-1 fw-semibold small">Nombres</label>
                                    <input type="text" class="form-control form-control-sm" id="nombres" name="Nombres" required placeholder="Nombres">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="apellidos" class="form-label mb-1 fw-semibold small">Apellidos</label>
                                    <input type="text" class="form-control form-control-sm" id="apellidos" name="Apellidos" required placeholder="Apellidos">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="cedula" class="form-label mb-1 fw-semibold small">Cédula</label>
                                    <input type="text" class="form-control form-control-sm" id="cedula" name="Cedula" required placeholder="Cédula de identidad">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="telefono" class="form-label mb-1 fw-semibold small">Teléfono</label>
                                    <input type="text" class="form-control form-control-sm" id="telefono" name="Telefono" required placeholder="Teléfono de contacto">
                                </div>
                            </div>

                            <div class="mb-2">
                                <label for="direccion" class="form-label mb-1 fw-semibold small">Dirección</label>
                                <input type="text" class="form-control form-control-sm" id="direccion" name="Direccion" required placeholder="Dirección domiciliaria">
                            </div>

                            <hr class="my-2 text-muted">

                            <!-- Tipo de Servicio y Método de Pago -->
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="tipoPago" class="form-label mb-1 fw-semibold small">Tipo de Servicio</label>
                                    <select class="form-select form-select-sm" id="tipoPago" name="tipo_pago" required>
                                        <option value="">Seleccione servicio...</option>
                                        <option value="bautismo-cursillo">Bautismo - Cursillo</option>
                                        <option value="bautismo-celebracion">Bautismo - Celebración</option>
                                        <option value="matrimonio-cursillo">Matrimonio - Cursillo</option>
                                        <option value="matrimonio-celebracion">Matrimonio - Celebración</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="tipopago" class="form-label mb-1 fw-semibold small">Método de Pago</label>
                                    <select class="form-select form-select-sm" id="tipopago" name="TipoPago" required>
                                        <option value="">Seleccione método...</option>
                                        <option value="Efectivo">Efectivo</option>
                                        <option value="Transferencia">Transferencia</option>
                                        <option value="Tarjeta">Tarjeta</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="monto" class="form-label mb-1 fw-semibold small">Monto ($)</label>
                                    <input type="number" class="form-control form-control-sm" id="monto" name="Valor" step="0.01" min="0" required placeholder="0.00">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="fecha" class="form-label mb-1 fw-semibold small">Fecha del Pago</label>
                                    <input type="date" class="form-control form-control-sm" id="fecha" name="FechaPago" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                                </div>
                            </div>

                            <div class="mb-2">
                                <label for="concepto" class="form-label mb-1 fw-semibold small">Concepto</label>
                                <input type="text" class="form-control form-control-sm" id="concepto" name="Concepto" placeholder="Ej: Arancel de inscripción bautismal">
                            </div>

                            <div class="mb-3">
                                <label for="observaciones" class="form-label mb-1 fw-semibold small">Observaciones</label>
                                <textarea class="form-control form-control-sm" id="observaciones" name="Observaciones" rows="2" placeholder="Notas adicionales o comprobante..."></textarea>
                            </div>

                            <!-- Referencias ocultas obligatorias -->
                            <input type="hidden" id="Referencia_Id" name="Referencia_Id" required>
                            <input type="hidden" id="Referencia_Tabla" name="Referencia_Tabla" required>

                            <!-- Indicador de vinculación -->
                            <div id="referenciaSeleccionadaInfo" class="alert alert-info py-1 px-2 mb-3 small d-flex align-items-center justify-content-between" style="display: none;">
                                <span><i class="fas fa-link me-1"></i> <strong>Vinculado a:</strong> <span id="nombreReferenciaVinculada">Ninguno</span></span>
                                <button type="button" class="btn-close btn-sm py-0" onclick="desvincularReferencia()" title="Desvincular"></button>
                            </div>

                            <div class="d-flex justify-content-center gap-2">
                                <button type="submit" class="btn btn-primary btn-sm px-4 fw-semibold"><i class="fas fa-check me-1"></i> Registrar Pago</button>
                                <button type="reset" class="btn btn-secondary btn-sm px-3" onclick="limpiarFormularioPago()">Limpiar</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Tabla de Referencias lado derecho -->
            <div class="col-lg-7 col-md-7">
                <div class="card shadow-sm">
                    <div class="card-body p-3">
                        <div id="tablaReferenciasDiv">
                            <h5 class="card-title text-primary fw-bold mb-2">
                                <i class="fas fa-folder-open me-1 text-primary"></i> <span id="referenciaLabel">Registros Disponibles para Vincular</span>
                            </h5>
                            <p class="text-muted small mb-3">Seleccione un tipo de servicio a la izquierda para cargar las actas o cursillos correspondientes y vincular este pago.</p>

                            <div class="table-responsive border rounded" style="max-height: 480px; overflow-y: auto;">
                                <table class="table table-bordered table-hover table-sm text-center align-middle mb-0" style="font-size: 0.86rem; width: 100%;">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th>ID</th>
                                            <th>Nombre / Descripción</th>
                                            <th>Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tablaReferenciasBody">
                                        <tr>
                                            <td colspan="3" class="text-muted text-center py-3">Seleccione un tipo de pago a la izquierda para ver registros.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pestaña 2: Historial de Pagos -->
    <div class="tab-pane fade" id="ver-pagos" role="tabpanel" aria-labelledby="ver-pagos-tab">
        <div class="card shadow-sm">
            <div class="card-body p-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                    <h5 class="card-title text-primary fw-bold mb-0">
                        <i class="fas fa-receipt me-1 text-success"></i> Pagos Registrados en el Sistema
                    </h5>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="cargarPagos()">
                        <i class="fas fa-sync-alt me-1"></i> Actualizar Listado
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-sm text-center align-middle mb-0" id="tablaPagos" style="font-size: 0.86rem; width: 100%;">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Servicio</th>
                                <th>Método</th>
                                <th>Monto</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th>Concepto</th>
                                <th>Referencia</th>
                            </tr>
                        </thead>
                        <tbody id="tablaPagosBody">
                            <tr>
                                <td colspan="8" class="text-muted text-center">Cargando pagos...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Cargar referencias según el tipo de pago
    document.getElementById('tipoPago').addEventListener('change', function () {
        var tipo = this.value;
        var tablaDiv = document.getElementById('tablaReferenciasDiv');
        var tablaBody = document.getElementById('tablaReferenciasBody');
        var refLabel = document.getElementById('referenciaLabel');

        desvincularReferencia();

        if (tipo) {
            tablaBody.innerHTML = '<tr><td colspan="3" class="text-muted text-center py-3"><i class="fas fa-spinner fa-spin me-1"></i> Cargando registros disponibles...</td></tr>';

            if (tipo === 'bautismo-celebracion') refLabel.textContent = 'Actas de Bautismo';
            else if (tipo === 'bautismo-cursillo') refLabel.textContent = 'Cursillos Pre-Bautismales';
            else if (tipo === 'matrimonio-celebracion') refLabel.textContent = 'Actas de Matrimonio';
            else if (tipo === 'matrimonio-cursillo') refLabel.textContent = 'Cursillos Pre-Matrimoniales';

            fetch('/Pagos/GetReferencias?tipo_pago=' + encodeURIComponent(tipo))
                .then(resp => resp.json())
                .then(data => {
                    if (!data || data.length === 0) {
                        tablaBody.innerHTML = '<tr><td colspan="3" class="text-muted text-center py-3">No hay registros disponibles para este servicio.</td></tr>';
                    } else {
                        tablaBody.innerHTML = '';
                        data.forEach(function (item) {
                            tablaBody.innerHTML += `<tr>
                                <td class="fw-bold">${item.id}</td>
                                <td>${item.nombre}</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-success py-0 px-2" onclick="seleccionarReferencia(${item.id}, '${item.nombre.replace(/'/g, "\\'")}')">
                                        <i class="fas fa-check me-1"></i> Seleccionar
                                    </button>
                                </td>
                            </tr>`;
                        });
                    }
                })
                .catch(err => {
                    console.error('Error cargando referencias:', err);
                    tablaBody.innerHTML = '<tr><td colspan="3" class="text-danger text-center py-3">Error al cargar registros.</td></tr>';
                });
        } else {
            refLabel.textContent = 'Registros Disponibles para Vincular';
            tablaBody.innerHTML = '<tr><td colspan="3" class="text-muted text-center py-3">Seleccione un tipo de pago a la izquierda para ver registros.</td></tr>';
        }
    });

    // Selección de referencia
    function seleccionarReferencia(id, nombre) {
        document.getElementById('Referencia_Id').value = id;

        const tipo = document.getElementById('tipoPago').value;
        let tabla = '';
        if (tipo === 'bautismo-celebracion') tabla = 'actasbautismo';
        else if (tipo === 'bautismo-cursillo') tabla = 'cursillosprebautismales';
        else if (tipo === 'matrimonio-celebracion') tabla = 'actasprematrimoniales';
        else if (tipo === 'matrimonio-cursillo') tabla = 'cursillosprematrimoniales';

        document.getElementById('Referencia_Tabla').value = tabla;

        // Mostrar indicador visual
        const infoDiv = document.getElementById('referenciaSeleccionadaInfo');
        const nombreSpan = document.getElementById('nombreReferenciaVinculada');
        if (infoDiv && nombreSpan) {
            nombreSpan.textContent = `#${id} - ${nombre}`;
            infoDiv.style.display = 'flex';
        }

        // Resaltar fila seleccionada
        Array.from(document.querySelectorAll('#tablaReferenciasBody tr')).forEach(tr => tr.classList.remove('table-primary'));
        var filas = document.querySelectorAll('#tablaReferenciasBody tr');
        for (let fila of filas) {
            if (fila.children[0] && fila.children[0].textContent.trim() == id.toString()) {
                fila.classList.add('table-primary');
            }
        }
    }

    function desvincularReferencia() {
        document.getElementById('Referencia_Id').value = "";
        document.getElementById('Referencia_Tabla').value = "";
        const infoDiv = document.getElementById('referenciaSeleccionadaInfo');
        if (infoDiv) infoDiv.style.display = 'none';
        Array.from(document.querySelectorAll('#tablaReferenciasBody tr')).forEach(tr => tr.classList.remove('table-primary'));
    }

    function limpiarFormularioPago() {
        desvincularReferencia();
        document.getElementById('tablaReferenciasBody').innerHTML = '<tr><td colspan="3" class="text-muted text-center py-3">Seleccione un tipo de pago a la izquierda para ver registros.</td></tr>';
        document.getElementById('referenciaLabel').textContent = 'Registros Disponibles para Vincular';
    }

    function cargarPagos() {
        var tbody = document.getElementById('tablaPagosBody');
        if (!tbody) return;
        tbody.innerHTML = '<tr><td colspan="8" class="text-muted text-center py-3"><i class="fas fa-spinner fa-spin me-1"></i> Cargando pagos registrados...</td></tr>';

        fetch('/Pagos/Search')
            .then(resp => resp.json())
            .then(data => {
                if (!data || data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" class="text-muted text-center py-3">No hay pagos registrados en el sistema.</td></tr>';
                } else {
                    tbody.innerHTML = '';
                    data.forEach(function (pago) {
                        const fechaStr = pago.fechaPago ? pago.fechaPago.substring(0, 10) : '';
                        const montoFmt = pago.valor != null ? '$' + parseFloat(pago.valor).toFixed(2) : '$0.00';
                        tbody.innerHTML += `<tr>
                            <td class="fw-bold">${pago.id}</td>
                            <td>${pago.tipo_pago || ''}</td>
                            <td>${pago.tipoPago || ''}</td>
                            <td class="fw-semibold text-success">${montoFmt}</td>
                            <td>${fechaStr}</td>
                            <td><span class="badge ${pago.estado === 'ACTIVO' ? 'bg-success' : 'bg-secondary'}">${pago.estado || 'ACTIVO'}</span></td>
                            <td>${pago.concepto || ''}</td>
                            <td><small class="text-muted">${pago.referencia_tabla || ''} #${pago.referencia_id || ''}</small></td>
                        </tr>`;
                    });
                }
            })
            .catch(err => {
                console.error('Error cargando pagos:', err);
                tbody.innerHTML = '<tr><td colspan="8" class="text-danger text-center py-3">Error al cargar pagos.</td></tr>';
            });
    }

    document.getElementById('ver-pagos-tab').addEventListener('click', cargarPagos);

    document.getElementById('nuevoPagoForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        const refId = document.getElementById("Referencia_Id").value;
        if (!refId) {
            alert("Por favor seleccione un registro de la tabla derecha para vincular el pago antes de guardar.");
            return;
        }

        const form = e.target;
        const formData = new FormData(form);

        formData.append("Referencia_Id", document.getElementById("Referencia_Id").value);
        formData.append("Referencia_Tabla", document.getElementById("Referencia_Tabla").value);

        try {
            const response = await fetch('/Pagos/Create', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                alert("Pago registrado con éxito.");
                form.reset();
                limpiarFormularioPago();
                cargarPagos();
            } else {
                const errorMsg = Array.isArray(result.errors) ? result.errors.join("\n") : (result.message || "Error al registrar pago.");
                alert("Error al registrar:\n" + errorMsg);
            }
        } catch (error) {
            console.error('Error registrando pago:', error);
            alert("Error de conexión al registrar el pago.");
        }
    });

    document.addEventListener('DOMContentLoaded', function () {
        cargarPagos();
    });
</script>
