@{
    ViewData["Title"] = "Registro de Confirmación";
    ViewData["ActiveSubmenu"] = "Confirmacion";
    Layout = "_Layout";
}

<partial name="_SubmenuSacramentos" />

<div class="mb-3 text-center">
    <h1 class="h3 mb-0 text-primary fw-bold">Gestión de Confirmación</h1>
</div>
<div class="row justify-content-center align-items-start g-3">
    <!-- Formulario compacto a 2 columnas internas -->
    <div class="col-lg-5 col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-3">
                <form asp-action="Create" id="plantilla-com" asp-controller="Confirmacion" method="post" autocomplete="off">
                    <h5 class="card-title text-primary fw-bold mb-3"><i class="fas fa-dove me-1 text-info"></i> Inscripción de Confirmación</h5>

                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label for="nombre" class="form-label mb-1 fw-semibold small">Nombre</label>
                            <input type="text" class="form-control form-control-sm" id="nombre" name="nombre" required>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="apellido" class="form-label mb-1 fw-semibold small">Apellido</label>
                            <input type="text" class="form-control form-control-sm" id="apellido" name="apellido" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label for="cedula" class="form-label mb-1 fw-semibold small">Cédula</label>
                            <input type="text" class="form-control form-control-sm" id="cedula" name="cedula" required>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="fechaNacimiento" class="form-label mb-1 fw-semibold small">Fecha de Nacimiento</label>
                            <input type="date" class="form-control form-control-sm" id="fechaNacimiento" name="fechaNacimiento" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label for="direccion" class="form-label mb-1 fw-semibold small">Dirección</label>
                            <input type="text" class="form-control form-control-sm" id="direccion" name="direccion" required>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="telefono" class="form-label mb-1 fw-semibold small">Teléfono</label>
                            <input type="tel" class="form-control form-control-sm" id="telefono" name="telefono" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label for="fechaconfirmacion" class="form-label mb-1 fw-semibold small">Fecha de Confirmación</label>
                            <input type="date" class="form-control form-control-sm" id="fechaconfirmacion" name="fechaconfirmacion" required>
                        </div>
                        <div class="col-md-6 mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="parroquia_id" class="form-label mb-0 fw-semibold small">Parroquia</label>
                                <a href="/Submenus/ParroquiaView" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.72rem;" title="Ir a registrar una nueva parroquia">+ Nueva</a>
                            </div>
                            <select class="form-select form-select-sm" id="parroquia_id" name="parroquia_id" required>
                                <option value="">Seleccione Parroquia</option>
                            </select>
                            <div id="alertaSinParroquias" class="text-danger small mt-1" style="display:none; font-size: 0.75rem;">
                                No hay parroquias. <a href="/Submenus/ParroquiaView" class="fw-bold text-decoration-underline">Registrar aquí</a>.
                            </div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="sacerdote_id" class="form-label mb-0 fw-semibold small">Sacerdote</label>
                            <a href="/Submenus/SacerdoteView" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.72rem;" title="Ir a registrar un nuevo sacerdote">+ Nuevo</a>
                        </div>
                        <select class="form-select form-select-sm" id="sacerdote_id" name="sacerdote_id" required>
                            <option value="">Seleccione Sacerdote</option>
                        </select>
                        <div id="alertaSinSacerdotes" class="text-danger small mt-1" style="display:none; font-size: 0.75rem;">
                            No hay sacerdotes. <a href="/Submenus/SacerdoteView" class="fw-bold text-decoration-underline">Registrar aquí</a>.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="observaciones" class="form-label mb-1 fw-semibold small">Observaciones</label>
                        <textarea class="form-control form-control-sm" id="observaciones" name="observaciones" rows="2" required>Sin Observaciones</textarea>
                    </div>

                    <div class="d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-primary btn-sm px-4 mr-2">Registrar</button>
                        <button type="reset" class="btn btn-secondary btn-sm px-4">Limpiar</button>
                    </div>
                    <div id="exito" class="text-success mt-2 text-center fw-semibold small" style="display: none;">Confirmación Registrada</div>
                </form>
            </div>
        </div>
    </div>

    <!-- Tabla ajustada al 100% sin barra lateral forzada -->
    <div class="col-lg-7 col-md-7">
        <div class="card shadow-sm">
            <div class="card-body p-3">
                <form asp-action="Search" method="get" id="buscar-acta" asp-controller="Confirmacion" onsubmit="event.preventDefault(); Buscar();">
                    <div class="mb-3 d-flex">
                        <input type="text" id="nombrecompleto" name="nombrecompleto" class="form-control form-control-sm me-2 mr-2" placeholder="Buscar por nombre o apellido..." />
                        <button type="button" class="btn btn-primary btn-sm me-2 mr-2 text-nowrap" onclick="Buscar()">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm text-nowrap" onclick="LimpiarBusqueda()">
                            Limpiar
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-sm text-center align-middle mb-0" style="font-size: 0.86rem; width: 100%;">
                            <thead class="thead-light">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Apellido</th>
                                    <th>Teléfono</th>
                                    <th>F. Nacimiento</th>
                                    <th>Parroquia</th>
                                    <th>Modificar</th>
                                    <th>Eliminar</th>
                                </tr>
                            </thead>
                            <tbody id="resultados">
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.nombre</td>
                                            <td>@item.apellido</td>
                                            <td>@item.telefono</td>
                                            <td>@item.fechanacimiento.ToString("dd/MM/yyyy")</td>
                                            <td>@item.parroquia</td>
                                            <td>
                                                <a asp-action="ModifyConfirmacionView" asp-controller="Confirmacion"
                                                    asp-route-id="@item.id" class="btn btn-warning btn-sm">Modificar</a>
                                            </td>
                                            <td>
                                                <a asp-action="DeleteConfirmacionView" asp-controller="Confirmacion"
                                                    asp-route-id="@item.id" class="btn btn-danger btn-sm" id="btnEliminar">Eliminar</a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<script>

    document.getElementById("plantilla-com").addEventListener("submit", function (event) {
        event.preventDefault(); // Evitar el envío del formulario por defecto

        var formData = new FormData(this);
        fetch(this.action, {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                // Ocultar el label de error al enviar el formulario
                document.getElementById("exito").style.display = "none";
                if (data.success) {
                    document.getElementById("exito").style.display = "block";
                    document.getElementById("plantilla-com").reset(); // 🔄 limpiar campos
                    setTimeout(() => {
                        document.getElementById("exito").style.display = "none";
                    }, 3000);
                    setTimeout(() => {
                    }, 2000);
                }
                else {
                    document.getElementById("exito").className = "text-danger";
                    if (Array.isArray(data.errors)) {
                        document.getElementById("exito").textContent = data.errors.join(", ");
                    } else {
                        document.getElementById("exito").textContent = data.errors || "Error desconocido.";
                    }
                    document.getElementById("exito").style.display = "block"
                }
            })
            .catch(error => {
                console.error('Error:', error);
                // Opcional: Mostrar un mensaje de error genérico
                document.getElementById("exito").innerText = error;
                document.getElementById("exito").style.display = "block";
            });
    });
    function cargarParroquias() {
        fetch('/Confirmacion/GetParroquias')
            .then(response => response.json())
            .then(data => {
                let parroquiaSelect = document.getElementById('parroquia_id');
                parroquiaSelect.innerHTML = '<option value="">Seleccione una Parroquia</option>';
                data.forEach(parroquia => {
                    parroquiaSelect.innerHTML += `<option value="${parroquia.id}">${parroquia.nombre}</option>`;
                });
                document.getElementById('alertaSinParroquias').style.display = (!data || data.length === 0) ? 'block' : 'none';
            })
            .catch(error => console.log('Error:', error));
    }
    function cargarSacerdotes() {
        fetch('/Confirmacion/GetSacerdotes')
            .then(response => response.json())
            .then(data => {
                let sacerdoteSelect = document.getElementById('sacerdote_id');
                sacerdoteSelect.innerHTML = '<option value="">Seleccione un Sacerdote</option>';
                data.forEach(sacerdote => {
                    sacerdoteSelect.innerHTML += `<option value="${sacerdote.id}">${sacerdote.nombre}</option>`;
                });
                document.getElementById('alertaSinSacerdotes').style.display = (!data || data.length === 0) ? 'block' : 'none';
            })
            .catch(error => console.log('Error:', error));
    }

    function List() {
        fetch('/Confirmacion/GetListado')
            .then(response => response.json())
            .then(data => {
                const resultadosBody = document.getElementById("resultados");
                if (!resultadosBody) {
                    console.error("Elemento con id 'resultadosBody' no encontrado.");
                    return;
                }
                resultadosBody.innerHTML = ""; // Limpiar resultados anteriores

                if (data.length > 0) {
                    data.forEach(item => {
                        const row = `<tr>
                            <td>${item.nombre}</td>
                            <td>${item.apellido}</td>
                            <td>${item.telefono}</td>
                            <td>${item.fechanacimiento}</td>
                            <td>${item.parroquia}</td>
                            <td><a href="/Confirmacion/ModifyConfirmacionView/${item.id}" class="btn btn-warning">Actualizar</a></td>
                            <td><a href="/Confirmacion/DeleteConfirmacionView/${item.id}" class="btn btn-danger" id="btnEliminar">Eliminar</a></td>
                        </tr>`;
                        resultadosBody.innerHTML += row;
                    });
                } else {
                    resultadosBody.innerHTML = "<tr><td colspan='6'>No se encontraron resultados.</td></tr>";
                }
            })
            .catch(error => console.error('Error en la búsqueda:', error));
    }

    function Buscar(event) {
        if (event) event.preventDefault(); // Evita el submit tradicional si viene de un formulario

        const nombre = document.getElementById('nombrecompleto').value;
        const resultadosBody = document.getElementById('resultados');

        if (nombre.length >= 3) {
            fetch(`/Confirmacion/GetListado?nombrecompleto=${nombre}`)
                .then(response => response.json())
                .then(data => {
                    resultadosBody.innerHTML = '';

                    if (data.length > 0) {
                        data.forEach(item => {
                            const row = `<tr>
                                <td>${item.nombre}</td>
                                <td>${item.apellido}</td>
                                <td>${item.telefono}</td>
                                <td>${item.fechanacimiento}</td>
                                <td>${item.parroquia}</td>
                                <td><a href="/Confirmacion/ModifyConfirmacionView/${item.id}" class="btn btn-warning">Actualizar</a></td>
                                <td><a href="/Confirmacion/DeleteConfirmacionView/${item.id}" class="btn btn-danger">Eliminar</a></td>
                            </tr>`;
                            resultadosBody.innerHTML += row;
                        });
                    } else {
                        resultadosBody.innerHTML = `<tr><td colspan="7">No se encontraron resultados.</td></tr>`;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    resultadosBody.innerHTML = `<tr><td colspan="7">Error en la búsqueda.</td></tr>`;
                });
        } else {
            resultadosBody.innerHTML = `<tr><td colspan="7">Ingrese al menos 3 letras para buscar.</td></tr>`;
        }
    }

    // Intercepta el submit del formulario para que Enter funcione igual que el botón
    document.getElementById('buscar-acta').addEventListener('submit', Buscar);

    function LimpiarBusqueda() {
        // Limpiar el campo de búsqueda
        document.getElementById('nombrecompleto').value = '';

        // Volver a cargar los 8 últimos registros
        List();
    }

    // Observaciones por defecto en Confirmación
    document.getElementById('observaciones').addEventListener('focus', function () {
        if (this.value === 'Sin Observaciones') {
            this.value = '';
        }
    });
    document.getElementById('observaciones').addEventListener('blur', function () {
        if (this.value.trim() === '') {
            this.value = 'Sin Observaciones';
        }
    });

    document.addEventListener("DOMContentLoaded", function () {
        cargarParroquias();
        cargarSacerdotes();
        List();

        window.onload = function () {
        }
    });

</script>