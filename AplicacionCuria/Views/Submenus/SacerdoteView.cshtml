@{
    ViewData["Title"] = "Gestión de Sacerdotes";
    Layout = "_Layout";
}

<h2>Gestión de Sacerdotes</h2>

<div class="row">
    <div class="col-md-5">
        <form id="formSacerdote">
            <input type="hidden" id="id" name="id" value="0" />
            <div class="mb-3">
                <label for="nombre" class="form-label">Nombre</label>
                <input class="form-control" id="nombre" name="nombre" required maxlength="255" />
            </div>
            <div class="mb-3">
                <label for="apellido" class="form-label">Apellido</label>
                <input class="form-control" id="apellido" name="apellido" required maxlength="255" />
            </div>
            <div class="mb-3">
                <label for="cedula" class="form-label">Cédula</label>
                <input class="form-control" id="cedula" name="cedula" maxlength="20" />
            </div>
            <div class="mb-3">
                <label for="telefono" class="form-label">Teléfono</label>
                <input class="form-control" id="telefono" name="telefono" maxlength="20" />
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Correo electrónico</label>
                <input type="email" class="form-control" id="email" name="email" maxlength="255" />
            </div>

            <div class="mb-3">
                <label for="firma" class="form-label">Firma Digital</label>
                <input type="file" class="form-control" id="firma" name="firma" accept="image/*" />
            </div>

            <div class="mb-3">
                <label for="estado" class="form-label">Estado</label>
                <select class="form-control" id="estado" name="estado">
                    <option value="ACTIVO">ACTIVO</option>
                    <option value="INACTIVO">INACTIVO</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="observaciones" class="form-label">Observaciones</label>
                <textarea class="form-control" id="observaciones" name="observaciones"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Registrar</button>
            <button type="button" class="btn btn-secondary" id="btnNuevo">Nuevo</button>
        </form>
        <div id="msgSacerdote" class="mt-2"></div>
    </div>
    <div class="col-md-7">
        <div class="mb-3">
            <input type="text" id="busquedaSacerdote" class="form-control" placeholder="Buscar por nombre..." />
        </div>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Cédula</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Estado</th>
                    <th>Observaciones</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="tablaSacerdotes">
                <!-- Se llena por JS -->
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script>
        $(function () {
            cargarSacerdotes();

            $("#busquedaSacerdote").on("input", function () {
                buscarSacerdotes($(this).val());
            });

            $("#formSacerdote").submit(function (e) {
                e.preventDefault();
                let id = $("#id").val();
                let url = id == 0 ? "/Sacerdotes/Create" : "/Sacerdotes/Edit/" + id;

                let formData = new FormData();
                formData.append("id", id);
                formData.append("nombre", $("#nombre").val());
                formData.append("apellido", $("#apellido").val());
                formData.append("cedula", $("#cedula").val());
                formData.append("telefono", $("#telefono").val());
                formData.append("email", $("#email").val());
                formData.append("estado", $("#estado").val());
                formData.append("observaciones", $("#observaciones").val());

                // Adjuntar la firma si existe
                let file = $("#firma")[0].files[0];
                if (file) {
                    formData.append("firma", file);
                }

                $.ajax({
                    url: url,
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        if (res.success) {
                            cargarSacerdotes();
                            limpiarFormulario();
                            mostrarMsg("Sacerdote guardado correctamente.", true);
                        } else {
                            mostrarMsg(res.message || "Error al guardar.", false);
                        }
                    }
                });
            });

            $("#btnNuevo").click(function () {
                limpiarFormulario();
            });
        });

        function cargarSacerdotes() {
            $.get("/Sacerdotes/GetSacerdotes", function (data) {
                renderTabla(data);
            });
        }

        function buscarSacerdotes(nombre) {
            if (!nombre) {
                cargarSacerdotes();
                return;
            }
            $.get("/Sacerdotes/SearchByName", { nombre: nombre }, function (data) {
                renderTabla(data);
            });
        }

        function renderTabla(data) {
            let html = "";
            data.forEach(function (s) {
                html += `<tr>
                    <td>${s.nombre}</td>
                    <td>${s.apellido}</td>
                    <td>${s.cedula ?? ""}</td>
                    <td>${s.telefono ?? ""}</td>
                    <td>${s.email ?? ""}</td>
                    <td>${s.estado ?? ""}</td>
                    <td>${s.observaciones ?? ""}</td>
                    <td>
                        <button class="btn btn-warning btn-sm" onclick="editarSacerdote(${s.id})">Editar</button>
                        <button class="btn btn-danger btn-sm" onclick="eliminarSacerdote(${s.id})">Eliminar</button>
                    </td>
                </tr>`;
            });
            $("#tablaSacerdotes").html(html);
        }

        function editarSacerdote(id) {
            $.get("/Sacerdotes/GetSacerdotes", function (data) {
                let sacerdote = data.find(s => s.id === id);
                if (sacerdote) {
                    $("#id").val(sacerdote.id);
                    $("#nombre").val(sacerdote.nombre);
                    $("#apellido").val(sacerdote.apellido);
                    $("#cedula").val(sacerdote.cedula);
                    $("#telefono").val(sacerdote.telefono);
                    $("#email").val(sacerdote.email);
                    $("#estado").val(sacerdote.estado);
                    $("#observaciones").val(sacerdote.observaciones);
                }
            });
        }

        function eliminarSacerdote(id) {
            if (confirm("¿Seguro que deseas eliminar este sacerdote?")) {
                $.post("/Sacerdotes/DeleteConfirmed", { id: id }, function (res) {
                    if (res.success) {
                        cargarSacerdotes();
                        mostrarMsg("Sacerdote eliminado.", true);
                    } else {
                        mostrarMsg("No se pudo eliminar.", false);
                    }
                });
            }
        }

        function limpiarFormulario() {
            $("#id").val(0);
            $("#nombre").val("");
            $("#apellido").val("");
            $("#cedula").val("");
            $("#telefono").val("");
            $("#email").val("");
            $("#estado").val("ACTIVO");
            $("#observaciones").val("");
        }

        function mostrarMsg(msg, exito) {
            $("#msgSacerdote").text(msg).removeClass().addClass(exito ? "text-success" : "text-danger");
            setTimeout(() => { $("#msgSacerdote").text(""); }, 3000);
        }
    </script>
}