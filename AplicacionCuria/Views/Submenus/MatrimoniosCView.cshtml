    document.getElementById('btnImprimirCursilloMatrimonio').addEventListener('click', function () {
        const cursilloId = document.getElementById('cursilloId').value;
        const sacerdoteId = document.getElementById('sacerdoteIdCursillo').value;

        if (!cursilloId || !sacerdoteId) {
            Swal.fire({
                icon: 'warning',
                title: '¡Atención!',
                text: 'Debe seleccionar un cursillo de matrimonio y un sacerdote antes de imprimir.',
            });
            return;
        }

        Swal.fire({
            title: '¿Deseas guardar una copia del certificado en PDF?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, imprimir y guardar',
            cancelButtonText: 'Solo imprimir',
        }).then((result) => {
            Swal.fire({
                title: 'Enviando certificado...',
                text: 'Por favor espera mientras se envía a la impresora.',
                didOpen: () => {
                    Swal.showLoading();
                },
                allowOutsideClick: false
            });

            fetch(`/Certificados/ImprimirCertificadoCursilloMatrimonio?cursilloid=${cursilloId}&sacerdoteId=${sacerdoteId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '¡Impresión iniciada!',
                            text: data.message,
                            timer: 3000,
                            showConfirmButton: false
                        });

                        if (result.isConfirmed && data.file) {
                            window.location.href = `/Certificados/DescargarPdf?fileName=${data.file}`;
                        }
                    } else {
                        throw new Error(data.message);
                    }
                })
                .catch(error => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error.message,
                    });
                });
        });
    });
