<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    function seleccionarAlumno(element) {
        const alumnoId = element.getAttribute('data-id'); // Obtener el id del alumno
        console.log(alumnoId);
        document.getElementById('cursilloId').value = alumnoId; // Guardarlo en el input hidden

        document.querySelectorAll('.btn-seleccionar').forEach(btn => {
            btn.classList.remove('btn-dark');   // Remover color verde oscuro
            btn.classList.add('btn-success');   // Restaurar el color verde claro
            btn.textContent = "Seleccionar";    // Restaurar texto
            btn.disabled = false;               // Reactivar los botones deshabilitados
        });

        element.classList.remove('btn-success'); // Remover la clase verde claro
        element.classList.add('btn-dark');       // Agregar clase verde oscuro (o btn-dark)
        element.textContent = "Seleccionado";    // Cambiar el texto del botón
        element.disabled = true;                 // Deshabilitar el botón para evitar múltiples selecciones

    }

    function seleccionarActa(element) {
        const alumnoId = element.getAttribute('data-id'); // Obtener el id del alumno
        console.log(alumnoId);
        document.getElementById('matid').value = alumnoId; // Guardarlo en el input hidden

        document.querySelectorAll('.btn-seleccionar').forEach(btn => {
            btn.classList.remove('btn-dark');   // Remover color verde oscuro
            btn.classList.add('btn-success');   // Restaurar el color verde claro
            btn.textContent = "Seleccionar";    // Restaurar texto
            btn.disabled = false;               // Reactivar los botones deshabilitados
        });

        element.classList.remove('btn-success'); // Remover la clase verde claro
        element.classList.add('btn-dark');       // Agregar clase verde oscuro (o btn-dark)
        element.textContent = "Seleccionado";    // Cambiar el texto del botón
        element.disabled = true;                 // Deshabilitar el botón para evitar múltiples selecciones

    }

    // Buscar con mínimo 3 caracteres
    function buscarCursillo() {
        const nombre = document.getElementById('nombrecompletos').value.trim();
        const resultadosBody = document.getElementById('resultadosBody');

        if (nombre.length === 0) {
            ListActasMatrimonio();
            return;
        }

        fetch(`/CursilloPreMatrimonial/SearchByNameAprobado?nombrecompleto=${encodeURIComponent(nombre)}`)
            .then(response => response.json())
            .then(data => {
                resultadosBody.innerHTML = '';
                if (data.length > 0) {
                    data.forEach(item => {
                        const row = `<tr>
                            <td>${item.nombrenovio}</td>
                            <td>${item.nombrenovia}</td>
                            <td>${new Date(item.fechacursillo).toLocaleDateString()}</td>
                            <td>${new Date(item.fechamatrimonio).toLocaleDateString()}</td>
                            <td><a class="btn btn-success btn-seleccionar" data-id="${item.id}" onclick="seleccionarAlumno(this)">Seleccionar</a></td>
                        </tr>`;
                        resultadosBody.innerHTML += row;
                    });
                } else {
                    resultadosBody.innerHTML = `<tr><td colspan="5">No se encontraron resultados.</td></tr>`;
                }
            })
            .catch(error => {
                resultadosBody.innerHTML = `<tr><td colspan="5">Error al buscar resultados.</td></tr>`;
                console.error('Error:', error);
            });
    }

    // Limpiar búsqueda y tabla
    function limpiarBusquedaCursillo() {
        document.getElementById('nombrecompletos').value = '';
        ListActasMatrimonio();
    }

    // Mostrar todos los registros aprobados
    function toggleCursillos() {
        const toggle = document.getElementById('chkToggleCursillos').checked;
        if (toggle) {
            ListActasMatrimonio(); // Carga todos los cursillos aprobados
        } else {
            document.getElementById('resultadosBody').innerHTML = '';
        }
    }


    function buscarActa() {
        const nombre = document.getElementById('nombrecompletos').value;
        const resultadosBody = document.getElementById('resultadosBody');

        // Solo hacer la búsqueda si hay al menos un carácter
        if (nombre.length > 0) {
            fetch(`/CursilloPreMatrimonial/SearchByNameAprobado?nombrecompleto=${nombre}`)
                .then(response => response.json())
                .then(data => {
                    resultadosBody.innerHTML = ''; // Limpiar resultados anteriores

                    if (data.length > 0) {
                        data.forEach(item => {
                            const row = `<tr>
                                               <td>${item.nombrenovio}</td>
                                               <td>${item.nombrenovia}</td>
                                               <td>${new Date(item.fechacursillo).toLocaleDateString()}</td>
                                               <td>${new Date(item.fechamatrimonio).toLocaleDateString()}</td>
                                               <td><a  class="btn btn-success btn-seleccionar" data-id="${item.id}" onclick="seleccionarAlumno(this)">Seleccionar</a></td>
                                                    </tr>
                                            `;
                            resultadosBody.innerHTML += row;
                        });
                    } else {
                        resultadosBody.innerHTML = `<tr><td colspan="7">No se encontraron resultados.</td></tr>`;
                    }
                })
                .catch(error => {
                    resultadosBody.innerHTML = `<tr><td colspan="7">Error al buscar resultados.</td></tr>`;
                    console.error('Error:', error);
                });
        } else {
            // Mostrar mensaje por defecto si no hay búsqueda activa
            fetch('/CursilloPreMatrimonial/SearchAprobado')
                .then(response => response.json())
                .then(data => {
                    const resultadosBody = document.getElementById("resultadosBody");
                    if (!resultadosBody) {
                        console.error("Elemento con id 'resultadosBody' no encontrado.");
                        return;
                    }
                    resultadosBody.innerHTML = ""; // Limpiar resultados anteriores

                    if (data.length > 0) {
                        data.forEach(item => {
                            const row = `<tr >
                                                   <td>${item.nombrenovio}</td>
                                                   <td>${item.nombrenovia}</td>
                                                   <td>${new Date(item.fechacursillo).toLocaleDateString()}</td>
                                                   <td>${new Date(item.fechamatrimonio).toLocaleDateString()}</td>
                                                   <td><a  class="btn btn-success btn-seleccionar" data-id="${item.id}" onclick="seleccionarAlumno(this)">Seleccionar</a></td>
                                                 </tr>`;
                            resultadosBody.innerHTML += row; // Agregar cada resultado a la tabla
                        });
                    } else {
                        resultadosBody.innerHTML = "<tr><td colspan='6'>No se encontraron resultados.</td></tr>";
                    }
                })
                .catch(error => console.error('Error en la búsqueda:', error));
        }
    }


    function ListActasMatrimonio() {
        fetch('/CursilloPreMatrimonial/SearchAprobado')
            .then(response => response.json())
            .then(data => {
                const resultadosBody = document.getElementById("resultadosBody");
                if (!resultadosBody) {
                    console.error("Elemento con id 'resultadosBody' no encontrado.");
                    return;
                }
                resultadosBody.innerHTML = ""; // Limpiar resultados anteriores

                if (data.length > 0) {
                    // Ordenar por fecha de matrimonio de forma descendente (más reciente primero)
                    data.sort((a, b) => new Date(b.fechamatrimonio) - new Date(a.fechamatrimonio));

                    // Tomar solo los últimos 10 (o menos si hay menos de 10)
                    const ultimosRegistros = data.slice(0, 10);

                    ultimosRegistros.forEach(item => {
                        const row = `
                            <tr>
                                <td>${item.nombrenovio}</td>
                                <td>${item.nombrenovia}</td>
                                <td>${new Date(item.fechacursillo).toLocaleDateString()}</td>
                                <td>${new Date(item.fechamatrimonio).toLocaleDateString()}</td>
                                <td>
                                    <a class="btn btn-success btn-seleccionar" data-id="${item.id}" onclick="seleccionarAlumno(this)">Seleccionar</a>
                                </td>
                            </tr>`;
                        resultadosBody.innerHTML += row;
                    });
                } else {
                    resultadosBody.innerHTML = "<tr><td colspan='6'>No se encontraron resultados.</td></tr>";
                }
            })
            .catch(error => console.error('Error en la búsqueda:', error));
    }

    ///////////////////////////////////
    let mostrandoTodos = false;

    function buscarActa2() {
        const nombre = document.getElementById('nombrecompletos2').value.trim();
        listarActasParaCertificado(nombre);
    }

    function listarActasParaCertificado(nombre = "") {
        const resultadosBody = document.getElementById('Res');
        if (!resultadosBody) return;

        fetch(`/ActaPreMatrimonial/Search?nombre=${encodeURIComponent(nombre)}`)
            .then(response => response.json())
            .then(data => {
                resultadosBody.innerHTML = '';
                if (Array.isArray(data) && data.length > 0) {
                    data.forEach(item => {
                        resultadosBody.innerHTML += `
                            <tr>
                                <td>${item.nombrenovio}</td>
                                <td>${item.nombrenovia}</td>
                                <td>${formatFecha(item.fecha_matrimonio || item.fechamatrimonio)}</td>
                                <td>${new Date(item.fecharegistro).toLocaleDateString()}</td>
                                <td><button class="btn btn-success btn-seleccionar" data-id="${item.id}" onclick="seleccionarActa(this)">Seleccionar</button></td>
                            </tr>`;
                    });
                } else {
                    resultadosBody.innerHTML = `<tr><td colspan="5" class="text-center">No se encontraron resultados.</td></tr>`;
                }
            })
            .catch(error => {
                resultadosBody.innerHTML = `<tr><td colspan="5" class="text-danger text-center">Error al buscar resultados.</td></tr>`;
                console.error('Error:', error);
            });
    }

    function formatFecha(fecha) {
        if (!fecha) return "Sin fecha";
        const d = new Date(fecha);
        return isNaN(d.getTime()) ? fecha : d.toLocaleDateString();
    }

    function limpiarBusquedaActa() {
        document.getElementById('nombrecompletos2').value = '';
        listarActasParaCertificado('');
    }

    function toggleListarActas() {
        listarActasParaCertificado('');
    }

    function cargarSacerdotesCursillo() {
        fetch("/CursilloPreMatrimonial/GetSacerdotes")
            .then(response => response.json())
            .then(data => {
                const select = document.getElementById("sacerdoteIdCursillo");
                select.innerHTML = '<option value="">-- Seleccione un sacerdote --</option>';
                data.forEach(s => {
                    const option = document.createElement("option");
                    option.value = s.id;
                    option.textContent = s.nombre;
                    select.appendChild(option);
                });
            })
            .catch(error => console.error("Error al cargar sacerdotes:", error));
    }

    function cargarSacerdotesMatrimonio() {
        fetch("/CursilloPreMatrimonial/GetSacerdotes") // mismo endpoint
            .then(response => response.json())
            .then(data => {
                const select = document.getElementById("sacerdoteIdMatrimonio");
                select.innerHTML = '<option value="">-- Seleccione un sacerdote --</option>';
                data.forEach(s => {
                    const option = document.createElement("option");
                    option.value = s.id;
                    option.textContent = s.nombre;
                    select.appendChild(option);
                });
            })
            .catch(error => console.error("Error al cargar sacerdotes:", error));
    }

    function cargarParroquiasMatrimonio() {
        fetch("/CursilloPreMatrimonial/GetParroquias")
            .then(response => response.json())
            .then(data => {
                const select = document.getElementById("parroquiaIdMatrimonio");
                select.innerHTML = '<option value="">-- Seleccione una parroquia --</option>';
                data.forEach(p => {
                    const option = document.createElement("option");
                    option.value = p.id;
                    option.textContent = p.nombre;
                    select.appendChild(option);
                });
            })
            .catch(error => console.error("Error al cargar parroquias:", error));
    }

    //////////////////////////////////////////////////////////////

    // Buscar Reporte de Acta de Matrimonio
    function buscarReporteActa(nombre) {
        if (nombre === undefined) {
            nombre = document.getElementById('nombreReporte')?.value || '';
        }
        nombre = nombre.trim();

        fetch(`/ActaPreMatrimonial/SearchReporte?nombre=${encodeURIComponent(nombre)}`)
            .then(response => response.json())
            .then(data => renderResultadosReporte(data))
            .catch(error => console.error('Error en la búsqueda del reporte:', error));
    }

    // Limpiar búsqueda de Reporte
    function limpiarBusquedaReporteActa() {
        document.getElementById('nombreReporte').value = '';
        const select = document.getElementById('sacerdoteIdReporte');
        if (select) select.value = '';
        buscarReporteActa('');
    }

    let actaSeleccionada = null; // variable global para almacenar el ID seleccionado

    function seleccionarReporte(id) {
        actaSeleccionada = id;
        console.log("Acta seleccionada ID:", actaSeleccionada);
    }

    // Renderizar resultados del reporte
    function renderResultadosReporte(data) {
        const resultadosBody = document.getElementById('ResReporte');
        resultadosBody.innerHTML = '';

        if (data.length > 0) {
            data.forEach(item => {
                resultadosBody.innerHTML += `
                    <tr>
                        <td>${item.novio}</td>
                        <td>${item.novia}</td>
                        <td>${new Date(item.fechaMatrimonio).toLocaleDateString()}</td>
                        <td>
                            <button type="button" class="btn btn-success btn-sm" onclick="seleccionarReporte(${item.id})">
                                Seleccionar
                            </button>
                        </td>
                    </tr>`;
            });
        } else {
            resultadosBody.innerHTML = "<tr><td colspan='5'>No se encontraron resultados.</td></tr>";
        }
    }

    document.getElementById('btnGenerarReporte').addEventListener('click', function () {
        const sacerdoteId = document.getElementById('sacerdoteIdReporte').value;

        if (!actaSeleccionada || !sacerdoteId) {
            Swal.fire({
                icon: 'warning',
                title: '¡Atención!',
                text: 'Debe seleccionar un acta y un sacerdote antes de generar el reporte.',
            });
            return;
        }

        Swal.fire({
            title: '¿Deseas guardar una copia del reporte en PDF?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, generar y guardar',
            cancelButtonText: 'Solo imprimir',
        }).then((result) => {
            Swal.fire({
                title: 'Generando reporte...',
                text: 'Por favor espera mientras se envía a la impresora.',
                didOpen: () => {
                    Swal.showLoading();
                },
                allowOutsideClick: false
            });

            fetch(`/Certificados/ImprimirReportePDF?id=${actaSeleccionada}&sacerdoteId=${sacerdoteId}`)
                .then(response => {
                    console.log("Estado respuesta:", response.status);
                    return response.json(); // <- Usa JSON directo
                })
                .then(data => {
                    console.log("Respuesta servidor:", data);

                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '¡Reporte generado!',
                            text: data.message,
                            timer: 3000,
                            showConfirmButton: false
                        });

                        if (result.isConfirmed && data.file) {
                            window.location.href = `/Certificados/DescargarPdf?fileName=${data.file}`;
                        }
                    } else {
                        throw new Error(data.message);
                    }
                })
                .catch(error => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error.message,
                    });
                });
        });
    });

    function cargarSacerdotes() {
        fetch('/ActaMatrimonial/GetSacerdotes')
            .then(response => response.json())
            .then(data => {
                const select = document.getElementById('sacerdoteIdReporte');
                select.innerHTML = '<option value="">-- Seleccione un sacerdote --</option>';
                data.forEach(s => {
                    select.innerHTML += `<option value="${s.id}">${s.nombre}</option>`;
                });
            })
