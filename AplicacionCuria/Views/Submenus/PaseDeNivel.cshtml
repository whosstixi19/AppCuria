<div class="d-flex align-items-center mb-3">
    <a class="btn btn-secondary d-flex align-items-center" asp-area="" asp-controller="Home"
        asp-action="MenuCertificado">
        <i class="fas fa-arrow-left me-1"></i> <!-- Icono de flecha hacia la izquierda -->
        <span>Volver</span>
    </a>
    <h1 class="ms-3">Pase de nivel</h1>
</div>

<div>
    <form id="buscar-alumno">
        <h3>Búsqueda de Alumnos</h3>
        <input type="hidden" id="alumnoId" name="alumnoid">

        <div class="mb-3 d-flex gap-2 align-items-center">
            <button type="button" id="btnImprimir" class="btn btn-primary">
                <i class="fas fa-print"></i> Imprimir
            </button>
        </div>

        <div class="mb-3 d-flex gap-2 align-items-center">
            <input type="text" class="form-control w-50" id="nombrecompleto" name="nombrecompleto"
                placeholder="Escribe un nombre...">

            <button type="button" class="btn btn-primary d-flex align-items-center justify-content-center"
                    onclick="buscarPaseNivel()">
                <i class="fas fa-search me-1"></i> Buscar
            </button>

            <button type="button" class="btn btn-secondary d-flex align-items-center justify-content-center"
                    onclick="limpiarBusquedaPaseNivel()">
                Limpiar
            </button>

            <div class="form-check form-switch ms-3">
                <input class="form-check-input" type="checkbox" id="toggleListaPase" onchange="toggleListaPaseNivel()">
                <label class="form-check-label ms-2" for="toggleListaPase">
                    Mostrar todos
                </label>
            </div>
        </div>

        <div class="mt-3">
            <label for="sacerdoteIdCertificado" class="form-label">Seleccionar Sacerdote:</label>
            <select class="form-select w-50" id="sacerdoteIdCertificado" name="sacerdoteId">
                <option value="">-- Seleccione un sacerdote --</option>
            </select>
        </div>

        <div class="mt-3">
            <h4>Resultados de la búsqueda:</h4>

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Foto</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Cédula</th>
                        <th>Nivel</th>
                        <th>Telefono</th>
                        <th>Fecha nacimiento</th>
                        <th>Dirección</th>
                        <th>Seleccionar</th>
                    </tr>
                </thead>
                <tbody id="resultados">
                    @if (Model != null && Model?.Any())
                    {
                        @foreach (var alumno in Model)
                        {
                            <tr>
                                <td>
                                    @if (alumno.foto != null && alumno.foto.Length > 0)
                                    {
                                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(alumno.foto)"
                                            alt="Foto de @alumno.nombre" width="100" height="100" />
                                    }
                                    else
                                    {
                                        <span>Sin foto</span>
                                    }
                                </td>
                                <td>@alumno.nombre</td>
                                <td>@alumno.apellido</td>
                                <td>@alumno.cedula</td>
                                <td>@alumno.nivel</td>
                                <td>@alumno.direccion</td>
                                <td>@alumno.telefono</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">No se encontraron resultados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>

</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.getElementById('btnImprimir').addEventListener('click', function () {
        const alumnoId = document.getElementById('alumnoId').value;
        const sacerdoteId = document.getElementById('sacerdoteIdCertificado').value;

        if (!alumnoId) {
            Swal.fire({
                icon: 'warning',
                title: '¡Atención!',
                text: 'Debe seleccionar un alumno antes de imprimir.',
            });
            return;
        }

        if (!sacerdoteId) {
            Swal.fire({
                icon: 'warning',
                title: '¡Atención!',
                text: 'Debe seleccionar un sacerdote antes de imprimir.',
            });
            return;
        }

        Swal.fire({
            title: '¿Deseas guardar una copia del certificado en PDF?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, imprimir y guardar',
            cancelButtonText: 'Solo imprimir',
        }).then((result) => {
            Swal.fire({
                title: 'Enviando certificado...',
                text: 'Por favor espera mientras se envía a la impresora.',
                didOpen: () => {
                    Swal.showLoading();
                },
                allowOutsideClick: false
            });

            fetch(`/Certificados/Imprimir?alumnoid=${alumnoId}&sacerdoteId=${sacerdoteId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '¡Impresión iniciada!',
                            text: data.message,
                            timer: 3000,
                            showConfirmButton: false
                        });

                        if (result.isConfirmed && data.file) {
                            window.location.href = `/Certificados/DescargarPdf?fileName=${data.file}`;
                        }
                    } else {
                        throw new Error(data.message);
                    }
                })
                .catch(error => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error.message,
                    });
                });
        });
    });


    function seleccionarAlumno(element) {
        const alumnoId = element.getAttribute('data-id'); // Obtener el id del alumno
        console.log(alumnoId);
        document.getElementById('alumnoId').value = alumnoId; // Guardarlo en el input hidden
        document.querySelectorAll('.btn-seleccionar').forEach(btn => {
            btn.classList.remove('btn-dark');   // Remover color verde oscuro
            btn.classList.add('btn-success');   // Restaurar el color verde claro
            btn.textContent = "Seleccionar";    // Restaurar texto
            btn.disabled = false;               // Reactivar los botones deshabilitados
        });
        element.classList.remove('btn-success'); // Remover la clase verde claro
        element.classList.add('btn-dark');       // Agregar clase verde oscuro (o btn-dark)
        element.textContent = "Seleccionado";    // Cambiar el texto del botón
        element.disabled = true;                 // Deshabilitar el botón para evitar múltiples selecciones
    }

    function listarTodosPaseNivel() {
        fetch('/Certificados/Search')
            .then(response => response.json())
            .then(data => {
                if (data.length > 0) {
                    // Ordenar por ID descendente (últimos registrados primero)
                    data.sort((a, b) => b.id - a.id);

                    // Tomar solo los últimos 10 registros
                    const ultimosRegistros = data.slice(0, 10);

                    renderResultadosPaseNivel(ultimosRegistros);
                } else {
                    renderResultadosPaseNivel([]);
                }
            })
            .catch(error => console.error('Error al listar todos:', error));
    }

    function buscarPaseNivel() {
        const nombre = document.getElementById('nombrecompleto').value.trim();
        if (nombre.length < 3) {
            alert('Por favor, escribe al menos 3 caracteres para buscar.');
            return;
        }

        fetch(`/Certificados/SearchByNamePaseNivel?nombre=${encodeURIComponent(nombre)}`)
            .then(response => response.json())
            .then(data => renderResultadosPaseNivel(data))
            .catch(error => console.error('Error en la búsqueda:', error));
    }

    function limpiarBusquedaPaseNivel() {
        document.getElementById('nombrecompleto').value = '';
        document.getElementById('resultados').innerHTML =
            "<tr><td colspan='9'>No se encontraron resultados.</td></tr>";
        document.getElementById('toggleListaPase').checked = false;
    }

    function toggleListaPaseNivel() {
        const toggle = document.getElementById('toggleListaPase');
        if (toggle.checked) {
            listarTodosPaseNivel();
        } else {
            limpiarBusquedaPaseNivel();
        }
    }

    function renderResultadosPaseNivel(data) {
        const resultadosBody = document.getElementById('resultados');
        resultadosBody.innerHTML = "";

        if (data.length > 0) {
            data.forEach(item => {
                resultadosBody.innerHTML += `
                    <tr>
                        <td>${item.foto ? `<img src="data:image/jpeg;base64,${item.foto}" width="100" height="100" />` : "Sin foto"}</td>
                        <td>${item.nombre}</td>
                        <td>${item.apellido}</td>
                        <td>${item.cedula}</td>
                        <td>${item.nivel}</td>
                        <td>${item.telefono}</td>
                        <td>${new Date(item.fechanacimiento).toLocaleDateString()}</td>
                        <td>${item.direccion}</td>
                        <td>
                            <a class="btn btn-success btn-seleccionar" data-id="${item.id}" onclick="seleccionarAlumno(this)">Seleccionar</a>
                        </td>
                    </tr>`;
            });
        } else {
            resultadosBody.innerHTML = "<tr><td colspan='9'>No se encontraron resultados.</td></tr>";
        }
    }
    function cargarSacerdotesCertificado() {
        fetch("/Certificados/GetSacerdotes") 
            .then(response => response.json())
            .then(data => {
                const select = document.getElementById("sacerdoteIdCertificado");
                select.innerHTML = '<option value="">-- Seleccione un sacerdote --</option>';
                data.forEach(s => {
                    const option = document.createElement("option");
                    option.value = s.id;
                    option.textContent = s.nombre;
                    select.appendChild(option);
                });
            })
            .catch(error => console.error("Error al cargar sacerdotes:", error));
    }





    document.addEventListener("DOMContentLoaded", function () {

        cargarSacerdotesCertificado()
    });
</script>