@{
    ViewData["Title"] = "Gestión de Misas";
    Layout = "_Layout";
}

<div class="container-fluid px-2">
    <h2 class="text-center mb-4">Gestión de Misas</h2>

    <div class="row justify-content-center align-items-start g-3">
        <div class="col-lg-4 col-md-5">
            <div class="card shadow-sm">
                <div class="card-body p-3">
                    <form id="formMisa">
                        <input type="hidden" id="id" name="id" value="0" />
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="nombre" class="form-label mb-1 fw-semibold">Nombre</label>
                                <input class="form-control form-control-sm" id="nombre" name="nombre" required maxlength="255" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="dia_semana" class="form-label mb-1 fw-semibold">Día de la Semana</label>
                                <select class="form-control form-control-sm" id="dia_semana" name="dia_semana">
                                    <option value="">Seleccione un día</option>
                                    <option value="Lunes">Lunes</option>
                                    <option value="Martes">Martes</option>
                                    <option value="Miércoles">Miércoles</option>
                                    <option value="Jueves">Jueves</option>
                                    <option value="Viernes">Viernes</option>
                                    <option value="Sábado">Sábado</option>
                                    <option value="Domingo">Domingo</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="hora_inicio" class="form-label mb-1 fw-semibold">Hora de Inicio</label>
                                <input type="time" class="form-control form-control-sm" id="hora_inicio" name="hora_inicio" required />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="hora_fin" class="form-label mb-1 fw-semibold">Hora de Fin</label>
                                <input type="time" class="form-control form-control-sm" id="hora_fin" name="hora_fin" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="iglesia_id" class="form-label mb-1 fw-semibold">Iglesia</label>
                                <select class="form-control form-control-sm" id="iglesia_id" name="iglesia_id">
                                    <option value="">Seleccione una iglesia</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="sacerdote_id" class="form-label mb-1 fw-semibold">Sacerdote</label>
                                <select class="form-control form-control-sm" id="sacerdote_id" name="sacerdote_id">
                                    <option value="">Seleccione un sacerdote</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label for="estado" class="form-label mb-1 fw-semibold">Estado</label>
                            <select class="form-control form-control-sm" id="estado" name="estado">
                                <option value="ACTIVO">ACTIVO</option>
                                <option value="INACTIVO">INACTIVO</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="descripcion" class="form-label mb-1 fw-semibold">Descripción</label>
                            <textarea class="form-control form-control-sm" id="descripcion" name="descripcion" rows="2"></textarea>
                        </div>

                        <div class="d-flex justify-content-center gap-2">
                            <button type="submit" class="btn btn-primary btn-sm px-4 mr-2">Registrar</button>
                            <button type="button" class="btn btn-secondary btn-sm px-4" id="btnLimpiarMisa">Limpiar</button>
                        </div>
                    </form>
                    <div id="msgMisa" class="mt-2 text-center fw-semibold"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-8 col-md-7">
            <div class="card shadow-sm">
                <div class="card-body p-3">
                    <div class="mb-3">
                        <input type="text" id="busquedaMisa" class="form-control form-control-sm" placeholder="Buscar por nombre..." />
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-sm text-center align-middle mb-0" style="font-size: 0.86rem; width: 100%;">
                            <thead class="thead-light">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Hora Inicio</th>
                                    <th>Hora Fin</th>
                                    <th>Día</th>
                                    <th>Iglesia</th>
                                    <th>Sacerdote</th>
                                    <th>Descripción</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tablaMisas">
                                <!-- Se llena por JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script>
        $(function () {
            cargarIglesias();
            cargarSacerdotes();
            cargarMisas();

            $("#busquedaMisa").on("input", function () {
                buscarMisas($(this).val());
            });

            $("#formMisa").submit(function (e) {
                e.preventDefault();
                let id = $("#id").val();
                let url = id == 0 ? "/Misas/Create" : "/Misas/Edit/" + id;
                let data = {
                    id: id,
                    nombre: $("#nombre").val(),
                    hora_inicio: $("#hora_inicio").val(),
                    hora_fin: $("#hora_fin").val(),
                    dia_semana: $("#dia_semana").val(),
                    iglesia_id: $("#iglesia_id").val(),
                    sacerdote_id: $("#sacerdote_id").val(),
                    descripcion: $("#descripcion").val(),
                    estado: $("#estado").val()
                };
                $.post(url, data, function (res) {
                    if (res.success) {
                        cargarMisas();
                        limpiarFormularioMisa();
                        mostrarMsgMisa("Misa guardada correctamente.", true);
                    } else {
                        mostrarMsgMisa(res.message || "Error al guardar.", false);
                    }
                });
            });

            $("#btnLimpiarMisa").click(function () {
                limpiarFormularioMisa();
                cargarIglesias();
                cargarSacerdotes();
            });
        });

        function cargarMisas() {
            $.get("/Misas/GetMisas", function (data) {
                renderTablaMisas(data);
            });
        }

        function buscarMisas(nombre) {
            if (!nombre) {
                cargarMisas();
                return;
            }
            $.get("/Misas/SearchByName", { nombre: nombre }, function (data) {
                renderTablaMisas(data);
            });
        }

        function cargarIglesias() {
            $.get("/Misas/GetIglesiasDisponibles", function (data) {
                let options = '<option value="">Seleccione una iglesia</option>';
                data.forEach(function (i) {
                    options += `<option value="${i.id}">${i.nombre}</option>`;
                });
                $("#iglesia_id").html(options);
            });
        }

        function cargarSacerdotes() {
            $.get("/Misas/GetSacerdotesDisponibles", function (data) {
                let options = '<option value="">Seleccione un sacerdote</option>';
                data.forEach(function (s) {
                    options += `<option value="${s.id}">${s.nombre}</option>`;
                });
                $("#sacerdote_id").html(options);
            });
        }

        function renderTablaMisas(data) {
            let html = "";
            data.forEach(function (m) {
                html += `<tr>
                    <td>${m.nombre}</td>
                    <td>${m.hora_inicio ? m.hora_inicio.substring(0,5) : ""}</td>
                    <td>${m.hora_fin ? m.hora_fin.substring(0,5) : ""}</td>
                    <td>${m.dia_semana ?? ""}</td>
                    <td>${m.iglesia_nombre ?? ""}</td>
                    <td>${m.sacerdote_nombre ?? ""}</td>
                    <td>${m.descripcion ?? ""}</td>
                    <td>${m.estado ?? ""}</td>
                    <td>
                        <button class="btn btn-warning btn-sm" onclick="editarMisa(${m.id})">Editar</button>
                        <button class="btn btn-danger btn-sm" onclick="eliminarMisa(${m.id})">Eliminar</button>
                    </td>
                </tr>`;
            });
            $("#tablaMisas").html(html);
        }

        function editarMisa(id) {
            $.get("/Misas/GetMisas", function (data) {
                let misa = data.find(m => m.id === id);
                if (misa) {
                    $("#id").val(misa.id);
                    $("#nombre").val(misa.nombre);
                    $("#hora_inicio").val(misa.hora_inicio ? misa.hora_inicio.substring(0,5) : "");
                    $("#hora_fin").val(misa.hora_fin ? misa.hora_fin.substring(0,5) : "");
                    $("#dia_semana").val(misa.dia_semana);
                    cargarIglesias();
                    cargarSacerdotes();
                    setTimeout(function () {
                        $("#iglesia_id").val(misa.iglesia_id);
                        $("#sacerdote_id").val(misa.sacerdote_id);
                    }, 200);
                    $("#descripcion").val(misa.descripcion);
                    $("#estado").val(misa.estado);
                }
            });
        }

        function eliminarMisa(id) {
            if (confirm("¿Seguro que deseas eliminar esta misa?")) {
                $.post("/Misas/DeleteConfirmed", { id: id }, function (res) {
                    if (res.success) {
                        cargarMisas();
                        mostrarMsgMisa("Misa eliminada.", true);
                    } else {
                        mostrarMsgMisa("No se pudo eliminar.", false);
                    }
                });
            }
        }

        function limpiarFormularioMisa() {
            $("#id").val(0);
            $("#nombre").val("");
            $("#hora_inicio").val("");
            $("#hora_fin").val("");
            $("#dia_semana").val("");
            $("#iglesia_id").val("");
            $("#sacerdote_id").val("");
            $("#descripcion").val("");
            $("#estado").val("ACTIVO");
        }

        function mostrarMsgMisa(msg, exito) {
            $("#msgMisa").text(msg).removeClass().addClass(exito ? "text-success" : "text-danger");
            setTimeout(() => { $("#msgMisa").text(""); }, 3000);
        }
    </script>
}