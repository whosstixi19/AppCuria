
@{
    ViewData["Title"] = "Certificados de Primera Comunión";
    ViewData["ActiveSubmenu"] = "PrimeraComunion";
    Layout = "_Layout";
}

<partial name="_SubmenuCertificados" />

<div class="mb-3 text-center">
    <h1 class="h3 mb-0 text-primary fw-bold">Certificados de Primera Comunión</h1>
</div>

<div class="card shadow-sm">
    <div class="card-body p-3">
        <form id="buscar-alumno">
            <h5 class="card-title text-primary fw-bold mb-3">
                <i class="fas fa-bread-slice me-1 text-warning"></i> Búsqueda de Certificados de Primera Comunión
            </h5>
            <input type="hidden" id="alumnoId" name="alumnoid">

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <button type="button" id="btnImprimirPrimeraComunion" class="btn btn-primary btn-sm">
                    <i class="fas fa-print me-1"></i> Imprimir Primera Comunión
                </button>
            </div>

            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                <input type="text" class="form-control form-control-sm" style="max-width: 350px;" id="nombrecompleto" name="nombrecompleto" placeholder="Escribe un nombre...">

                <button type="button" class="btn btn-primary btn-sm text-nowrap" onclick="buscarPrimeraComunion()">
                    <i class="fas fa-search me-1"></i> Buscar
                </button>

                <button type="button" class="btn btn-secondary btn-sm text-nowrap" onclick="limpiarBusqueda()">
                    Limpiar
                </button>

                <div class="form-check form-switch ms-3">
                    <input type="checkbox" class="form-check-input" id="toggleLista" onchange="toggleListaCompleta()">
                    <label class="form-check-label small ms-1" for="toggleLista">
                        Mostrar todos
                    </label>
                </div>
            </div>

            <h5 class="card-title text-primary fw-bold mb-2 small text-uppercase">
                <i class="fas fa-list me-1 text-primary"></i> Resultados de la búsqueda
            </h5>

            <div class="table-responsive">
                <table class="table table-bordered table-hover table-sm text-center align-middle mb-0" style="font-size: 0.86rem; width: 100%;">
                    <thead class="thead-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Cédula</th>
                            <th>Teléfono</th>
                            <th>Fecha Nacimiento</th>
                            <th>Parroquia</th>
                            <th>Seleccionar</th>
                        </tr>
                    </thead>
                    <tbody id="resultados">
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var alumno in Model)
                            {
                                <tr>
                                    <td>
                                        @if (alumno.foto != null && alumno.foto.Length > 0)
                                        {
                                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(alumno.foto)" alt="Foto de @alumno.nombre" width="60" height="60" class="rounded" />
                                        }
                                        else
                                        {
                                            <span>Sin foto</span>
                                        }
                                    </td>
                                    <td>@alumno.nombre</td>
                                    <td>@alumno.apellido</td>
                                    <td>@alumno.cedula</td>
                                    <td>@alumno.parroquia</td>
                                    <td>@alumno.telefono</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7">No se encontraron resultados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.getElementById('btnImprimirPrimeraComunion').addEventListener('click', function () {
        const alumnoId = document.getElementById('alumnoId').value;

        if (!alumnoId) {
            Swal.fire({
                icon: 'warning',
                title: '¡Atención!',
                text: 'Por favor selecciona un alumno antes de imprimir.',
            });
            return;
        }

        // Preguntar si quiere guardar el PDF
        Swal.fire({
            title: '¿Deseas guardar una copia del certificado en PDF?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, imprimir y guardar',
            cancelButtonText: 'Solo imprimir',
        }).then((result) => {
            Swal.fire({
                title: 'Enviando certificado...',
                text: 'Por favor espera mientras se envía a la impresora.',
                didOpen: () => {
                    Swal.showLoading();
                },
                allowOutsideClick: false
            });

            // Llamar al endpoint con el parámetro guardar
            fetch(`/Certificados/ImprimirPrimeraComunion?alumnoid=${alumnoId}&guardar=${result.isConfirmed}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '¡Impresión iniciada!',
                            text: data.message,
                            timer: 3000,
                            showConfirmButton: false
                        });

                        // Descargar el PDF si el usuario quiere guardar
                        if (result.isConfirmed && data.file) {
                            window.location.href = `/Certificados/DescargarPdf?fileName=${data.file}`;
                        }
                    } else {
                        throw new Error(data.message);
                    }
                })
                .catch(error => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error.message,
                    });
                });
        });
    });


    function seleccionarAlumno(element) {
        const alumnoId = element.getAttribute('data-id');
        document.getElementById('alumnoId').value = alumnoId;

        document.querySelectorAll('.btn-seleccionar').forEach(btn => {
            btn.classList.remove('btn-dark');
            btn.classList.add('btn-success');
            btn.textContent = "Seleccionar";
            btn.disabled = false;
        });

        element.classList.remove('btn-success');
        element.classList.add('btn-dark');
        element.textContent = "Seleccionado";
        element.disabled = true;
    }

    function listarTodos() {
        fetch('/Certificados/SearchPrimeraComunion')
            .then(response => response.json())
            .then(data => renderResultados(data))
            .catch(error => console.error('Error en la búsqueda:', error));
    }

    function toggleListaCompleta() {
        const toggle = document.getElementById('toggleLista');
        if (toggle.checked) {
            listarTodos();
        } else {
            limpiarBusqueda();
        }
    }

    function buscarPrimeraComunion() {
        const nombre = document.getElementById('nombrecompleto').value.trim();
        const resultadosBody = document.getElementById('resultados');

        if (nombre.length === 0) {
            listarTodos();
            return;
        }

        fetch(`/Certificados/SearchPrimeraComunion?nombre=${encodeURIComponent(nombre)}`)
            .then(response => response.json())
            .then(data => renderResultados(data))
            .catch(error => {
                resultadosBody.innerHTML = `<tr><td colspan="7">Error al buscar resultados.</td></tr>`;
                console.error('Error:', error);
            });
    }

    function limpiarBusqueda() {
        document.getElementById('nombrecompleto').value = '';
        const toggle = document.getElementById('toggleLista');
        if (toggle) toggle.checked = true;
        listarTodos();
    }

    function renderResultados(data) {
        const resultadosBody = document.getElementById('resultados');
        resultadosBody.innerHTML = "";

        if (data.length > 0) {
            data.forEach(item => {
                const row = `
                    <tr>
                        <td>${item.nombre}</td>
                        <td>${item.apellido}</td>
                        <td>${item.cedula}</td>
                        <td>${item.telefono}</td>
                        <td>${new Date(item.fechanacimiento).toLocaleDateString('es-EC')}</td>
                        <td>${item.parroquia || "Sin asignar"}</td>
                        <td>
                            <a class="btn btn-success btn-seleccionar" data-id="${item.id}" 
                            onclick="seleccionarAlumno(this)">Seleccionar</a>
                        </td>
                    </tr>`;
                resultadosBody.innerHTML += row;
            });
        } else {
            resultadosBody.innerHTML = "<tr><td colspan='7'>No se encontraron resultados.</td></tr>";
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        const toggle = document.getElementById('toggleLista');
        if (toggle) toggle.checked = true;
        listarTodos();
    });

</script>