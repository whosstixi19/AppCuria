
@{
    ViewData["Title"] = "Certificados de Dispensas";
    ViewData["ActiveSubmenu"] = "Dispensas";
    Layout = "_Layout";
}

<partial name="_SubmenuCertificados" />

<div class="mb-3 text-center">
    <h1 class="h3 mb-0 text-primary fw-bold">Certificados de Dispensas</h1>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form id="formSolteria" method="post" asp-controller="Certificados" asp-action="ImprimirCertificadoSolteria" autocomplete="off">
                    <h5 class="card-title text-primary fw-bold mb-3">
                        <i class="fas fa-file-contract me-1 text-primary"></i> Certificado de Soltería / Dispensas
                    </h5>

                    <!-- DATOS DEL NOVIO/A -->
                    <div class="border rounded p-3 mb-3 bg-light">
                        <h6 class="fw-bold text-secondary mb-2 small"><i class="fas fa-user-friends me-1 text-primary"></i> Datos de los Contrayentes</h6>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label class="form-label mb-1 fw-semibold small">Nombres y Apellidos del Novio/a</label>
                                <input type="text" name="nombreNovio" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label mb-1 fw-semibold small">Cédula del Novio/a</label>
                                <input type="text" name="cedulaNovio" class="form-control form-control-sm" required />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label class="form-label mb-1 fw-semibold small">Domicilio</label>
                                <input type="text" name="domicilioNovio" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label mb-1 fw-semibold small">Nombres y Apellidos de la Pareja</label>
                                <input type="text" name="nombrePareja" class="form-control form-control-sm" required />
                            </div>
                        </div>
                    </div>

                    <!-- DATOS DE LOS TESTIGOS -->
                    <div class="border rounded p-3 mb-3 bg-light">
                        <h6 class="fw-bold text-secondary mb-2 small"><i class="fas fa-users me-1 text-primary"></i> Testigos</h6>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label class="form-label mb-1 fw-semibold small">Testigo 1</label>
                                <input type="text" name="testigo1" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label mb-1 fw-semibold small">Cédula Testigo 1</label>
                                <input type="text" name="cedula1" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label class="form-label mb-1 fw-semibold small">Dirección Testigo 1</label>
                                <input type="text" name="direccion1" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label mb-1 fw-semibold small">Teléfono Testigo 1</label>
                                <input type="text" name="telefono1" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <hr class="my-2 text-muted" />
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label class="form-label mb-1 fw-semibold small">Testigo 2</label>
                                <input type="text" name="testigo2" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label mb-1 fw-semibold small">Cédula Testigo 2</label>
                                <input type="text" name="cedula2" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label class="form-label mb-1 fw-semibold small">Dirección Testigo 2</label>
                                <input type="text" name="direccion2" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label mb-1 fw-semibold small">Teléfono Testigo 2</label>
                                <input type="text" name="telefono2" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>

                    <!-- SELECTS & OBSERVACIÓN -->
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label class="form-label mb-1 fw-semibold small">Seleccionar Feligreses de:</label>
                            <select class="form-select form-select-sm" id="Parroquia" name="parroquia">
                                <option value="">Seleccione Feligreses de:</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label mb-1 fw-semibold small">Seleccione Impedimento</label>
                            <select class="form-select form-select-sm" id="Impedimento" name="impedimento" required>
                                <option value="">Seleccione Impedimento</option>
                                <option value="SI">SI</option>
                                <option value="NO">NO</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label mb-1 fw-semibold small">Observación</label>
                        <textarea class="form-control form-control-sm" name="observacion" rows="2"></textarea>
                    </div>

                    <input type="hidden" name="fecha" value="@DateTime.Now.ToString("yyyy-MM-dd")" />

                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" id="btnImprimirSolteria" class="btn btn-primary btn-sm px-4">
                            <i class="fas fa-print me-1"></i> Imprimir Certificado
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function cargarParroquias() {
        fetch('/ActaBautismo/GetParroquias')
            .then(response => response.json())
            .then(data => {
                console.log('Parroquias recibidas:', data); // Para depurar
                let select = document.getElementById('Parroquia'); // CORREGIDO
                select.innerHTML = '<option value="">Seleccione Feligreses de:</option>'; 

                data.forEach(parroquia => {
                    select.innerHTML += `<option value="${parroquia.id}">${parroquia.nombre}</option>`;
                });
            })
            .catch(error => console.error('Error al cargar parroquias:', error));
    }

    document.addEventListener("DOMContentLoaded", function () {
        cargarParroquias();
    });
    document.getElementById('btnImprimirSolteria').addEventListener('click', function () {
        const formData = new FormData(document.getElementById('formSolteria'));
        const params = new URLSearchParams(formData).toString();

        Swal.fire({
            title: '¿Deseas guardar una copia del certificado en PDF?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, imprimir y guardar',
            cancelButtonText: 'Solo imprimir',
        }).then((result) => {
            Swal.fire({
                title: 'Enviando certificado...',
                text: 'Por favor espera mientras se envía a la impresora.',
                didOpen: () => {
                    Swal.showLoading();
                },
                allowOutsideClick: false
            });

            fetch(`/Certificados/ImprimirCertificadoSolteria?${params}&guardar=${result.isConfirmed}`, { method: 'GET' })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '¡Impresión iniciada!',
                            text: data.message,
                            timer: 3000,
                            showConfirmButton: false
                        });

                        if (result.isConfirmed && data.file) {
                            window.location.href = `/Certificados/DescargarPdf?fileName=${data.file}`;
                        }
                    } else {
                        throw new Error(data.message);
                    }
                })
                .catch(error => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error.message,
                    });
                });
        });
    });
</script>
