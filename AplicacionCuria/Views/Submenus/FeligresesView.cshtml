@{
    ViewData["Title"] = "Gestión de Feligreses";
    ViewData["ActiveMenu"] = "Feligreses";
    Layout = "_Layout";
}

<partial name="_SubmenuRegistrar" />

<div class="container-fluid px-2">
    <h2 class="text-center mb-4">Gestión de Feligreses</h2>

    <div class="row justify-content-center align-items-start g-3">
        <!-- Formulario compacto a la izquierda -->
        <div class="col-lg-4 col-md-5">
            <div class="card shadow-sm">
                <div class="card-body p-3">
                    <form id="formFeligres" autocomplete="off">
                        <input type="hidden" id="id" name="id" value="0" />
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="nombre" class="form-label mb-1 fw-semibold">Nombre <span class="text-danger">*</span></label>
                                <input class="form-control form-control-sm" id="nombre" name="nombre" required maxlength="255" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="apellido" class="form-label mb-1 fw-semibold">Apellido <span class="text-danger">*</span></label>
                                <input class="form-control form-control-sm" id="apellido" name="apellido" required maxlength="255" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="cedula" class="form-label mb-1 fw-semibold">Cédula <span class="text-danger">*</span></label>
                                <input class="form-control form-control-sm" id="cedula" name="cedula" required maxlength="20" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="fechanacimiento" class="form-label mb-1 fw-semibold">Fecha de nacimiento <span class="text-danger">*</span></label>
                                <input type="date" class="form-control form-control-sm" id="fechanacimiento" name="fechanacimiento" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="direccion" class="form-label mb-1 fw-semibold">Dirección (domicilio) <span class="text-danger">*</span></label>
                                <input class="form-control form-control-sm" id="direccion" name="direccion" required maxlength="255" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="telefono" class="form-label mb-1 fw-semibold">Teléfono</label>
                                <input class="form-control form-control-sm" id="telefono" name="telefono" maxlength="20" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-7 mb-2">
                                <label for="email" class="form-label mb-1 fw-semibold">Correo electrónico <span class="text-danger">*</span></label>
                                <input type="email" class="form-control form-control-sm" id="email" name="email" required maxlength="255" />
                            </div>
                            <div class="col-md-5 mb-2">
                                <label for="estado" class="form-label mb-1 fw-semibold">Estado <span class="text-danger">*</span></label>
                                <select class="form-control form-control-sm" id="estado" name="estado" required>
                                    <option value="ACTIVO">ACTIVO</option>
                                    <option value="INACTIVO">INACTIVO</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="observaciones" class="form-label mb-1 fw-semibold">Observaciones</label>
                            <textarea class="form-control form-control-sm" id="observaciones" name="observaciones" rows="2">Sin Observaciones</textarea>
                        </div>

                        <div class="d-flex justify-content-center gap-2">
                            <button type="submit" id="btnGuardarFeligres" class="btn btn-primary btn-sm px-4 mr-2">Registrar</button>
                            <button type="button" class="btn btn-secondary btn-sm px-4" id="btnNuevo">Limpiar</button>
                        </div>
                    </form>
                    <div id="msgFeligres" class="mt-2 text-center fw-semibold"></div>
                </div>
            </div>
        </div>

        <!-- Tabla a la derecha -->
        <div class="col-lg-8 col-md-7">
            <div class="card shadow-sm">
                <div class="card-body p-3">
                    <div class="mb-3 d-flex">
                        <input type="text" id="busquedaFeligres" class="form-control form-control-sm me-2 mr-2" placeholder="Buscar por nombre o cédula..." />
                        <button type="button" class="btn btn-primary btn-sm me-2 mr-2 text-nowrap" id="btnBuscarFeligres">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm text-nowrap" id="btnLimpiarFeligres">
                            Limpiar
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-sm text-center align-middle mb-0" style="font-size: 0.86rem; width: 100%;">
                            <thead class="thead-light">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Apellido</th>
                                    <th>Cédula</th>
                                    <th>F. Nacimiento</th>
                                    <th>Dirección</th>
                                    <th>Teléfono</th>
                                    <th>Email</th>
                                    <th>Estado</th>
                                    <th>Observaciones</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tablaFeligreses">
                                <!-- Llenado por JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let feligresesCache = [];

        document.addEventListener("DOMContentLoaded", function () {
            cargarUltimosFeligreses();

            document.getElementById("btnBuscarFeligres").addEventListener("click", buscarFeligreses);
            document.getElementById("busquedaFeligres").addEventListener("keydown", function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();
                    buscarFeligreses();
                }
            });

            document.getElementById("btnLimpiarFeligres").addEventListener("click", function () {
                document.getElementById("busquedaFeligres").value = "";
                cargarUltimosFeligreses();
            });

            document.getElementById("btnNuevo").addEventListener("click", function () {
                limpiarFormulario();
            });

            const observaciones = document.getElementById('observaciones');
            observaciones.addEventListener('focus', function () {
                if (this.value === 'Sin Observaciones') {
                    this.value = '';
                }
            });
            observaciones.addEventListener('blur', function () {
                if (this.value.trim() === '') {
                    this.value = 'Sin Observaciones';
                }
            });

            // Guardar o Actualizar feligrés
            document.getElementById("formFeligres").addEventListener("submit", function(e) {
                e.preventDefault();
                const obs = document.getElementById("observaciones");
                if (obs.value.trim() === "") obs.value = "Sin Observaciones";

                if (!validarCampos()) {
                    mostrarMsg("Por favor, llena los campos obligatorios.", false);
                    return;
                }

                const id = parseInt(document.getElementById("id").value) || 0;
                const feligres = {
                    id: id,
                    nombre: document.getElementById("nombre").value.trim(),
                    apellido: document.getElementById("apellido").value.trim(),
                    cedula: document.getElementById("cedula").value.trim(),
                    fechanacimiento: document.getElementById("fechanacimiento").value,
                    direccion: document.getElementById("direccion").value.trim(),
                    telefono: document.getElementById("telefono").value.trim(),
                    email: document.getElementById("email").value.trim(),
                    estado: document.getElementById("estado").value,
                    observaciones: document.getElementById("observaciones").value.trim()
                };

                const url = id > 0 ? `/Feligres/Edit?id=${id}` : "/Feligres/Create";

                fetch(url, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(feligres)
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        cargarUltimosFeligreses();
                        limpiarFormulario();
                        mostrarMsg(id > 0 ? "Feligrés actualizado con éxito." : "Feligrés creado con éxito.", true);
                    } else {
                        mostrarMsg(data.message || "Error al procesar la solicitud.", false);
                    }
                })
                .catch(err => {
                    mostrarMsg("Error de conexión: " + err.message, false);
                });
            });
        });

        function cargarUltimosFeligreses() {
            fetch("/Feligres/GetLastFull?count=10")
                .then(res => res.json())
                .then(data => {
                    feligresesCache = data || [];
                    renderTablaFeligreses(feligresesCache);
                });
        }

        function buscarFeligreses() {
            const nombre = document.getElementById("busquedaFeligres").value.trim();
            if (!nombre) {
                cargarUltimosFeligreses();
                return;
            }
            fetch(`/Feligres/SearchByName?nombre=${encodeURIComponent(nombre)}`)
                .then(res => res.json())
                .then(data => {
                    feligresesCache = data || [];
                    renderTablaFeligreses(feligresesCache);
                });
        }

        function renderTablaFeligreses(data) {
            const tbody = document.getElementById("tablaFeligreses");
            tbody.innerHTML = "";
            if (!data || data.length === 0) {
                tbody.innerHTML = "<tr><td colspan='10'>No se encontraron resultados.</td></tr>";
                return;
            }
            data.forEach(f => {
                tbody.innerHTML += `<tr>
                    <td>${f.nombre ?? ""}</td>
                    <td>${f.apellido ?? ""}</td>
                    <td>${f.cedula ?? ""}</td>
                    <td>${f.fechanacimiento ? new Date(f.fechanacimiento).toLocaleDateString('es-EC') : ""}</td>
                    <td>${f.direccion ?? ""}</td>
                    <td>${f.telefono ?? ""}</td>
                    <td>${f.email ?? ""}</td>
                    <td>${f.estado ?? ""}</td>
                    <td>${f.observaciones ?? ""}</td>
                    <td class="text-nowrap">
                        <button class="btn btn-warning btn-sm py-0 px-2 me-1" onclick="editarFeligres(${f.id})">Editar</button>
                        <button class="btn btn-danger btn-sm py-0 px-2" onclick="eliminarFeligres(${f.id})">Eliminar</button>
                    </td>
                </tr>`;
            });
        }

        function editarFeligres(id) {
            let f = feligresesCache.find(x => x.id === id);
            if (f) {
                cargarEnFormulario(f);
            } else {
                fetch(`/Feligres/GetFeligreses`)
                    .then(res => res.json())
                    .then(data => {
                        feligresesCache = data || [];
                        const found = feligresesCache.find(x => x.id === id);
                        if (found) cargarEnFormulario(found);
                    });
            }
        }

        function cargarEnFormulario(f) {
            document.getElementById("id").value = f.id;
            document.getElementById("nombre").value = f.nombre ?? "";
            document.getElementById("apellido").value = f.apellido ?? "";
            document.getElementById("cedula").value = f.cedula ?? "";
            document.getElementById("fechanacimiento").value = f.fechanacimiento ? f.fechanacimiento.split('T')[0] : "";
            document.getElementById("direccion").value = f.direccion ?? "";
            document.getElementById("telefono").value = f.telefono ?? "";
            document.getElementById("email").value = f.email ?? "";
            document.getElementById("estado").value = f.estado ?? "ACTIVO";
            document.getElementById("observaciones").value = f.observaciones ?? "Sin Observaciones";

            const btn = document.getElementById("btnGuardarFeligres");
            btn.textContent = "Actualizar";
            btn.className = "btn btn-warning btn-sm px-4 mr-2";
            document.getElementById("btnNuevo").textContent = "Cancelar";

            document.getElementById("formFeligres").scrollIntoView({ behavior: 'smooth' });
        }

        function eliminarFeligres(id) {
            if (confirm("¿Seguro que deseas eliminar este feligrés?")) {
                fetch("/Feligres/DeleteConfirmed", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ id: id })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        cargarUltimosFeligreses();
                        limpiarFormulario();
                        mostrarMsg("Feligrés eliminado.", true);
                    } else {
                        mostrarMsg("No se pudo eliminar.", false);
                    }
                });
            }
        }

        function limpiarFormulario() {
            document.getElementById("id").value = 0;
            document.getElementById("nombre").value = "";
            document.getElementById("apellido").value = "";
            document.getElementById("cedula").value = "";
            document.getElementById("fechanacimiento").value = "";
            document.getElementById("direccion").value = "";
            document.getElementById("telefono").value = "";
            document.getElementById("email").value = "";
            document.getElementById("estado").value = "ACTIVO";
            document.getElementById("observaciones").value = "Sin Observaciones";

            const btn = document.getElementById("btnGuardarFeligres");
            btn.textContent = "Registrar";
            btn.className = "btn btn-primary btn-sm px-4 mr-2";
            document.getElementById("btnNuevo").textContent = "Limpiar";
        }

        function mostrarMsg(msg, exito) {
            const msgDiv = document.getElementById("msgFeligres");
            msgDiv.textContent = msg;
            msgDiv.className = exito ? "text-success" : "text-danger";
            setTimeout(() => { msgDiv.textContent = ""; }, 4000);
        }

        function validarCampos() {
            const nombre = document.getElementById("nombre").value.trim();
            const apellido = document.getElementById("apellido").value.trim();
            const cedula = document.getElementById("cedula").value.trim();
            const fechanacimiento = document.getElementById("fechanacimiento").value.trim();
            const direccion = document.getElementById("direccion").value.trim();
            const email = document.getElementById("email").value.trim();
            const estado = document.getElementById("estado").value.trim();

            return (
                nombre &&
                apellido &&
                cedula &&
                fechanacimiento &&
                direccion &&
                email &&
                estado
            );
        }
    </script>   
}
