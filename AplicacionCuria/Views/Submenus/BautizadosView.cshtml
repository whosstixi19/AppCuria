                }

                data.forEach(cursillo => {
                    const fila = `<tr>
                        <td>${cursillo.nombrecompletonino}</td>
                        <td>${new Date(cursillo.fechacursillo).toLocaleDateString()}</td>
                        <td><button type="button" class="btn btn-success" onclick="seleccionarCursillo(${cursillo.id}, '${cursillo.nombrecompletonino}')">Seleccionar</button></td>
                    </tr>`;
                    tablaBody.innerHTML += fila;
                });
            })
            .catch(err => {
                console.error('Error buscando cursillos:', err);
                tablaBody.innerHTML = `<tr><td colspan="3" class="text-danger">Error al buscar cursillos.</td></tr>`;
            });
