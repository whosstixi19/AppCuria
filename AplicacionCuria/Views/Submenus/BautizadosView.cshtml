    function seleccionarCursillo(id, nombre) {
        document.getElementById('CursilloId').value = id;

        // Petición para obtener los datos completos del cursillo
        fetch(`/CursilloPrebautismal/GetCursillo?id=${id}`)
            .then(response => response.json())
            .then(data => {
                if (data.success && data.cursillo) {
                    // Rellena los campos del formulario de Acta de Bautismo
                    document.getElementById('NombreCompleto').value = data.cursillo.nombrecompletonino || '';
                    document.getElementById('cedulapadre').value = data.cursillo.nombrepadre || '';
                    document.getElementById('cedulamadre').value = data.cursillo.nombremadre || '';
                    document.getElementById('cedulapadrino1').value = data.cursillo.nombrepadrino || '';
                    document.getElementById('cedulapadrino2').value = data.cursillo.nombremadrina || '';
                    // Si tienes más campos, agrégalos aquí
                } else {
                    alert('No se pudo obtener la información del cursillo.');
                }
            })
            .catch(error => {
                console.error('Error al obtener cursillo:', error);
                alert('Error al obtener la información del cursillo.');
            });

        alert(`Cursillo seleccionado: ${nombre}`);
    }

