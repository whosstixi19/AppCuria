
@{
    ViewData["Title"] = "Registro de Bautizo";
    ViewData["ActiveSubmenu"] = "Bautizados";
    Layout = "_Layout";
}

<partial name="_SubmenuSacramentos" />

<div class="mb-3 text-center">
    <h1 class="h3 mb-0 text-primary fw-bold">Gestión de Bautizos</h1>
</div>

<!-- Sistema de pestañas -->
<ul class="nav nav-tabs justify-content-center" id="formTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="cursillo-tab" data-bs-toggle="tab" data-bs-target="#cursillo" type="button" role="tab" aria-controls="cursillo" aria-selected="false" >
            Cursillo Prebautismal
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="acta-tab" data-bs-toggle="tab" data-bs-target="#acta" type="button" role="tab" aria-controls="acta" aria-selected="false" >
            Acta de Bautismo
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="antiguos-tab" data-bs-toggle="tab" data-bs-target="#antiguos" type="button" role="tab" aria-controls="antiguos" aria-selected="false" >
            Antiguos
        </button>
    </li>
</ul>

<div class="tab-content mt-3" id="formTabsContent">
    <!-- Cursillo Prebautismal Form -->
    <div class="tab-pane fade show active" id="cursillo" role="tabpanel" aria-labelledby="cursillo-tab">
        <div class="row justify-content-center align-items-start g-3">
            <!-- Formulario de creación a la izquierda -->
            <div class="col-lg-5 col-md-5">
                <div class="card shadow-sm">
                    <div class="card-body p-3">
                        <form asp-controller="CursilloPrebautismal" asp-action="Create" method="post" id="formularioCursillo" autocomplete="off">
                            <h5 class="card-title text-primary fw-bold mb-3">
                                <i class="fas fa-water me-1 text-primary"></i> Formulario de Cursillos Prebautismales
                            </h5>

                            <!-- Nombre del niño/niña -->
                            <div class="mb-2">
                                <label for="nombrecompletonino" class="form-label mb-1 fw-semibold small">Nombre completo del niño/niña</label>
                                <input type="text" class="form-control form-control-sm" id="nombrecompletonino" name="nombrecompletonino" required>
                            </div>

                            <!-- Nombre de los padres -->
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="padre_nombre" class="form-label mb-1 fw-semibold small">Padre</label>
                                    <input class="form-control form-control-sm" list="padres_datalist" id="padre_nombre" placeholder="Buscar padre..." autocomplete="off" required>
                                    <datalist id="padres_datalist"></datalist>
                                    <input type="hidden" id="padre_id" name="nombrepadre">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="madre_nombre" class="form-label mb-1 fw-semibold small">Madre</label>
                                    <input class="form-control form-control-sm" list="madres_datalist" id="madre_nombre" placeholder="Buscar madre..." autocomplete="off" required>
                                    <datalist id="madres_datalist"></datalist>
                                    <input type="hidden" id="madre_id" name="nombremadre">
                                </div>
                            </div>

                            <!-- Nombres de los padrinos -->
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="padrino_nombre" class="form-label mb-1 fw-semibold small">Padrino</label>
                                    <input class="form-control form-control-sm" list="padrinos_datalist" id="padrino_nombre" placeholder="Buscar padrino..." autocomplete="off" required>
                                    <datalist id="padrinos_datalist"></datalist>
                                    <input type="hidden" id="padrino_id" name="nombrepadrino">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="madrina_nombre" class="form-label mb-1 fw-semibold small">Madrina</label>
                                    <input class="form-control form-control-sm" list="madrinas_datalist" id="madrina_nombre" placeholder="Buscar madrina..." autocomplete="off" required>
                                    <datalist id="madrinas_datalist"></datalist>
                                    <input type="hidden" id="madrina_id" name="nombremadrina">
                                </div>
                            </div>

                            <!-- Información de contacto -->
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="telefono" class="form-label mb-1 fw-semibold small">Teléfono</label>
                                    <input type="text" class="form-control form-control-sm" id="telefono" name="telefono" required>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="celular" class="form-label mb-1 fw-semibold small">Celular</label>
                                    <input type="text" class="form-control form-control-sm" id="celular" name="celular" required>
                                </div>
                            </div>

                            <!-- Fecha del bautizo y cursillo -->
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="fechabautizo" class="form-label mb-1 fw-semibold small">Fecha de Bautizo</label>
                                    <input type="date" class="form-control form-control-sm" id="fechabautizo" name="fechabautizo" required>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="fechacursillo" class="form-label mb-1 fw-semibold small">Fecha de Cursillo</label>
                                    <input type="date" class="form-control form-control-sm" id="fechacursillo" name="fechacursillo" required>
                                </div>
                            </div>

                            <!-- Quien inscribe -->
                            <div class="mb-2">
                                <label for="quieninscribe_nombre" class="form-label mb-1 fw-semibold small">Quien inscribe</label>
                                <input class="form-control form-control-sm" list="quieninscribe_datalist" id="quieninscribe_nombre" placeholder="Buscar y seleccionar..." autocomplete="off" required>
                                <datalist id="quieninscribe_datalist"></datalist>
                                <input type="hidden" id="quieninscribe_id" name="quieninscribe">
                            </div>

                            <!-- Estado del cursillo y Parroquia -->
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="estado" class="form-label mb-1 fw-semibold small">Estado del Cursillo</label>
                                    <select class="form-select form-select-sm" id="estado" name="estado" required>
                                        <option value="Cursando">Cursando</option>
                                        <option value="Aprobado">Aprobado</option>
                                        <option value="Retirado">Retirado</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="parroquia" class="form-label mb-1 fw-semibold small">Parroquia</label>
                                    <select class="form-select form-select-sm" id="parroquia" name="parroquia" required>
                                        <option value="">Seleccione</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Observaciones adicionales -->
                            <div class="mb-3">
                                <label for="observaciones" class="form-label mb-1 fw-semibold small">Observaciones adicionales</label>
                                <textarea class="form-control form-control-sm" id="observaciones" name="observaciones" rows="2">Sin Observaciones</textarea>
                            </div>

                            <!-- Botón de registro -->
                            <div class="d-flex justify-content-center gap-2">
                                <button type="submit" class="btn btn-primary btn-sm px-4 mr-2">Registrar</button>
                                <button type="reset" class="btn btn-secondary btn-sm px-4">Limpiar</button>
                            </div>
                            <div id="exito" class="text-success mt-2 text-center fw-semibold small" style="display: none;">Cursillo Registrado</div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Botón feligreses y formulario de búsqueda a la derecha -->
            <div class="col-lg-7 col-md-7">
                <div class="card shadow-sm">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title text-primary fw-bold mb-0">
                                <i class="fas fa-search me-1 text-primary"></i> Búsqueda de Registros
                            </h5>
                            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalFeligres">
                                <i class="fas fa-user-plus me-1"></i> Registrar Feligrés
                            </button>
                        </div>

                        <form asp-action="Search" method="get" id="buscar-cursillo" asp-controller="CursilloPrebautismal" onsubmit="event.preventDefault(); buscarCursillo();">
                            <div class="mb-3 d-flex">
                                <input type="text" class="form-control form-control-sm me-2 mr-2" id="nombrecompleto" name="nombrecompleto" placeholder="Nombre completo del niño/niña...">
                                <button type="button" class="btn btn-primary btn-sm me-2 mr-2 text-nowrap" onclick="buscarCursillo()">
                                    <i class="fas fa-search"></i> Buscar
                                </button>
                                <button type="button" class="btn btn-secondary btn-sm text-nowrap" onclick="limpiarCursillo()">
                                    Limpiar
                                </button>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-bordered table-hover table-sm text-center align-middle mb-0" style="font-size: 0.86rem; width: 100%;">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Nombre Completo</th>
                                            <th>Teléfono</th>
                                            <th>Fecha Cursillo</th>
                                            <th>Estado</th>
                                            <th>Modificar</th>
                                            <th>Eliminar</th>
                                        </tr>
                                    </thead>
                                    <tbody id="resultadosCursillo">
                                    @if (Model != null && Model.Any())
                                    {
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.nombrecompletonino</td>
                                                <td>@item.telefono</td>
                                                <td>@item.fechacursillo.ToString("dd/MM/yyyy")</td>
                                                <td>@item.estado</td>
                                                <td>
                                                    <a asp-action="ModifyCursilloView" asp-controller="CursilloPrebautismal" asp-route-id="@item.id" class="btn btn-warning btn-sm">Actualizar</a>
                                                </td>
                                                <td>
                                                    <a asp-action="DeleteCursilloView" asp-controller="CursilloPrebautismal" asp-route-id="@item.id" class="btn btn-danger btn-sm" id="btnEliminar">Eliminar</a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Modal de registro de feligrés -->
                <div class="modal fade" id="modalFeligres" tabindex="-1" aria-labelledby="modalFeligresLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <form id="formFeligres" class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="modalFeligresLabel">Registrar Feligrés</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-2">
                                    <label for="feligres_nombre" class="form-label mb-1 fw-semibold small">Nombre</label>
                                    <input type="text" class="form-control form-control-sm" id="feligres_nombre" name="nombre" required>
                                </div>
                                <div class="mb-2">
                                    <label for="feligres_apellido" class="form-label mb-1 fw-semibold small">Apellido</label>
                                    <input type="text" class="form-control form-control-sm" id="feligres_apellido" name="apellido" required>
                                </div>
                                <div class="mb-2">
                                    <label for="feligres_cedula" class="form-label mb-1 fw-semibold small">Cédula</label>
                                    <input type="text" class="form-control form-control-sm" id="feligres_cedula" name="cedula" required>
                                </div>
                                <div class="mb-2">
                                    <label for="feligres_fechanacimiento" class="form-label mb-1 fw-semibold small">Fecha de nacimiento</label>
                                    <input type="date" class="form-control form-control-sm" id="feligres_fechanacimiento" name="fechanacimiento" required>
                                </div>
                                <div class="mb-2">
                                    <label for="feligres_direccion" class="form-label mb-1 fw-semibold small">Dirección</label>
                                    <input type="text" class="form-control form-control-sm" id="feligres_direccion" name="direccion" required>
                                </div>
                                <div class="mb-2">
                                    <label for="feligres_telefono" class="form-label mb-1 fw-semibold small">Teléfono</label>
                                    <input type="text" class="form-control form-control-sm" id="feligres_telefono" name="telefono" required>
                                </div>
                                <div class="mb-2">
                                    <label for="feligres_email" class="form-label mb-1 fw-semibold small">Email</label>
                                    <input type="email" class="form-control form-control-sm" id="feligres_email" name="email" required>
                                </div>
                                <div class="mb-2">
                                    <label for="feligres_observaciones" class="form-label mb-1 fw-semibold small">Observaciones</label>
                                    <input type="text" class="form-control form-control-sm" id="feligres_observaciones" name="observaciones" value="Sin Observacion" required>
                                </div>
                                <input type="hidden" name="estado" value="ACTIVO">
                                <div id="feligres_error" class="text-danger small" style="display:none;"></div>
                                <div id="feligres_exito" class="text-success small" style="display:none;"></div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary btn-sm">Registrar</button>
                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Acta de Bautismo Form -->
    <div class="tab-pane fade" id="acta" role="tabpanel" aria-labelledby="acta-tab">
        <div class="row justify-content-center align-items-start g-3">
            <!-- Formulario de creación de Acta a la izquierda -->
            <div class="col-lg-5 col-md-5">
                <div class="card shadow-sm">
                    <div class="card-body p-3">
                        <form asp-action="Create" method="post" id="acta-form" asp-controller="ActaBautismo" autocomplete="off">
                            <h5 class="card-title text-primary fw-bold mb-3">
                                <i class="fas fa-file-alt me-1 text-primary"></i> Formulario de Actas de Bautismo
                            </h5>
                            <input type="hidden" id="CursilloId" name="cursillo_id" value="0"/>

                            <!-- Nombre completo -->
                            <div class="mb-2">
                                <label for="NombreCompleto" class="form-label mb-1 fw-semibold small">Nombre completo</label>
                                <input type="text" class="form-control form-control-sm" id="NombreCompleto" name="nombrecompleto" required>
                            </div>

                            <!-- Lugar de nacimiento -->
                            <div class="mb-2">
                                <label for="LugarNacimiento" class="form-label mb-1 fw-semibold small">Lugar de nacimiento</label>
                                <input type="text" class="form-control form-control-sm" id="LugarNacimiento" name="lugarnacimiento" required>
                            </div>

                            <!-- Cédula y sexo -->
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="Cedula" class="form-label mb-1 fw-semibold small">Cédula</label>
                                    <input type="text" class="form-control form-control-sm" id="Cedula" name="cedula">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="Sexo" class="form-label mb-1 fw-semibold small">Sexo</label>
                                    <select class="form-select form-select-sm" id="Sexo" name="sexo" required>
                                        <option value="Masculino">Masculino</option>
                                        <option value="Femenino">Femenino</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Fechas -->
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="FechaNacimiento" class="form-label mb-1 fw-semibold small">Fecha de nacimiento</label>
                                    <input type="date" class="form-control form-control-sm" id="FechaNacimiento" name="fechanacimiento" required>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="FechaBautizo" class="form-label mb-1 fw-semibold small">Fecha de bautizo</label>
                                    <input type="date" class="form-control form-control-sm" id="FechaBautizo" name="fechabautizo" required>
                                </div>
                            </div>

                            <!-- Información adicional (padres y padrinos) -->
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="cedulapadre" class="form-label mb-1 fw-semibold small">Cédula del padre</label>
                                    <input type="text" class="form-control form-control-sm" id="cedulapadre" name="cedulapadre">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="cedulamadre" class="form-label mb-1 fw-semibold small">Cédula de la madre</label>
                                    <input type="text" class="form-control form-control-sm" id="cedulamadre" name="cedulamadre">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="cedulapadrino1" class="form-label mb-1 fw-semibold small">Cédula Padrino 1</label>
                                    <input type="text" class="form-control form-control-sm" id="cedulapadrino1" name="cedulapadrino1">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="cedulapadrino2" class="form-label mb-1 fw-semibold small">Cédula Padrino 2</label>
                                    <input type="text" class="form-control form-control-sm" id="cedulapadrino2" name="cedulapadrino2">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-2">
                                    <label for="cedulapadrino3" class="form-label mb-1 fw-semibold small">Padrino 3 (opc)</label>
                                    <input type="text" class="form-control form-control-sm" id="cedulapadrino3" name="cedulapadrino3" placeholder="(opcional)">
                                </div>
                                <div class="col-md-4 mb-2">
                                    <label for="cedulapadrino4" class="form-label mb-1 fw-semibold small">Padrino 4 (opc)</label>
                                    <input type="text" class="form-control form-control-sm" id="cedulapadrino4" name="cedulapadrino4" placeholder="(opcional)">
                                </div>
                                <div class="col-md-4 mb-2">
                                    <label for="cedulapadrino5" class="form-label mb-1 fw-semibold small">Padrino 5 (opc)</label>
                                    <input type="text" class="form-control form-control-sm" id="cedulapadrino5" name="cedulapadrino5" placeholder="(opcional)">
                                </div>
                            </div>

                            <!-- Datos del acta eclesiástica -->
                            <div class="row">
                                <div class="col-md-4 mb-2">
                                    <label for="Tomo" class="form-label mb-1 fw-semibold small">Tomo</label>
                                    <input type="text" class="form-control form-control-sm" id="Tomo" name="tomo">
                                </div>
                                <div class="col-md-4 mb-2">
                                    <label for="Pagina" class="form-label mb-1 fw-semibold small">Página</label>
                                    <input type="text" class="form-control form-control-sm" id="Pagina" name="pagina">
                                </div>
                                <div class="col-md-4 mb-2">
                                    <label for="Acta" class="form-label mb-1 fw-semibold small">Acta</label>
                                    <input type="text" class="form-control form-control-sm" id="Acta" name="acta">
                                </div>
                            </div>

                            <!-- Listados desplegables -->
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="Ministro" class="form-label mb-1 fw-semibold small">Ministro</label>
                                    <select class="form-select form-select-sm" id="Ministro" name="ministro_id">
                                        <option value="">Seleccione Ministro</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="Sacerdote" class="form-label mb-1 fw-semibold small">Sacerdote</label>
                                    <select class="form-select form-select-sm" id="Sacerdote" name="sacerdote_id" required>
                                        <option value="">Seleccione Sacerdote</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="Iglesia" class="form-label mb-1 fw-semibold small">Iglesia</label>
                                    <select class="form-select form-select-sm" id="Iglesia" name="iglesia_id">
                                        <option value="">Seleccione Iglesia</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="Parroquia" class="form-label mb-1 fw-semibold small">Parroquia</label>
                                    <select class="form-select form-select-sm" id="Parroquia" name="parroquia_id" required>
                                        <option value="">Seleccione Parroquia</option>
                                    </select>
                                </div>
                            </div> 

                            <!-- Registro Civil -->
                            <div class="border rounded p-2 mb-2 bg-light">
                                <h6 class="fw-bold text-secondary mb-2 small"><i class="fas fa-university me-1"></i> Registro Civil</h6>
                                <div class="row">
                                    <div class="col-md-3 mb-2">
                                        <label for="RegistroCivilAno" class="form-label mb-1 fw-semibold small">Año</label>
                                        <input type="text" class="form-control form-control-sm" id="RegistroCivilAno" name="registrocivilano">
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <label for="RegistroCivilTomo" class="form-label mb-1 fw-semibold small">Tomo</label>
                                        <input type="text" class="form-control form-control-sm" id="RegistroCivilTomo" name="registrociviltomo">
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <label for="RegistroCivilFolio" class="form-label mb-1 fw-semibold small">Folio</label>
                                        <input type="text" class="form-control form-control-sm" id="RegistroCivilFolio" name="registrocivilfolio">
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <label for="RegistroCivilActa" class="form-label mb-1 fw-semibold small">Acta</label>
                                        <input type="text" class="form-control form-control-sm" id="RegistroCivilActa" name="registrocivilacta">
                                    </div>
                                </div>
                                <div class="mb-1">
                                    <label for="RegistroCivilFecha" class="form-label mb-1 fw-semibold small">Fecha de Registro Civil</label>
                                    <input type="date" class="form-control form-control-sm" id="RegistroCivilFecha" name="registrocivilfecha">
                                </div>
                            </div>

                            <!-- Observaciones adicionales -->
                            <div class="mb-3">
                                <label for="Observaciones" class="form-label mb-1 fw-semibold small">Observaciones adicionales</label>
                                <textarea class="form-control form-control-sm" id="Observaciones" name="observaciones" rows="2">Sin Observaciones</textarea>
                            </div>

                            <!-- Botones de acciones -->
                            <div class="d-flex justify-content-center gap-2">
                                <button type="submit" class="btn btn-primary btn-sm px-4 mr-2">Registrar</button>
