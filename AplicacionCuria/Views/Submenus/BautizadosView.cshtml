    function buscarCursilloenActa() {
        const nombre = document.getElementById('buscar-cursillo-input').value.trim();
        const tablaBody = document.getElementById('tabla-cursillos-body');

        if (nombre.length === 0) {
            cargarUltimosCursillosEnActa();
            return;
        }

        fetch(`/ActaBautismo/BuscarCursillosAprobados?nombre=${encodeURIComponent(nombre)}`)
            .then(res => res.json())
            .then(data => {
                tablaBody.innerHTML = "";

                if (data.length === 0) {
                    tablaBody.innerHTML = `<tr><td colspan="3">No se encontraron cursillos aprobados.</td></tr>`;
