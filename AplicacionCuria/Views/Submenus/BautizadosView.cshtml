    function validarUnicosPadresPadrinos() {
        const ids = ['padre_id', 'madre_id', 'padrino_id', 'madrina_id'];
        ids.forEach(id => {
            document.getElementById(id).addEventListener('change', function () {
                const valores = ids.map(i => document.getElementById(i).value).filter(v => v);
                const repetidos = valores.filter((v, i, arr) => arr.indexOf(v) !== i);
                if (repetidos.length > 0) {
                    alert('No puedes seleccionar el mismo feligrés en más de un campo.');
                    this.value = '';
                }
            });
        });
