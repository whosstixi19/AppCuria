    document.getElementById('formFeligres').addEventListener('submit', function(event) {
        event.preventDefault();
        const form = this;
        const formData = new FormData(form);
        document.getElementById('feligres_error').style.display = 'none';
        document.getElementById('feligres_exito').style.display = 'none';

        fetch('/Feligres/Create', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                document.getElementById('feligres_exito').textContent = "Feligres registrado correctamente.";
                document.getElementById('feligres_exito').style.display = 'block';
                form.reset();
                // recargar selects de padres/padrinos
                cargarFeligreses();
                setTimeout(() => {
                    var modal = bootstrap.Modal.getInstance(document.getElementById('modalFeligres'));
                    modal.hide();
                }, 1200);
            } else {
                document.getElementById('feligres_error').textContent = data.message || "Error al registrar feligrés.";
                document.getElementById('feligres_error').style.display = 'block';
            }
        })
        .catch(error => {
            document.getElementById('feligres_error').textContent = "Error al registrar feligrés.";
            document.getElementById('feligres_error').style.display = 'block';
        });
    });

