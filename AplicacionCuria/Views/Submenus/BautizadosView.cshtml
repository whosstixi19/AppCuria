    function cargarPadresDatalist(texto = "") {
        let url = texto.length >= 2
            ? `/Feligres/SearchByName?nombre=${encodeURIComponent(texto)}`
            : '/Feligres/GetLast?count=8';

        fetch(url)
            .then(response => response.json())
            .then(data => {
                const datalist = document.getElementById('padres_datalist');
                datalist.innerHTML = '';
                data.forEach(f => {
                    const nombreCompleto = f.nombre + (f.apellido ? " " + f.apellido : "");
                    // Muestra nombre y cédula en la lista
                    datalist.innerHTML += `<option value="${nombreCompleto}">${nombreCompleto} - ${f.cedula}</option>`;
                });
                // Guarda la lista en memoria para búsqueda rápida
                window._padresFeligreses = data;
            });
    }

    // Al seleccionar un nombre, guarda el id en el input hidden
    document.getElementById('padre_nombre').addEventListener('change', function() {
        const nombre = this.value;
        const lista = window._padresFeligreses || [];
        const encontrado = lista.find(f => (f.nombre + (f.apellido ? " " + f.apellido : "")) === nombre);
        document.getElementById('padre_id').value = encontrado ? encontrado.cedula : '';
    });

