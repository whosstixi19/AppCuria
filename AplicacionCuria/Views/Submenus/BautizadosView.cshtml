    function buscarActa(event) {
        if (event) event.preventDefault(); // Evita el submit tradicional si viene de un formulario

        const nombre = document.getElementById('nombrecompletos').value.trim();
        const resultadosBody = document.getElementById('resultadosBody');
        const errorDiv = document.getElementById('errorNombre');

        if (nombre.length >= 3) {
            errorDiv.style.display = 'none';
            errorDiv.textContent = '';

            fetch(`/ActaBautismo/SearchByName?nombrecompleto=${nombre}`)
                .then(response => response.json())
                .then(data => {
                    resultadosBody.innerHTML = '';

                    if (data.length > 0) {
                        data.forEach(item => {
                            const row = `<tr>
                                <td>${item.nombrecompleto}</td>
                                <td>${new Date(item.fechabautizo).toLocaleDateString()}</td>
                                <td>${item.iglesia}</td>
                                <td><a href="/ActaBautismo/ModifyActaBautismoView/${item.id}" class="btn btn-warning">Actualizar</a></td>
                                <td><a href="/ActaBautismo/DeleteActaBautismoView/${item.id}" class="btn btn-danger">Eliminar</a></td>
                            </tr>`;
                            resultadosBody.innerHTML += row;
                        });
                    } else {
                        resultadosBody.innerHTML = `<tr><td colspan="5">No se encontraron resultados.</td></tr>`;
                    }
                })
                .catch(error => {
                    resultadosBody.innerHTML = `<tr><td colspan="5">Error al buscar resultados.</td></tr>`;
                    console.error('Error:', error);
                });
        } else {
            errorDiv.style.display = 'block';
            errorDiv.textContent = 'Ingresa al menos 3 caracteres para realizar la búsqueda.';
            resultadosBody.innerHTML = '';
        }
    }

