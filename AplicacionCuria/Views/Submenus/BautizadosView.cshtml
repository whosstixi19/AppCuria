
@{
    ViewData["Title"] = "Registro de Bautizo";
    Layout = "_Layout";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="d-flex align-items-center mb-3">
    <a class="btn btn-secondary d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="MenuSacramentos" aria-label="Regresar al menú de sacramentos">
        <i class="fas fa-arrow-left me-1"></i>
        <span>Volver</span>
    </a>
    <h1 class="ms-3">Registro de Bautizos</h1>
</div>

<!-- Sistema de pestañas -->
<ul class="nav nav-tabs" id="formTabs" role="tablist">
    <li class="nav-item" role="presentation">

<!-- Sistema de pestañas -->
<ul class="nav nav-tabs" id="formTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="cursillo-tab" data-bs-toggle="tab" data-bs-target="#cursillo" type="button" role="tab" aria-controls="cursillo" aria-selected="false" >
            Cursillo Prebautismal
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="acta-tab" data-bs-toggle="tab" data-bs-target="#acta" type="button" role="tab" aria-controls="acta" aria-selected="false" >
            Acta de Bautismo
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="antiguos-tab" data-bs-toggle="tab" data-bs-target="#antiguos" type="button" role="tab" aria-controls="antiguos" aria-selected="false" >
            Antiguos
        </button>
    </li>
</ul>

<div class="tab-content mt-3" id="formTabsContent">
    <!-- Cursillo Prebautismal Form -->
    <div class="tab-pane fade show active" id="cursillo" role="tabpanel" aria-labelledby="cursillo-tab">
        <div class="row">
            <h2>Formulario de Cursillos</h2>
            <!-- Formulario de creación a la izquierda -->
            <div class="col-md-6">
                <form asp-controller="CursilloPrebautismal" asp-action="Create" method="post" id="formularioCursillo">
                    <!-- Nombre del niño/niña -->
                    <div class="mb-3">
                        <label for="nombrecompletonino" class="form-label">Nombre completo del niño/niña</label>
                        <input type="text" class="form-control" id="nombrecompletonino" name="nombrecompletonino" required>
                    </div>

                    <!-- Nombre de los padres -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="padre_nombre" class="form-label">Padre</label>
                            <input class="form-control" list="padres_datalist" id="padre_nombre" placeholder="Buscar y seleccionar padre..." autocomplete="off" required>
                            <datalist id="padres_datalist"></datalist>
                            <input type="hidden" id="padre_id" name="nombrepadre">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="madre_nombre" class="form-label">Madre</label>
                            <input class="form-control" list="madres_datalist" id="madre_nombre" placeholder="Buscar y seleccionar madre..." autocomplete="off" required>
                            <datalist id="madres_datalist"></datalist>
                            <input type="hidden" id="madre_id" name="nombremadre">
                        </div>
                    </div>

                    <!-- Nombres de los padrinos -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="padrino_nombre" class="form-label">Padrino</label>
                            <input class="form-control" list="padrinos_datalist" id="padrino_nombre" placeholder="Buscar y seleccionar padrino..." autocomplete="off" required>
                            <datalist id="padrinos_datalist"></datalist>
                            <input type="hidden" id="padrino_id" name="nombrepadrino">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="madrina_nombre" class="form-label">Madrina</label>
                            <input class="form-control" list="madrinas_datalist" id="madrina_nombre" placeholder="Buscar y seleccionar madrina..." autocomplete="off" required>
                            <datalist id="madrinas_datalist"></datalist>
                            <input type="hidden" id="madrina_id" name="nombremadrina">
                        </div>
                    </div>

                    <!-- Información de contacto -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="telefono" class="form-label">Teléfono</label>
                            <input type="text" class="form-control" id="telefono" name="telefono" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="celular" class="form-label">Celular</label>
                            <input type="text" class="form-control" id="celular" name="celular" required>
                        </div>
                    </div>

                    <!-- Fecha del bautizo y cursillo -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="fechabautizo" class="form-label">Fecha de Bautizo</label>
                            <input type="date" class="form-control" id="fechabautizo" name="fechabautizo" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="fechacursillo" class="form-label">Fecha de Cursillo</label>
                            <input type="date" class="form-control" id="fechacursillo" name="fechacursillo" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="quieninscribe_nombre" class="form-label">Quien inscribe</label>
                        <input class="form-control" list="quieninscribe_datalist" id="quieninscribe_nombre" placeholder="Buscar y seleccionar..." autocomplete="off" required>
                        <datalist id="quieninscribe_datalist"></datalist>
                        <input type="hidden" id="quieninscribe_id" name="quieninscribe">
                    </div>

                    <!-- Estado del cursillo -->
                    <div class="mb-3">
                        <label for="estado" class="form-label">Estado del Cursillo</label>
                        <select class="form-select" id="estado" name="estado" required>
                            <option value="Cursando">Cursando</option>
                            <option value="Aprobado">Aprobado</option>
                            <option value="Retirado">Retirado</option>
                        </select>
                    </div>

                    <!-- Parroquia -->
                    <div class="mb-3">
                        <label for="parroquia" class="form-label">Parroquia</label>
                        <select class="form-select" id="parroquia" name="parroquia" required>
                            <option value="">Seleccione</option>
                        </select>
                    </div>

                    <!-- Observaciones adicionales -->
                    <div class="mb-3">
                        <label for="observaciones" class="form-label">Observaciones adicionales</label>
                        <textarea class="form-control" id="observaciones" name="observaciones">Sin Observaciones</textarea>
                    </div>

                    <!-- Botón de registro -->
                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">Registrar</button>
                        <label id="exito" class="text-success" style="display: none;">Cursillo Registrado</label>
                    </div>
                </form>
            </div>

            <!-- Botón feligreses y formulario de búsqueda a la derecha -->
            
                <div class="col-lg-6 col-md-12 mt-4 mt-lg-0">

                    <div class="mb-3">
                        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalFeligres">
                            <i class="fas fa-user-plus"></i> Registrar Feligres
                        </button>
                    </div>

                    <!-- Modal de registro de feligrés -->
                    <div class="modal fade" id="modalFeligres" tabindex="-1" aria-labelledby="modalFeligresLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <form id="formFeligres" class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="modalFeligresLabel">Registrar Feligres</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-2">
                                        <label for="feligres_nombre" class="form-label">Nombre</label>
                                        <input type="text" class="form-control" id="feligres_nombre" name="nombre" required>
                                    </div>
                                    <div class="mb-2">
                                        <label for="feligres_apellido" class="form-label">Apellido</label>
                                        <input type="text" class="form-control" id="feligres_apellido" name="apellido" required>
                                    </div>
                                    <div class="mb-2">
                                        <label for="feligres_cedula" class="form-label">Cédula</label>
                                        <input type="text" class="form-control" id="feligres_cedula" name="cedula" required>
                                     </div>
                                    <div class="mb-2">
                                        <label for="feligres_fechanacimiento" class="form-label">Fecha de nacimiento</label>
                                        <input type="date" class="form-control" id="feligres_fechanacimiento" name="fechanacimiento" required>
                                    </div>
                                    <div class="mb-2">
                                        <label for="feligres_direccion" class="form-label">Dirección</label>
                                        <input type="text" class="form-control" id="feligres_direccion" name="direccion" required>
                                    </div>
                                    <div class="mb-2">
                                        <label for="feligres_telefono" class="form-label">Teléfono</label>
                                        <input type="text" class="form-control" id="feligres_telefono" name="telefono" required>
                                    </div>
                                    <div class="mb-2">
                                        <label for="feligres_email" class="form-label">Email</label>
                                        <input type="email" class="form-control" id="feligres_email" name="email" required>
                                    </div>
                                    <div class="mb-2">
                                        <label for="feligres_observaciones" class="form-label">Observaciones</label>
                                        <input type="text" class="form-control" id="feligres_observaciones" name="observaciones" value="Sin Observacion" required>
                                    </div>
                                    <input type="hidden" name="estado" value="ACTIVO">
                                    <div id="feligres_error" class="text-danger" style="display:none;"></div>
                                    <div id="feligres_exito" class="text-success" style="display:none;"></div>
                                </div>
                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-primary">Registrar</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                </div>
                            </form>
                        </div>
                    </div>

                <h2>Busqueda de Registros</h2>
                <form asp-action="Search" method="get" id="buscar-cursillo" asp-controller="CursilloPrebautismal">
                <div class="mb-3">
                    <label for="nombrecompleto" class="form-label">Nombre completo del niño/niña</label>
                    <div class="d-flex">
                        <input type="text" class="form-control me-2" id="nombrecompleto" name="nombrecompleto" placeholder="Escribe un nombre...">
                        <button type="button" class="btn btn-primary me-2" onclick="buscarCursillo()">Buscar</button>
                        <button type="button" class="btn btn-secondary" onclick="limpiarCursillo()">Limpiar</button>
                    </div>
                </div>
                    @* <div class="mb-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                    </div> *@
                    <div class="mb-3">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Nombre Completo</th>
                                        <th>Teléfono</th>
                                        <th>Fecha de Cursillo</th>
                                        <th>Estado</th>
                                        <th>Modificar</th>
                                        <th>Eliminar</th>
                                    </tr>
                                </thead>
                                <tbody id="resultadosCursillo">
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.nombrecompletonino</td>
                                            <td>@item.telefono</td>
                                            <td>@item.fechacursillo.ToString("dd/MM/yyyy")</td>
                                            <td>@item.estado</td>
                                            <td>
                                                <a asp-action="ModifyCursilloView" asp-controller="CursilloPrebautismal" asp-route-id="@item.id" class="btn btn-warning">Actualizar</a>
                                            </td>
                                            <td>
                                                <a asp-action="DeleteCursilloView" asp-controller="CursilloPrebautismal" asp-route-id="@item.id" class="btn btn-danger" id="btnEliminar">Eliminar</a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                }
                                </tbody>
                            </table>
                        
                    </div>
                </form>
             </div>
        </div>
    </div>

    <!-- Acta de Bautismo Form -->
    <div class="tab-pane fade" id="acta" role="tabpanel" aria-labelledby="acta-tab" >
        <div class="row">
            <!-- Formulario de creación de Acta a la izquierda -->
            <div class="col-md-12 col-lg-6">
                <h2>Formulario de Actas de Bautismo</h2>
                <form asp-action="Create" method="post" id="acta-form" asp-controller="ActaBautismo">
                    <input type="hidden" id="CursilloId" name="cursillo_id" value="0"/>
                    

                    <!-- Nombre completo -->
                    <div class="mb-3">
                        <label for="NombreCompleto" class="form-label">Nombre completo</label>
                        <input type="text" class="form-control" id="NombreCompleto" name="nombrecompleto" required>
                    </div>

                    <!-- Lugar de nacimiento -->
                    <div class="mb-3">
                        <label for="LugarNacimiento" class="form-label">Lugar de nacimiento</label>
                        <input type="text" class="form-control" id="LugarNacimiento" name="lugarnacimiento" required>
                    </div>

                    <!-- Cédula y sexo -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Cedula" class="form-label">Cédula</label>
                            <input type="text" class="form-control" id="Cedula" name="cedula">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="Sexo" class="form-label">Sexo</label>
                            <select class="form-select" id="Sexo" name="sexo" required>
                                <option value="Masculino">Masculino</option>
                                <option value="Femenino">Femenino</option>
                            </select>
                        </div>
                    </div>

                    <!-- Fechas -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="FechaNacimiento" class="form-label">Fecha de nacimiento</label>
                            <input type="date" class="form-control" id="FechaNacimiento" name="fechanacimiento" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="FechaBautizo" class="form-label">Fecha de bautizo</label>
                            <input type="date" class="form-control" id="FechaBautizo" name="fechabautizo" required>
                        </div>
                    </div>

                    <!-- Información adicional (padres y padrinos) -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="cedulapadre" class="form-label">Cedula del padre</label>
                            <input type="text" class="form-control" id="cedulapadre" name="cedulapadre">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="cedulamadre" class="form-label">Cedula de la madre</label>
                            <input type="text" class="form-control" id="cedulamadre" name="cedulamadre">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="cedulapadrino1" class="form-label">Cedula del Padrino 1</label>
                            <input type="text" class="form-control" id="cedulapadrino1" name="cedulapadrino1">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="cedulapadrino2" class="form-label">Cedula del Padrino 2</label>
                            <input type="text" class="form-control" id="cedulapadrino2" name="cedulapadrino2">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="cedulapadrino3" class="form-label">Cedula del Padrino 3</label>
                            <input type="text" class="form-control" id="cedulapadrino3" name="cedulapadrino3" placeholder="(opcional)">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="cedulapadrino4" class="form-label">Cedula del Padrino 4</label>
                            <input type="text" class="form-control" id="cedulapadrino4" name="cedulapadrino4" placeholder="(opcional)">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="cedulapadrino5" class="form-label">Cedula del Padrino 5</label>
                            <input type="text" class="form-control" id="cedulapadrino5" name="cedulapadrino5" placeholder="(opcional)">
                        </div>
                    </div>

                    <!-- Datos del acta -->
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="Tomo" class="form-label">Tomo</label>
                            <input type="text" class="form-control" id="Tomo" name="tomo">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="Pagina" class="form-label">Pagina</label>
                            <input type="text" class="form-control" id="Pagina" name="pagina">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="Acta" class="form-label">Acta</label>
                            <input type="text" class="form-control" id="Acta" name="acta">
                        </div>
                    </div>

                    <!-- Listados desplegables -->
                     <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Ministro" class="form-label">Ministro</label>
                            <select class="form-select" id="Ministro" name="ministro_id">
                                <option value="">Seleccione un Ministro</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="Sacerdote" class="form-label">Sacerdote</label>
                            <select class="form-select" id="Sacerdote" name="sacerdote_id" required>
                                <option value="">Seleccione un Sacerdote</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        @* <div class="col-md-6 mb-3">
                            <label for="Parroquia" class="form-label">Parroquia</label>
                            <select class="form-select" id="Parroquia" name="parroquia">
                                <option value="">Seleccione una Parroquia</option>
                            </select>
                        </div> *@
                        <div class="col-md-6 mb-3">
                            <label for="Iglesia" class="form-label">Iglesia</label>
                            <select class="form-select" id="Iglesia" name="iglesia_id">
                                <option value="">Seleccione una Iglesia</option>
                            </select>
                        </div>
                        @* <div class="col-md-6 mb-3">
                            <label for="Pagina" class="form-label">Página del acta</label>
                            <input type="text" class="form-control" id="Pagina" name="pagina">
                        </div> *@

                        <!-- Información sobre los feligreses -->
                        <div class="col-md-6 mb-3">
                            <label for="Parroquia" class="form-label">Parroquia</label>
                            <select class="form-select" id="Parroquia" name="parroquia_id" required>
                                <option value="">Seleccione una Parroquia</option>
                            </select>
                        </div>
                    </div> 
                    <div class="row registro-civil-container">
                        <h5>Registro Civil</h5>
                        <div class="col-md-3 mb-3">
                            <label for="RegistroCivilAno" class="form-label">Año de Registro Civil</label>
                            <input type="text" class="form-control" id="RegistroCivilAno" name="registrocivilano">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="RegistroCivilTomo" class="form-label">Tomo de Registro Civil</label>
                            <input type="text" class="form-control" id="RegistroCivilTomo" name="registrociviltomo">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="RegistroCivilFolio" class="form-label">Folio de Registro Civil</label>
                            <input type="text" class="form-control" id="RegistroCivilFolio" name="registrocivilfolio">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="RegistroCivilActa" class="form-label">Número de Acta de Registro Civil</label>
                            <input type="text" class="form-control" id="RegistroCivilActa" name="registrocivilacta">
                        </div>
                        <div class="mb-3">
                            <label for="RegistroCivilFecha" class="form-label">Fecha de Registro Civil</label>
                            <input type="date" class="form-control" id="RegistroCivilFecha" name="registrocivilfecha">
                        </div>
                    </div>
                    <style>
                        .registro-civil-container {
                            border: 2px solid #ECA64C; /* Color del borde */
                            border-radius: 10px; /* Bordes redondeados */
                            padding: 15px; /* Espaciado interno */
                            margin-top: 20px; /* Espacio superior */
                            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Sombra suave */
                        }

                            .registro-civil-container .form-label {
                                font-weight: bold; /* Etiquetas en negrita */
                            }

                            .registro-civil-container input {
                                border-radius: 5px; /* Bordes redondeados para los inputs */
                            }

                    </style>
                    

                    <!-- Observaciones adicionales -->
                    <div class="mb-3">
                        <label for="Observaciones" class="form-label">Observaciones adicionales</label>
                        <textarea class="form-control" id="Observaciones" name="observaciones">Sin Observaciones</textarea>
                    </div>

                    <!-- Botones de acciones -->
                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">Registrar</button>
                        <label id="exito2" class="text-success" style="display: none;">Acta Registrada</label>

                    </div>
                </form>
            </div>

            <div class="col-md-12 col-lg-6">
                <h4>Seleccionar Cursillo Prebautismal</h4>
                <input type="text" class="form-control mb-2" id="buscar-cursillo-input" placeholder="Buscar por nombre del niño...">
                <div class="d-flex gap-2 mb-2">
                    <button type="button" class="btn btn-primary" onclick="buscarCursilloenActa()">Buscar</button>
                    <button type="button" class="btn btn-secondary" onclick="limpiarCursilloenActa()">Limpiar</button>
                </div>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Nombre del Niño</th>
                            <th>Fecha Cursillo</th>
                            <th>Seleccionar</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-cursillos-body">
                        <tr><td colspan="3">Sin resultados.</td></tr>
                    </tbody>
                </table>

            <!-- Columna para búsqueda -->
                <form asp-action="Search" method="get" id="buscar-acta" asp-controller="ActaBautismo">
                <h2>Busqueda de Registros</h2>    
                <div class="mb-3">
                    <label for="nombrecompletos" class="form-label">Nombre del niño/niña</label>
                    <input type="text" class="form-control" id="nombrecompletos" name="nombrecompletos" placeholder="Escribe un nombre...">
                    <div id="errorNombre" class="text-danger mt-1" style="display: none;"></div>
                </div>
                <div class="mb-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i> Buscar
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="limpiarBusqueda()">
                        Limpiar
                    </button>
                </div>
                   @*  <div class="mb-3">
                        <button type="submit" class="btn btn-primary" value="cursillo">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                    </div> *@
                    <div class="mb-3">
                        <h3>Resultados de la búsqueda:</h3>
                        <table class="table table-bordered">
                            <thead>
