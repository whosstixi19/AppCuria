    function ListActasBautismo() {
        fetch('/ActaBautismo/ListActasBautismo')
            .then(response => response.json())
            .then(data => {
                const resultadosBody = document.getElementById("resultadosBody");
                if (!resultadosBody) {
                    console.error("Elemento con id 'resultadosBody' no encontrado.");
                    return;
                }
                resultadosBody.innerHTML = ""; // Limpiar resultados anteriores

                if (data.length > 0) {
                    data.forEach(item => {
                        const row = `<tr>
                                        <td>${item.nombrecompleto}</td>
                                        <td>${new Date(item.fechabautizo).toLocaleDateString()}</td> <!-- Formatea la fecha en JavaScript -->
                                        <td>${item.iglesia}</td>
                                        <td><a href="/ActaBautismo/ModifyActaBautismoView/${item.id}" class="btn btn-warning">Actualizar</a></td>
                                        <td><a href="/ActaBautismo/DeleteActaBautismoView/${item.id}" class="btn btn-danger" id="btnEliminar">Eliminar</a></td>
                                    </tr>`;
                        resultadosBody.innerHTML += row; // Agregar cada resultado a la tabla
                    });
                } else {
                    resultadosBody.innerHTML = "<tr><td colspan='6'>No se encontraron resultados.</td></tr>";
                }
            })
            .catch(error => console.error('Error en la búsqueda:', error));
    }

