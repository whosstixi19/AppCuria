<script>
    document.getElementById("formularioCursillo").addEventListener("submit", function (event) {

        event.preventDefault();
        // Validaciones personalizadas antes de enviar
        const estado = document.getElementById('estado').value;
        const observaciones = document.getElementById('observaciones').value.trim();
        const quienInscribe = document.getElementById('quieninscribe_id').value;

        let errores = [];
        if (!quienInscribe) errores.push("El campo 'Quien inscribe' es obligatorio.");
        if (!estado) errores.push("El campo 'Estado del Cursillo' es obligatorio.");

        if (errores.length > 0) {
            const mensajeExito = document.getElementById("exito");
            mensajeExito.className = "text-danger";
            mensajeExito.textContent = errores.join(" ");
            mensajeExito.style.display = "block";
            return;
        }

        var formData = new FormData(this);
        fetch(this.action, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            // Ocultar el label de error al enviar el formulario
            document.getElementById("exito").style.display = "none";

            if (data.success) {
                // Mostrar mensaje de éxito por 4 segundos
                const mensajeExito = document.getElementById("exito");
                mensajeExito.className = "text-success";
                mensajeExito.textContent = "Cursillo Prebautismal Generado con Éxito";
                mensajeExito.style.display = "block";

                // Limpiar formulario
                document.getElementById("formularioCursillo").reset();
                cargarCursillosRecientes();

                // Ocultar mensaje después de 4 segundos
                setTimeout(function () {
                    mensajeExito.style.display = "none";
                }, 4000);

            } else {
                document.getElementById("exito").className = "text-danger";
                if (Array.isArray(data.errors)) {
                    document.getElementById("exito").textContent = data.errors.join(", ");
                } else {
                    document.getElementById("exito").textContent = data.errors || "Error desconocido.";
                }
                document.getElementById("exito").style.display = "block";
            }
        })
        .catch(error => {
            console.error('Error:', error);
            document.getElementById("exito").innerText = error;
            document.getElementById("exito").style.display = "block";
        });
    });

    document.getElementById("buscar-acta").addEventListener("submit", function(event) {
        event.preventDefault();
         buscarActa(event);
    });

    document.getElementById('observaciones').addEventListener('focus', function () {
        if (this.value === 'Sin Observaciones') {
            this.value = '';
        }
    });
    observaciones.addEventListener('blur', function () {
        if (this.value.trim() === '') {
            this.value = 'Sin Observaciones';
        }
    });

    document.getElementById("acta-form").addEventListener("submit", function (event) {
        event.preventDefault(); // Evitar el envío del formulario por defecto

        var formData = new FormData(this);

        fetch(this.action, {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                // Ocultar el label de error al enviar el formulario
                document.getElementById("exito2").style.display = "none";

                if (data.success) {
                    document.getElementById("exito2").className = "text-success";
                    document.getElementById("exito2").textContent = "Acta de bautismo registrada.";
                    document.getElementById("exito2").style.display = "block";

                    document.getElementById("acta-form").reset(); 
                    limpiarCursilloenActa();

                    // Ocultar mensaje después de 3 segundos
                    setTimeout(function () {
                        document.getElementById("exito2").style.display = "none";
                    }, 3000);

                } else {
                    document.getElementById("exito2").className = "text-danger";
                    if (Array.isArray(data.errors)) {
                        document.getElementById("exito2").textContent = data.errors.join(", ");
                    } else {
                        document.getElementById("exito2").textContent = data.errors || "Error desconocido.";
                    }                    
                    document.getElementById("exito2").style.display = "block";
                }
            })
            .catch(error => {
                console.error('Error:', error);
                document.getElementById("exito2").innerText = error;
                document.getElementById("exito2").style.display = "block";
            });
    });

    document.getElementById("acta-antigua").addEventListener("submit", function (event) {
        event.preventDefault(); // Evitar el envío del formulario por defecto

        var formData = new FormData(this);

        fetch(this.action, {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                // Ocultar el label de error al enviar el formulario
                document.getElementById("exito3").style.display = "none";

            if (data.success) {
                const mensaje = document.getElementById("exito3");

                mensaje.className = "text-success";
                mensaje.textContent = "Registro exitoso";
                mensaje.style.display = "block";

                // Limpiar formulario
                document.getElementById("acta-antigua").reset();

                // Ocultar mensaje después de 3 segundos
                setTimeout(function () {
                    mensaje.style.display = "none";
                }, 3000);

                // (Opcional) realizar otras acciones después de 5 segundos
                setTimeout(function () {
                    console.log("Han pasado 5 segundos");
                    // window.location.href = "/Home/MenuSacramentos";
                    // ListActasBautismo();
                    // ListActasAntiguas();
                }, 5000);
                } else {
                    document.getElementById("exito3").className = "text-danger";
                    if (Array.isArray(data.errors)) {
                        document.getElementById("exito3").textContent = data.errors.join(", ");
                    } else {
                        document.getElementById("exito3").textContent = data.errors || "Error desconocido.";
                    }                    
                    document.getElementById("exito3").style.display = "block"
                }
            })
            .catch(errors => {
                console.error('Error:', errors);
                // Opcional: Mostrar un mensaje de error genérico
                document.getElementById("exito3").innerText = errors;
                document.getElementById("exito3").style.display = "block";
            });


    });
    
