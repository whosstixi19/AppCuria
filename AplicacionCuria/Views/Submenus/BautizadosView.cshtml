            : '/Feligres/GetLast?count=8';

        fetch(url)
            .then(response => response.json())
            .then(data => {
                const datalist = document.getElementById('padres_datalist');
                datalist.innerHTML = '';
                data.forEach(f => {
                    const nombreCompleto = f.nombre + (f.apellido ? " " + f.apellido : "");
                    // Muestra nombre y cédula en la lista
                    datalist.innerHTML += `<option value="${nombreCompleto}">${nombreCompleto} - ${f.cedula}</option>`;
