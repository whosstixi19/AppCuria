@{
    ViewData["Title"] = "Registro de Matrimonio";
    ViewData["ActiveSubmenu"] = "Matrimonios";
    Layout = "_Layout";
}

<partial name="_SubmenuSacramentos" />

<!-- Contenedor principal para el título -->
<div class="mb-3 text-center">
    <h1 class="h3 mb-0 text-primary fw-bold">Gestión de Matrimonios</h1>
</div>

<!-- Sistema de pestañas -->
<ul class="nav nav-tabs justify-content-center mb-3" id="formTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="cursillo-tab" data-bs-toggle="tab" data-bs-target="#cursillo" data-toggle="tab" data-target="#cursillo" type="button" role="tab" aria-controls="cursillo" aria-selected="true">
            Cursillo Pre Matrimonial
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="acta-prematrimonial-tab" data-bs-toggle="tab" data-bs-target="#acta" data-toggle="tab" data-target="#acta" type="button" role="tab" aria-controls="acta" aria-selected="false">
            Acta Pre Matrimonial
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="acta-matrimonio-tab" data-bs-toggle="tab" data-bs-target="#matrimonial" data-toggle="tab" data-target="#matrimonial" type="button" role="tab" aria-controls="matrimonial" aria-selected="false">
            Acta de Matrimonio
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="antiguos-tab" data-bs-toggle="tab" data-bs-target="#antiguos" data-toggle="tab" data-target="#antiguos" type="button" role="tab" aria-controls="antiguos" aria-selected="false">
            Matrimonios Antiguos
        </button>
    </li>
</ul>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="tab-content mt-3" id="formTabsContent">
    <!-- Formulario Cursillo Pre Matrimonial -->
    <div class="tab-pane fade show active" id="cursillo" role="tabpanel" aria-labelledby="cursillo-tab">
        <div class="row justify-content-center align-items-start g-3">
            <!-- Formulario a la izquierda -->
            <div class="col-lg-5 col-md-5">
                <div class="card shadow-sm">
                    <div class="card-body p-3">
                        <form asp-action="Create" asp-controller="CursilloPreMatrimonial" method="post" id="formularioCursillo" autocomplete="off">
                            <h5 class="card-title text-primary fw-bold mb-3">
                                <i class="fas fa-heart me-1 text-danger"></i> Registro de Cursillo Pre Matrimonial
                            </h5>

                            <!-- Datos del Novio -->
                            <div class="border rounded p-2 mb-2 bg-light">
                                <h6 class="fw-bold text-secondary mb-2 small"><i class="fas fa-male me-1 text-primary"></i> Datos del Novio</h6>
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <label for="cursillo_nombrenovio" class="form-label mb-1 fw-semibold small">Nombre del Novio</label>
                                        <input type="text" id="cursillo_nombrenovio" name="nombrenovio" required class="form-control form-control-sm">
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <label for="cursillo_cedulanovio" class="form-label mb-1 fw-semibold small">Cédula del Novio</label>
                                        <input type="text" id="cursillo_cedulanovio" name="cedulanovio" required class="form-control form-control-sm">
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-1">
                                        <label for="cursillo_telefononovio" class="form-label mb-1 fw-semibold small">Teléfono del Novio</label>
                                        <input type="tel" id="cursillo_telefononovio" name="telefononovio" required class="form-control form-control-sm">
                                    </div>
                                    <div class="col-md-6 mb-1">
                                        <label for="fechanacimientonovio" class="form-label mb-1 fw-semibold small">F. Nacimiento Novio</label>
                                        <input type="date" id="fechanacimientonovio" name="fechanacimientonovio" required class="form-control form-control-sm">
                                    </div>
                                </div>
                            </div>

                            <!-- Datos de la Novia -->
                            <div class="border rounded p-2 mb-2 bg-light">
                                <h6 class="fw-bold text-secondary mb-2 small"><i class="fas fa-female me-1 text-danger"></i> Datos de la Novia</h6>
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <label for="cursillo_nombrenovia" class="form-label mb-1 fw-semibold small">Nombre de la Novia</label>
                                        <input type="text" id="cursillo_nombrenovia" name="nombrenovia" required class="form-control form-control-sm">
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <label for="cursillo_cedulanovia" class="form-label mb-1 fw-semibold small">Cédula de la Novia</label>
                                        <input type="text" id="cursillo_cedulanovia" name="cedulanovia" required class="form-control form-control-sm">
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-1">
                                        <label for="cursillo_telefononovia" class="form-label mb-1 fw-semibold small">Teléfono de la Novia</label>
                                        <input type="tel" id="cursillo_telefononovia" name="telefononovia" required class="form-control form-control-sm">
                                    </div>
                                    <div class="col-md-6 mb-1">
                                        <label for="fechanacimientonovia" class="form-label mb-1 fw-semibold small">F. Nacimiento Novia</label>
                                        <input type="date" id="fechanacimientonovia" name="fechanacimientonovia" required class="form-control form-control-sm">
                                    </div>
                                </div>
                            </div>

                            <!-- Fechas -->
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="fechacursillo" class="form-label mb-1 fw-semibold small">Fecha de Cursillo</label>
                                    <input type="date" id="fechacursillo" name="fechacursillo" required class="form-control form-control-sm">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="fechamatrimonio" class="form-label mb-1 fw-semibold small">Fecha de Matrimonio</label>
                                    <input type="date" id="fechamatrimonio" name="fechamatrimonio" required class="form-control form-control-sm">
                                </div>
                            </div>

                            <!-- Botones de especificaciones adicionales -->
                            <div class="d-flex flex-wrap gap-2 mb-2 justify-content-between">
                                <button type="button" class="btn btn-outline-primary btn-sm flex-fill" id="printButton" onclick="enviarFormulario('Consanguinidad')">
                                    Consanguinidad
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm flex-fill" id="botonMixta" onclick="enviarFormulario('ReligionMixta')">
                                    Religiones Mixtas
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm flex-fill" id="botonCultos" onclick="enviarFormulario('Cultos')">
                                    Cultos
                                </button>
                            </div>

                            <!-- Estado y Parroquia -->
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="estado" class="form-label mb-1 fw-semibold small">Estado del Cursillo</label>
                                    <select class="form-select form-select-sm" id="estado" name="estado" required>
                                        <option value="Cursando">Cursando</option>
                                        <option value="Aprobado">Aprobado</option>
                                        <option value="Retirado">Retirado</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="parroquia_id" class="form-label mb-1 fw-semibold small">Parroquia</label>
                                    <select class="form-select form-select-sm" id="parroquia_id" name="parroquia">
                                        <option value="">-- Seleccione una parroquia --</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="observaciones" class="form-label mb-1 fw-semibold small">Observaciones</label>
                                <textarea class="form-control form-control-sm" id="observaciones" name="observaciones" rows="2" placeholder="Ingrese observaciones..."></textarea>
                            </div>

                            <!-- Botones de acción centrados -->
                            <div class="d-flex justify-content-center gap-2">
                                <button type="submit" class="btn btn-primary btn-sm px-4 mr-2">Registrar Cursillo</button>
                                <button type="reset" class="btn btn-secondary btn-sm px-4">Limpiar</button>
                            </div>
                            <div id="exito" class="text-success mt-2 text-center fw-semibold small" style="display: none;">Cursillo Registrado</div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Búsqueda y tabla a la derecha -->
            <div class="col-lg-7 col-md-7">
                <div class="card shadow-sm">
                    <div class="card-body p-3">
                        <h5 class="card-title text-primary fw-bold mb-3">
                            <i class="fas fa-search me-1 text-primary"></i> Búsqueda de Cursillos Pre Matrimoniales
                        </h5>
                        <form id="buscar-cursillo" onsubmit="event.preventDefault(); ListCursillo();">
                            <div class="mb-3 d-flex">
                                <input type="text" class="form-control form-control-sm me-2 mr-2" id="nombrecompleto" name="nombrecompleto" placeholder="Nombre completo del novio/novia...">
                                <button type="button" class="btn btn-primary btn-sm me-2 mr-2 text-nowrap" onclick="ListCursillo()">
                                    <i class="fas fa-search"></i> Buscar
                                </button>
                                <button type="button" class="btn btn-secondary btn-sm text-nowrap" onclick="limpiarBusquedaCursilloGeneral()">
                                    Limpiar
                                </button>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-bordered table-hover table-sm text-center align-middle mb-0" style="font-size: 0.86rem; width: 100%;">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Novio</th>
                                            <th>Novia</th>
                                            <th>F. Cursillo</th>
                                            <th>F. Matrimonio</th>
                                            <th>Estado</th>
                                            <th>Modificar</th>
                                            <th>Eliminar</th>
                                        </tr>
                                    </thead>
                                    <tbody id="resultadosCursillo">
                                    @if (Model != null && Model.Any())
                                    {
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.nombrenovio</td>
                                                <td>@item.nombrenovia</td>
                                                <td>@item.fechacursillo.ToString("dd/MM/yyyy")</td>
                                                <td>@item.fechamatrimonio.ToString("dd/MM/yyyy")</td>
                                                <td>@item.estado</td>
                                                <td>
                                                    <a asp-action="ModifyCursilloMatView" asp-controller="CursilloPreMatrimonial" asp-route-id="@item.id" class="btn btn-warning btn-sm">Actualizar</a>
                                                </td>
                                                <td>
                                                    <a asp-action="DeleteCursilloMatView" asp-controller="CursilloPreMatrimonial" asp-route-id="@item.id" class="btn btn-danger btn-sm" id="btnEliminar">Eliminar</a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="7">No se encontraron resultados.</td></tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
   

    <!-- Formulario Acta de PreMatrimonio -->
    <div class="tab-pane fade" id="acta" role="tabpanel" aria-labelledby="acta-prematrimonial-tab">
        <div class="row justify-content-center align-items-start g-3">
            <!-- Formulario de creación a la izquierda -->
            <div class="col-lg-5 col-md-5">
                <div class="card shadow-sm">
                    <div class="card-body p-3">
                        <form asp-action="Create" asp-controller="ActaPrematrimonial" method="post" id="acta-prematrimonial" autocomplete="off">
                            <h5 class="card-title text-primary fw-bold mb-3">
                                <i class="fas fa-ring me-1 text-warning"></i> Registro de Acta Pre Matrimonial
                            </h5>
                            <div id="tooltipCursillo" class="alert alert-warning py-1 px-2 small mb-2" style="display: none;">
                                Primero debes seleccionar un cursillo de la lista de la derecha.
                            </div>

                            <!-- Datos del Novio -->
                            <div class="border rounded p-2 mb-2 bg-light">
                                <h6 class="fw-bold text-secondary mb-2 small"><i class="fas fa-male me-1 text-primary"></i> Datos del Novio</h6>
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <label for="NombreNovio" class="form-label mb-1 fw-semibold small">Nombre del Novio</label>
                                        <input type="text" id="NombreNovio" name="nombrenovio" class="form-control form-control-sm" placeholder="Nombre del Novio" required />
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <label for="LugarBautizoNovio" class="form-label mb-1 fw-semibold small">Lugar de Bautizo</label>
                                        <input type="text" id="LugarBautizoNovio" name="lugarbautizonovio" placeholder="Lugar Bautizo" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <label for="nombrepadrenovio" class="form-label mb-1 fw-semibold small">Padre del Novio</label>
                                        <input type="text" id="nombrepadrenovio" placeholder="Padre del Novio" name="nombrepadrenovio" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <label for="nombremadrenovio" class="form-label mb-1 fw-semibold small">Madre del Novio</label>
                                        <input type="text" id="nombremadrenovio" name="nombremadrenovio" placeholder="Madre del Novio" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-1">
                                        <label for="FechaNacimientoNovio" class="form-label mb-1 fw-semibold small">F. Nacimiento Novio</label>
                                        <input type="date" id="FechaNacimientoNovio" name="fechanacimientonovio" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-6 mb-1">
                                        <label for="FechaBautizoNovio" class="form-label mb-1 fw-semibold small">F. Bautizo Novio</label>
                                        <input type="date" id="FechaBautizoNovio" name="fechabautizonovio" class="form-control form-control-sm" />
                                    </div>
                                </div>
                            </div>

                            <!-- Datos de la Novia -->
                            <div class="border rounded p-2 mb-2 bg-light">
                                <h6 class="fw-bold text-secondary mb-2 small"><i class="fas fa-female me-1 text-danger"></i> Datos de la Novia</h6>
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <label for="NombreNovia" class="form-label mb-1 fw-semibold small">Nombre de la Novia</label>
                                        <input type="text" id="NombreNovia" name="nombrenovia" class="form-control form-control-sm" placeholder="Nombre de la Novia" required />
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <label for="LugarBautizoNovia" class="form-label mb-1 fw-semibold small">Lugar de Bautizo</label>
                                        <input type="text" id="LugarBautizoNovia" placeholder="Lugar Bautizo" name="lugarbautizonovia" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <label for="nombrepadrenovia" class="form-label mb-1 fw-semibold small">Padre de la Novia</label>
                                        <input type="text" id="nombrepadrenovia" placeholder="Padre de la Novia" name="nombrepadrenovia" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <label for="nombremadrenovia" class="form-label mb-1 fw-semibold small">Madre de la Novia</label>
                                        <input type="text" id="nombremadrenovia" placeholder="Madre de la Novia" name="nombremadrenovia" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-1">
                                        <label for="FechaNacimientoNovia" class="form-label mb-1 fw-semibold small">F. Nacimiento Novia</label>
                                        <input type="date" id="FechaNacimientoNovia" name="fechanacimientonovia" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-6 mb-1">
                                        <label for="FechaBautizoNovia" class="form-label mb-1 fw-semibold small">F. Bautizo Novia</label>
                                        <input type="date" id="FechaBautizoNovia" name="fechabautizonovia" class="form-control form-control-sm" />
                                    </div>
                                </div>
                            </div>

                            <!-- Información del Matrimonio -->
                            <div class="mb-2">
                                <label for="FechaMatrimonio" class="form-label mb-1 fw-semibold small">Fecha del Matrimonio</label>
                                <input type="date" id="FechaMatrimonio" name="fechamatrimonio" class="form-control form-control-sm" required />
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="ministro_id" class="form-label mb-1 fw-semibold small">Ministro</label>
                                    <select id="ministro_id" name="ministro_id" class="form-select form-select-sm" required>
                                        <option value="">Seleccione un ministro</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="iglesia_id" class="form-label mb-1 fw-semibold small">Iglesia</label>
                                    <select id="iglesia_id" name="iglesia_id" class="form-select form-select-sm" required>
                                        <option value="">Seleccione una iglesia</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Testigos -->
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="testigo1" class="form-label mb-1 fw-semibold small">Testigo 1</label>
                                    <input type="text" id="testigo1" name="testigo1" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="testigo2" class="form-label mb-1 fw-semibold small">Testigo 2</label>
                                    <input type="text" id="testigo2" name="testigo2" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label for="testigo3" class="form-label mb-1 fw-semibold small">Testigo 3 (opc)</label>
                                    <input type="text" id="testigo3" name="testigo3" class="form-control form-control-sm" placeholder="(Opcional)"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="testigo4" class="form-label mb-1 fw-semibold small">Testigo 4 (opc)</label>
                                    <input type="text" id="testigo4" name="testigo4" class="form-control form-control-sm" placeholder="(Opcional)"/>
                                </div>
                            </div>

                            <!-- Registro Civil -->
                            <div class="border rounded p-2 mb-2 bg-light">
                                <h6 class="fw-bold text-secondary mb-2 small"><i class="fas fa-university me-1"></i> Registro Civil</h6>
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <label for="FechaRegistroCivil" class="form-label mb-1 fw-semibold small">Fecha Reg. Civil</label>
                                        <input type="date" id="FechaRegistroCivil" name="fecharegistrocivil" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <label for="LugarRegistroCivil" class="form-label mb-1 fw-semibold small">Lugar Reg. Civil</label>
                                        <input type="text" id="LugarRegistroCivil" name="lugarregistrocivil" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-4 mb-1">
                                        <label for="NumeroActaRegistroCivil" class="form-label mb-1 fw-semibold small">N° Acta</label>
                                        <input type="text" id="NumeroActaRegistroCivil" name="numeroactaregistrocivil" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-4 mb-1">
                                        <label class="form-label mb-1 fw-semibold small">Página</label>
                                        <input type="text" id="NumeroPaginaRegistroCivil" name="numeropaginaregistrocivil" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-4 mb-1">
                                        <label class="form-label mb-1 fw-semibold small">Tomo</label>
                                        <input type="text" id="NumeroTomoRegistroCivil" name="numertomoregistrocivil" class="form-control form-control-sm" />
                                    </div>
                                </div>
                            </div>

                            <!-- Registro Eclesiástico -->
                            <div class="border rounded p-2 mb-2 bg-light">
                                <h6 class="fw-bold text-secondary mb-2 small"><i class="fas fa-church me-1"></i> Registro Eclesiástico</h6>
                                <div class="row">
                                    <div class="col-md-4 mb-2">
                                        <label for="Tomo" class="form-label mb-1 fw-semibold small">Tomo</label>
                                        <input type="text" id="Tomo" name="tomo" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <label for="Pagina" class="form-label mb-1 fw-semibold small">Página</label>
                                        <input type="text" id="Pagina" name="pagina" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <label for="Acta" class="form-label mb-1 fw-semibold small">N° Acta</label>
                                        <input type="text" id="Acta" name="acta" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="mb-1">
                                    <label for="FechaRegistroParroquial" class="form-label mb-1 fw-semibold small">Fecha de Registro Parroquial</label>
                                    <input type="date" id="FechaRegistroParroquial" name="fecharegistro" class="form-control form-control-sm" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="Observaciones" class="form-label mb-1 fw-semibold small">Observaciones</label>
                                <textarea id="Observaciones" name="observaciones" class="form-control form-control-sm" rows="2"></textarea>
                            </div>

                            <input type="hidden" id="cursillo_id" name="cursillo_id" />
                            <input type="hidden" id="CursilloIdSeleccionado" name="CursilloIdSeleccionado" />
                            <div class="d-flex justify-content-center gap-2">
                                <button type="submit" class="btn btn-primary btn-sm px-4 mr-2">Registrar</button>
                                <button type="reset" class="btn btn-secondary btn-sm px-4">Limpiar</button>
                            </div>
                            <div id="alertaCursillo" class="alert alert-danger py-1 px-2 small mt-2 text-center" role="alert" style="display: none;">
