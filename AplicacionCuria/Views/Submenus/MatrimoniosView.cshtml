    function ListCursillo(nombre) {
        if (nombre === undefined) {
            nombre = document.getElementById('nombrecompleto')?.value || '';
        }
        nombre = nombre.trim();
        const resultadosBody = document.getElementById('resultadosCursillo');
        if (!resultadosBody) return;

        fetch(`/CursilloPreMatrimonial/SearchByName?nombrecompleto=${encodeURIComponent(nombre)}`)
            .then(response => response.json())
            .then(data => {
                resultadosBody.innerHTML = ""; // Limpiar resultados anteriores

                if (data.length > 0) {
                    data.forEach(item => {
                        const row = `
                            <tr>
                                <td>${item.nombrenovio}</td>
                                <td>${item.nombrenovia}</td>
                                <td>${new Date(item.fechacursillo).toLocaleDateString()}</td>
                                <td>${new Date(item.fechamatrimonio).toLocaleDateString()}</td>
                                <td>${item.estado}</td>
                                <td><a href="/CursilloPreMatrimonial/ModifyCursilloMatView/${item.id}" class="btn btn-warning">Actualizar</a></td>
                                <td><a href="/CursilloPreMatrimonial/DeleteCursilloMatView/${item.id}" class="btn btn-danger">Eliminar</a></td>
                            </tr>`;
                        resultadosBody.innerHTML += row;
                    });
                } else {
                    resultadosBody.innerHTML = "<tr><td colspan='7' class='text-center'>No se encontraron resultados.</td></tr>";
                }
            })
            .catch(error => {
                console.error('Error en la búsqueda:', error);
                resultadosBody.innerHTML = "<tr><td colspan='7' class='text-danger text-center'>Error al realizar la búsqueda.</td></tr>";
            });
    }

