        fetch(`/ActaPrematrimonial/SearchByName?nombrecompleto=${encodeURIComponent(nombre)}`)
            .then(response => response.json())
            .then(data => {
                const resultados = document.getElementById('resultadosActas');
                if (!resultados) return;
                resultados.innerHTML = '';

                if (data.length > 0) {
                    data.forEach(item => {
                        resultados.innerHTML += `
