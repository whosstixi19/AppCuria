<title>@ViewData["Title"] - Registro de Bautizo</title>
@{
    Layout = "_Layout";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<!-- Contenedor principal para el título y el botón -->
<div class="d-flex align-items-center mb-3">
    <a class="btn btn-secondary d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="MenuSacramentos" aria-label="Regresar al menú de sacramentos">
        <i class="fas fa-arrow-left me-1"></i>
        <span>Volver</span>
    </a>
    <h1 class="ms-3">Registro de Matrimonio</h1>
</div>

<!-- Sistema de pestañas -->
<ul class="nav nav-tabs" id="formTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="cursillo-tab" data-toggle="tab" data-target="#cursillo" type="button" role="tab" aria-controls="cursillo" aria-selected="true">
            Cursillo Pre Matrimonial
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="acta-prematrimonial-tab" data-toggle="tab" data-target="#acta" type="button" role="tab" aria-controls="acta" aria-selected="false">
            Acta Pre Matrimonial
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="acta-matrimonio-tab" data-toggle="tab" data-target="#matrimonial" type="button" role="tab" aria-controls="matrimonial" aria-selected="false">
            Acta de Matrimonio
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="antiguos-tab" data-toggle="tab" data-target="#antiguos" type="button" role="tab" aria-controls="antiguos" aria-selected="false">
            Matrimonios Antiguos
        </button>
    </li>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

</ul>

<div class="tab-content mt-3" id="formTabsContent">
    <!-- Formulario Cursillo Pre Matrimonial -->
    <div class="tab-pane fade show active" id="cursillo" role="tabpanel" aria-labelledby="cursillo-tab">
        <div class="row">
            <div class="col-md-6">
                <form asp-action="Create" asp-controller="CursilloPreMatrimonial" method="post" id="formularioCursillo">
                    <h2>Registro de Cursillo Pre Matrimonial</h2>
                    <div class="row">
                        <!-- Columna para datos del Novio -->
                        <div class="col-md-6">
                            <h4>Datos del Novio</h4>
                            <div class="mb-3">
                                <label for="cursillo_nombrenovio">Nombre del Novio:</label>
                                <input type="text" id="cursillo_nombrenovio" name="nombrenovio" required class="form-control">
                            </div>
                            <div class="mb-3">
                                <label for="cursillo_cedulanovio">Cédula del Novio:</label>
                                <input type="text" id="cursillo_cedulanovio" name="cedulanovio" required class="form-control">
                            </div>
                            <div class="mb-3">
                                <label for="cursillo_telefononovio">Teléfono del Novio:</label>
                                <input type="tel" id="cursillo_telefononovio" name="telefononovio" required class="form-control">
                            </div>
                            <div class="mb-3">
                                <label for="fechanacimientonovio">Fecha de Nacimiento del Novio:</label>
                                <input type="date" id="fechanacimientonovio" name="fechanacimientonovio" required class="form-control">
                            </div>
                        </div>

                        <!-- Columna para datos de la Novia -->
                        <div class="col-md-6">
                            <h4>Datos de la Novia</h4>
                            <div class="mb-3">
                                <label for="cursillo_nombrenovia">Nombre de la Novia:</label>
                                <input type="text" id="cursillo_nombrenovia" name="nombrenovia" required class="form-control">
                            </div>
                            <div class="mb-3">
                                <label for="cursillo_cedulanovia">Cédula de la Novia:</label>
                                <input type="text" id="cursillo_cedulanovia" name="cedulanovia" required class="form-control">
                            </div>
                            <div class="mb-3">
                                <label for="cursillo_telefononovia">Teléfono de la Novia:</label>
                                <input type="tel" id="cursillo_telefononovia" name="telefononovia" required class="form-control">
                            </div>
                            <div class="mb-3">
                                <label for="fechanacimientonovia">Fecha de Nacimiento de la Novia:</label>
                                <input type="date" id="fechanacimientonovia" name="fechanacimientonovia" required class="form-control">
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="fechacursillo">Fecha de Cursillo:</label>
                        <input type="date" id="fechacursillo" name="fechacursillo" required class="form-control">
                    </div>
                    <div class="mb-3">
                        <label for="fechamatrimonio">Fecha de Matrimonio:</label>
                        <input type="date" id="fechamatrimonio" name="fechamatrimonio" required class="form-control">
                    </div>

                    @* <div class="mb-3 d-flex align-items-center">
                        <label for="consanguinidad" class="mr-2">¿Son de Consanguinidad?</label>
                        <button type="submit" class="btn btn-primary" id="printButton" asp-action="Consanguinidad" asp-controller="Matrimonio">Especificar Consanguinidad</button>
                    </div>

                    <div class="mb-3 d-flex align-items-center">
                        <label for="mixtareligion" class="mr-2">¿Son de Religiones Mixtas?</label>
                        <button type="submit" class="btn btn-primary" id="botonMixta" asp-action="ReligionMixta" asp-controller="Matrimonio">Especificar Religiones</button>
                    </div>

                    <div class="mb-3 d-flex align-items-center">
                        <label for="disponibilidadcultos" class="mr-2">¿Disponibilidad de Cultos?</label>
                        <button type="submit" class="btn btn-primary" id="botonCultos" asp-action="Cultos" asp-controller="Matrimonio">Especificar Cultos</button>
                    </div> *@

                    <div class="mb-3 d-flex align-items-center">
                        <label for="consanguinidad" class="mr-2">¿Son de Consanguinidad?</label>
                        <button type="button" class="btn btn-primary" id="printButton" onclick="enviarFormulario('Consanguinidad')">Especificar Consanguinidad</button>
                    </div>

                    <div class="mb-3 d-flex align-items-center">
                        <label for="mixtareligion" class="mr-2">¿Son de Religiones Mixtas?</label>
                        <button type="button" class="btn btn-primary" id="botonMixta" onclick="enviarFormulario('ReligionMixta')">Especificar Religiones</button>
                    </div>

                    <div class="mb-3 d-flex align-items-center">
                        <label for="disponibilidadcultos" class="mr-2">¿Disponibilidad de Cultos?</label>
                        <button type="button" class="btn btn-primary" id="botonCultos" onclick="enviarFormulario('Cultos')">Especificar Cultos</button>
                    </div>

                    <div class="mb-3 d-flex align-items-center">
                        <label for="estado" class="form-label">Estado del Cursillo</label>
                        <select class="form-select" id="estado" name="estado" required>
                            <option value="Cursando">Cursando</option>
                            <option value="Aprobado">Aprobado</option>
                            <option value="Retirado">Retirado</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="parroquia_id" class="form-label">Seleccionar Parroquia:</label>
                        <select class="form-select w-50" id="parroquia_id" name="parroquia">
                            <option value="">-- Seleccione una parroquia --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="observaciones" class="form-label">Observaciones</label>
                        <textarea class="form-control" id="observaciones" name="observaciones" rows="3" placeholder="Ingrese observaciones..."></textarea>
                    </div>

                    <button  type="submit" class="btn btn-primary mt-3">Registrar Cursillo</button>
                    <label id="exito" class="text-success" style="display: none;">Cursillo Registrado</label>
                </form>
                <!-- Segunda columna con detalles e formulario de búsqueda -->
            </div>
            <div class="col-lg-6 col-md-12 mt-4 mt-lg-0">
                <form id="buscar-cursillo" >
                    <div class="mb-3">
                        <label for="nombrecompletonino" class="form-label">Nombre completo del novio/novia</label>
                        <input type="text" class="form-control" id="nombrecompleto" name="nombrecompleto" placeholder="Escribe un nombre...">
                    </div>
                    <div class="mb-3">
                        <button type="button" class="btn btn-primary" onclick="ListCursillo()">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="limpiarBusquedaCursilloGeneral()">
                            <i class="fas fa-times"></i> Limpiar
                        </button>
                    </div>
                    
                    <div class="mb-3">
                        
                            <h3>Resultados de la búsqueda:</h3>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Nombre del novio</th>
                                        <th>Nombre de la novia</th>
                                        <th>Fecha de Cursillo</th>
                                        <th>Fecha de Matrimonio</th>
                                        <th>Estado</th>
                                        <th>Modificar</th>
                                        <th>Eliminar</th>
                                    </tr>
                                </thead>
                                <tbody id="resultadosCursillo">
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.nombrenovio</td>
                                            <td>@item.nombrenovia</td>
                                            <td>@item.fechacursillo.ToString("dd/MM/yyyy")</td>
                                            <td>@item.fechamatrimonio.ToString("dd/MM/yyyy")</td>
                                            <td>@item.estado</td>
                                            <td>
                                                <a asp-action="ModifyCursilloMatView" asp-controller="CursilloPreMatrimonial" asp-route-id="@item.id" class="btn btn-warning">Actualizar</a>
                                            </td>
                                            <td>
                                                <a asp-action="DeleteCursilloMatView" asp-controller="CursilloPreMatrimonial" asp-route-id="@item.id" class="btn btn-danger" id="btnEliminar">Eliminar</a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <p>No se encontraron resultados.</p>
                                }
                                </tbody>
                            </table>
                        
                    </div>
                </form>
            </div>
        </div>

    </div>
   

    <!-- Formulario Acta de PreMatrimonio -->
    <div class="tab-pane fade" id="acta" role="tabpanel" aria-labelledby="acta-prematrimonial-tab">
        <div class="row">
            <!-- Formulario de creación a la izquierda -->
            <div class="col-md-6">
                <form asp-action="Create" asp-controller="ActaPrematrimonial" method="post" id="acta-prematrimonial">
                    <h2>Registro de Acta Pre Matrimonial</h2>
                    <div id="tooltipCursillo" class="invalid-tooltip" style="display: none; position: absolute; z-index: 10;">
                    Primero debes seleccionar un cursillo.
                    </div>
                    <div class="row">
                        <!-- Columna para datos del Novio -->
                        <div class="col-md-6">

                    <h5>Datos del Novio</h5>
                    <div class="mb-3">
@*                         <label for="NombreNovio">Nombre del Novio:</label>
                                *@                        
                         <input type="text" id="NombreNovio" name="nombrenovio" class="form-control" placeholder="Nombre del Novio" required />
                    </div>
                    <div class="mb-3">
@*                         <label for="LugarBautizoNovio">Lugar de Bautizo del Novio:</label>
                                *@                        
                         <input type="text" id="LugarBautizoNovio" name="lugarbautizonovio" placeholder="Lugar de Bautizo del Novio" class="form-control" />
                    </div>
                    <div class="mb-3">
@*                         <label for="PadreNovio">Padre del Novio:</label>
                                *@                        
                         <input type="text" id="nombrepadrenovio" placeholder="Padre del Novio" name="nombrepadrenovio" class="form-control" />
                    </div>
                    <div class="mb-3">
@*                         <label for="MadreNovio">:</label>
                                *@                        
                         <input type="text" id="nombremadrenovio" name="nombremadrenovio" placeholder="Madre del Novio" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="FechaNacimientoNovio">Fecha de Nacimiento del Novio:</label>
                        <input type="date" id="FechaNacimientoNovio" name="fechanacimientonovio" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="FechaBautizoNovio">Fecha de Bautizo del Novio:</label>
                        <input type="date" id="FechaBautizoNovio" name="fechabautizonovio" class="form-control" />
                    </div>
                    </div>
                    <div class="col-md-6">
                        <h4>Datos de la Novia</h4>
                    <div class="mb-3">
@*                         <label for="NombreNovia">Nombre de la Novia:</label>
 *@                        <input type="text" id="NombreNovia" name="nombrenovia" class="form-control" placeholder="Nombre de la Novia" required />
                    </div>
                    <div class="mb-3">
@*                         <label for="LugarBautizoNovia">Lugar de Bautizo de la Novia:</label>
                                *@                        
                         <input type="text" id="LugarBautizoNovia" placeholder="Lugar de Bautizo de la Novia" name="lugarbautizonovia" class="form-control" />
                    </div>
                    <div class="mb-3">
@*                         <label for="PadreNovia">Padre de la Novia:</label>
                                *@                        
                                
                         <input type="text" id="nombrepadrenovia" placeholder="Padre de la Novia" name="nombrepadrenovia" class="form-control" />
                    </div>
                    <div class="mb-3">
@*                         <label for="MadreNovia">Madre de la Novia:</label>
                                *@                       
                         <input type="text" id="nombremadrenovia" placeholder="Madre de la Novia" name="nombremadrenovia" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="FechaNacimientoNovia">Fecha de Nacimiento de la Novia:</label>
                        <input type="date" id="FechaNacimientoNovia" name="fechanacimientonovia" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="FechaBautizoNovia">Fecha de Bautizo de la Novia:</label>
                        <input type="date" id="FechaBautizoNovia" name="fechabautizonovia" class="form-control" />
                    </div>
                        </div>
                    <h5>Información del Matrimonio</h5>
                    <div class="mb-3">
                        <label for="FechaMatrimonio">Fecha del Matrimonio:</label>
                        <input type="date" id="FechaMatrimonio" name="fechamatrimonio" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label for="ministro_id">Ministro:</label>
                        <select id="ministro_id" name="ministro_id" class="form-control" required>
                            <option value="">Seleccione un ministro</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="iglesia_id">Iglesia:</label>
                        <select id="iglesia_id" name="iglesia_id" class="form-control" required>
                            <option value="">Seleccione una iglesia</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="Testigo1">Testigo 1:</label>
                        <input type="text" id="testigo1" name="testigo1" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="testigo2">Testigo 2:</label>
                        <input type="text" id="testigo2" name="testigo2" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="testigo3">Testigo 3:</label>
                        <input type="text" id="testigo3" name="testigo3" class="form-control" placeholder="(Opcional)"/>
                    </div>
                    <div class="mb-3">
                        <label for="testigo4">Testigo 4:</label>
                        <input type="text" id="testigo4" name="testigo4" class="form-control" placeholder="(Opcional)"/>
                    </div>
                    @* <div class="mb-3">
                        <label for="LugarMatrimonio">Lugar del Matrimonio:</label>
                        <input type="text" id="LugarMatrimonio" name="lugarmatrimonio" class="form-control" />
                    </div> *@
                    @* <div class="mb-3">
                        <label for="Celebrante">Celebrante del Matrimonio:</label>
                        <input type="text" id="Celebrante" name="Celebrante" class="form-control" />
                    </div> *@

                    <h4>Registro Civil</h4>
                    <div class="mb-3">
                        <label for="FechaRegistroCivil">Fecha del Registro Civil:</label>
                        <input type="date" id="FechaRegistroCivil" name="fecharegistrocivil" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="LugarRegistroCivil">Lugar del Registro Civil:</label>
                        <input type="text" id="LugarRegistroCivil" name="lugarregistrocivil" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="NumeroActaRegistroCivil">Número de Acta del Registro Civil:</label>
                        <input type="text" id="NumeroActaRegistroCivil" name="numeroactaregistrocivil" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label for="NumeroActaRegistroCivil">Número de Página del Registro Civil:</label>
                        <input type="text" id="NumeroActaRegistroCivil" name="numeropaginaregistrocivil" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label for="NumeroActaRegistroCivil">Número de Tomo del Registro Civil:</label>
                        <input type="text" id="NumeroActaRegistroCivil" name="numertomoregistrocivil" class="form-control" />
                    </div>

                    <h4>Registro Eclesiástico</h4>
                    <div class="mb-3">
                        <label for="Tomo">Tomo:</label>
                        <input type="text" id="Tomo" name="tomo" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="Pagina">Página:</label>
                        <input type="text" id="Pagina" name="pagina" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="Acta">Número de Acta:</label>
                        <input type="text" id="Acta" name="acta" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="FechaRegistroParroquial">Fecha de Registro Parroquial:</label>
                        <input type="date" id="FechaRegistroParroquial" name="fecharegistro" class="form-control" />
                    </div>
                        <div class="mb-3">
                            <label for="Observaciones">Observaciones:</label>
                            <input type="text" id="Observaciones" name="observaciones" class="form-control" />
                        </div>
                    </div>

                    <input type="hidden" id="cursillo_id" name="cursillo_id" />
                    <input type="hidden" id="CursilloIdSeleccionado" name="CursilloIdSeleccionado" />
                    <button type="submit" class="btn btn-primary">Registrar</button>
                    <div id="alertaCursillo" class="alert alert-danger" role="alert" style="display: none;">
                        Debes seleccionar un cursillo antes de registrar el acta.
                    </div>
                    <label id="exito2" class="text-success" style="display: none;">Acta Registrado</label>

                </form>
            </div>

            <!-- Detalles a la derecha -->
            <div class="col-lg-6 col-md-12 mt-4 mt-lg-0">

                <!-- TABLA DE CURSILLOS PARA SELECCIONAR -->
                <div class="mb-3">
                    <h4>Seleccionar Cursillo</h4>

                    <input type="text" class="form-control mb-2" id="busquedaCursillo" placeholder="Selecciona el cursillo correspondiente al acta que estás registrando.">
                    <!-- Mensaje de advertencia en rojo, oculto por defecto -->
                    <div id="mensajeErrorCursillo" class="text-danger mb-2" style="display: none;">
                        Ingresa un valor o nombre.
                    </div>
                    <!-- Botones -->
                    <button type="button" class="btn btn-primary" onclick="buscarCursillos()">
                        <i class="fas fa-search"></i> Buscar 
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="limpiarBusquedaCursilloActa()">
                        <i class="fas fa-times"></i> Limpiar
                    </button>

                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Nombre Novio</th>
                                <th>Nombre Novia</th>
                                <th>Fecha Cursillo</th>
                                <th>Seleccionar</th>
                            </tr>
                        </thead>
                        <tbody id="tablaCursillos">
                            <!-- Se llena con JavaScript -->
                        </tbody>
                    </table>
                </div>

                <div class="mt-5">
                    <h4>Registros de Actas Pre Matrimoniales</h4>
                </div>
                <!-- Formulario de búsqueda de actas -->
                <form asp-action="Search" method="get" id="buscar-cursillo" asp-controller="CursilloPreMatrimonial">
                    <div class="mb-3">
                        <input type="text" class="form-control" id="nombrecompletonino" name="nombrecompletonino" placeholder="Buscar por nombre del novio/novia...">
                        <div id="mensajeErrorNombre" class="text-danger mt-1" style="display: none;">
                            Ingresa un valor o nombre.
                        </div>
                    </div>
                    <div class="mb-3">
                        <button type="button" class="btn btn-primary" onclick="ListActaPre()">
                            <i class="fas fa-search"></i> Buscar 
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="LimpiarBusqueda()">
                            <i class="fas fa-times"></i> Limpiar
                        </button>
                    </div>
                    <div class="mb-3">

                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Nombre Novio</th>
                                    <th>Nombre Novia</th>
                                    <th>Fecha de Matrimonio</th>
                                    <th>Estado</th>
                                    <th>Modificar</th>
                                    <th>Eliminar</th>
                                </tr>
                            </thead>
                            <tbody id="resultadosActas">
                                @if (Model != null)
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.nombrenovio</td>
                                            <td>@item.nombrenovia</td>
                                            <td>@item.fechamatrimonio.ToString("dd/MM/yyyy")</td>
                                            <td>@item.estado</td>
                                            <td>
                                                <a asp-action="ModifyActaPrematrimonialView" asp-controller="ActaPrematrimonial" asp-route-id="@item.id" class="btn btn-warning">Actualizar</a>
                                            </td>
                                            <td>
                                                <a asp-action="DeleteActaPrematrimonialView" asp-controller="ActaPrematrimonial" asp-route-id="@item.id" class="btn btn-danger" id="btnEliminar">Eliminar</a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="7">No se encontraron resultados.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="tab-pane fade" id="matrimonial" role="tabpanel" aria-labelledby="acta-matrimonio-tab">
        <div class="row">
            <!-- Formulario de creación a la izquierda -->
            <div class="col-md-6">
                <form asp-action="Create" asp-controller="ActaMatrimonial" method="post" id="form-acta-matrimonial">
                    <h2>Registro de Acta de Matrimonio</h2>
                    <div class="row">
                        <h5 class="mt-3">Padrinos del Matrimonio</h5>

