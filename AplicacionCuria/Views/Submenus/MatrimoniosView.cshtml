<script>

    function buscarCursillos(texto) {
        if (texto === undefined) {
            texto = document.getElementById('busquedaCursillo')?.value || '';
        }
        texto = texto.trim();
        const mensajeError = document.getElementById('mensajeErrorCursillo');
        if (mensajeError) mensajeError.style.display = 'none';

        const url = texto.length > 0 
            ? `/CursilloPreMatrimonial/SearchAprobadoByName?nombrecompleto=${encodeURIComponent(texto)}`
            : `/CursilloPreMatrimonial/SearchAprobado`;

        fetch(url)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Error en la respuesta del servidor');
                }
                return response.json();
            })
            .then(data => {
                const tbody = document.getElementById("tablaCursillos");
                if (!tbody) return;
                tbody.innerHTML = "";

                if (data.length > 0) {
                    data.forEach(item => {
                        const row = `
                            <tr>
                                <td>${item.nombrenovio}</td>
                                <td>${item.nombrenovia}</td>
                                <td>${new Date(item.fechacursillo).toLocaleDateString()}</td>
                                <td><button type="button" class="btn btn-success" onclick="seleccionarCursillo(${item.id})">Seleccionar</button></td>
                            </tr>`;
                        tbody.innerHTML += row;
                    });
                } else {
                    tbody.innerHTML = "<tr><td colspan='4' class='text-center'>No se encontraron cursillos.</td></tr>";
                }
            })
            .catch(error => {
                console.error("Error al buscar cursillos:", error);
                const tbody = document.getElementById("tablaCursillos");
                if (tbody) tbody.innerHTML = `<tr><td colspan='4' class='text-danger text-center'>${error.message}</td></tr>`;
            });
    }

    function limpiarBusquedaCursilloActa() {
        const input = document.getElementById('busquedaCursillo');
        if (input) input.value = '';
        buscarCursillos('');
    }
    
    function seleccionarCursillo(id) {
        fetch(`/CursilloPreMatrimonial/GetById?id=${id}`)
            .then(response => {
                if (!response.ok) {
                    throw new Error("No se pudo obtener el cursillo");
                }
                return response.json();
            })
            .then(data => {
                document.getElementById("cursillo_id").value = id;

                const alerta = document.getElementById("alertaCursillo");
                if (alerta) {
                    alerta.style.display = "none";
                }

                document.getElementById("NombreNovio").value = data.nombrenovio;
                document.getElementById("NombreNovia").value = data.nombrenovia;
                document.getElementById("FechaNacimientoNovio").value = data.fechanacimientonovio ? data.fechanacimientonovio.substring(0, 10) : '';
                document.getElementById("FechaNacimientoNovia").value = data.fechanacimientonovia ? data.fechanacimientonovia.substring(0, 10) : '';
                document.getElementById("FechaMatrimonio").value = data.fechamatrimonio ? data.fechamatrimonio.substring(0, 10) : '';

                mostrarMensajeSeleccion(`Cursillo seleccionado: ${data.nombrenovio} & ${data.nombrenovia}`);
            })
            .catch(error => {
                console.error("Error al obtener los datos del cursillo:", error);
                alert("Hubo un problema al cargar los datos del cursillo.");
            });
    }

    function mostrarMensajeSeleccion(mensaje) {
        let div = document.getElementById("mensajeSeleccion");
        if (!div) {
            div = document.createElement("div");
            div.id = "mensajeSeleccion";
            div.className = "alert alert-success mt-2";
            document.querySelector("body").prepend(div);
        }
        div.innerHTML = mensaje;
        div.style.display = "block";

        setTimeout(() => {
            div.style.display = "none";
        }, 5000);
    }

    function toggleButton() {
        const select = document.getElementById("consanguinidad");
        const button = document.getElementById("printButton");

        // Habilita el botón si el valor del select es "true", de lo contrario lo deshabilita
        button.disabled = select.value === "true";
    }

    function seleccionarActaPreYEnviar(id) {
        fetch(`/ActaMatrimonial/GetById?id=${id}`)
            .then(response => response.json())
            .then(data => {
                console.log(" Datos recibidos:", data);

                // Asignaciones al formulario
                document.getElementById("acta_prematrimonial_id").value = id;
                document.getElementById("hidden_iglesia_id").value = data.iglesia_id ?? '';
                document.getElementById("hidden_ministro_id").value = data.ministro_id ?? '';
                document.getElementById("pagina").value = data.pagina || '';
                document.getElementById("tomo").value = data.tomo || '';
                document.getElementById("fecha_matrimonio").value = data.fechamatrimonio 
                    ? data.fechamatrimonio.substring(0, 10) 
                    : '';
                document.getElementById("errorActaMessage")?.classList.add("d-none");
                // Asignación de acta (esta es la parte importante)
                const inputActa = document.getElementById("input-acta");
                if (inputActa) {
                    inputActa.value = data.acta ?? '';
                    console.log(" Acta cargada:", inputActa.value);
                } else {
                    console.error(" Campo hidden con id='acta' no encontrado en el DOM.");
                }

                console.log(" Datos cargados en el formulario, ahora puedes enviarlo manualmente");

                // Confirmación de lo que se va a enviar
                const formData = new FormData(document.getElementById("form-acta-matrimonial"));
                console.log(" Verificando valores cargados en FormData:");
                for (let [k, v] of formData.entries()) {
                    console.log(`${k} = ${v}`);
                }
            })
            .catch(err => {
                console.error(" Error al obtener acta prematrimonial", err);
            });
    }

    function toggleButtonReligion() {
        const select = document.getElementById("mixtareligion");
        const button = document.getElementById("botonMixta");

        // Habilita el botón si el valor del select es "true", de lo contrario lo deshabilita
        button.disabled = select.value === "true";
    }
    function toggleButtonCultos() {
        const select = document.getElementById("disponibilidadcultos");
        const button = document.getElementById("botonCultos");

        // Habilita el botón si el valor del select es "true", de lo contrario lo deshabilita
        button.disabled = select.value === "true";
    }

    document.getElementById("formularioCursillo").addEventListener("submit", function (event) {
        event.preventDefault(); // Evitar el envío del formulario por defecto

        const form = this;
        const formData = new FormData(form);
        const exitoLabel = document.getElementById("exito");

        // Ocultar mensaje anterior (éxito o error)
        exitoLabel.style.display = "none";
        exitoLabel.className = "";

        fetch(form.action, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Mostrar mensaje de éxito
                exitoLabel.textContent = "Acta registrada con éxito";
                exitoLabel.className = "text-success";
                exitoLabel.style.display = "block";

                // Limpiar formulario
                form.reset();
                ListCursillo('');
                buscarCursillos('');

                // Ocultar mensaje después de 3 segundos
                setTimeout(() => {
                    exitoLabel.style.display = "none";
                }, 3000);
            } else {
                // Mostrar errores
                exitoLabel.className = "text-danger";
                if (Array.isArray(data.errors)) {
                    exitoLabel.textContent = data.errors.join(", ");
                } else {
                    exitoLabel.textContent = data.errors || "Error desconocido.";
                }
                exitoLabel.style.display = "block";
            }
        })
        .catch(error => {
            console.error('Error:', error);
            exitoLabel.className = "text-danger";
            exitoLabel.textContent = "Error de conexión o del servidor.";
            exitoLabel.style.display = "block";
        });
    });

    document.getElementById("acta-prematrimonial").addEventListener("submit", function (event) {
        event.preventDefault(); // Evitar el envío del formulario por defecto

        //  Validación previa: ¿se ha seleccionado un cursillo?
        const cursilloId = document.getElementById("cursillo_id").value;
        const alerta = document.getElementById("alertaCursillo"); // El div de alerta tipo Bootstrap

        if (!cursilloId) {
            // Mostrar alerta si no se ha seleccionado cursillo
            alerta.style.display = "block";
            alerta.innerText = "Debes seleccionar un cursillo antes de registrar.";
            return; //  Cancelar el envío
        } else {
            // Ocultar alerta si estaba visible
            alerta.style.display = "none";
        }

        //  Si todo está bien, continuar con el envío
        var formData = new FormData(this);
        fetch(this.action, {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                // Ocultar mensaje de éxito previo
                document.getElementById("exito2").style.display = "none";

                if (data.success) {
                    document.getElementById("exito2").style.display = "block";
                    setTimeout(function () {
                        document.getElementById("exito2").style.display = "none";
                        const inputBuscar = document.getElementById("nombrecompletonino");
                        if (inputBuscar.value.trim().length >= 3) {
                            ListActaPre();
                        }
                    }, 3000);

                    //  Aquí vacías el formulario y campos adicionales
                    document.getElementById("acta-prematrimonial").reset();
                    document.getElementById("cursillo_id").value = "";

                    limpiarBusquedaCursilloActa(); 
                    ListActaPre('');
                    ListActaPreAOfi(''); 
                    // Opcional: Si hay algún mensaje de advertencia que debe ocultarse
                    document.getElementById("mensajeErrorCursillo").style.display = "none";

                } else {
                    document.getElementById("exito").className = "text-danger";
                    document.getElementById("exito").textContent = Array.isArray(data.errors)
                        ? data.errors.join(", ")
                        : (data.errors || "Error desconocido.");
                    document.getElementById("exito").style.display = "block";
                }
            })
            .catch(error => {
                console.error('Error:', error);
                document.getElementById("exito2").innerText = error;
                document.getElementById("exito2").style.display = "block";
            });
    });

