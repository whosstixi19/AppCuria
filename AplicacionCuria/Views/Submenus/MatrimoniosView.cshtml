                                        <label for="Tomo" class="form-label mb-1 fw-semibold small">Tomo</label>
                                        <input type="text" id="Tomo" name="tomo" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <label for="Pagina" class="form-label mb-1 fw-semibold small">Página</label>
                                        <input type="text" id="Pagina" name="pagina" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <label for="Acta" class="form-label mb-1 fw-semibold small">N° Acta</label>
                                        <input type="text" id="Acta" name="acta" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="mb-1">
                                    <label for="FechaRegistroParroquial" class="form-label mb-1 fw-semibold small">Fecha de Registro Parroquial</label>
                                    <input type="date" id="FechaRegistroParroquial" name="fecharegistro" class="form-control form-control-sm" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="Observaciones" class="form-label mb-1 fw-semibold small">Observaciones</label>
                                <textarea id="Observaciones" name="observaciones" class="form-control form-control-sm" rows="2"></textarea>
                            </div>

                            <div class="d-flex justify-content-center gap-2">
                                <button type="submit" class="btn btn-primary btn-sm px-4 mr-2">Registrar Matrimonio Antiguo</button>
                                <button type="reset" class="btn btn-secondary btn-sm px-4">Limpiar</button>
                            </div>
                            <div id="exito4" class="text-success mt-2 text-center fw-semibold small" style="display: none;">Acta antigua Registrada</div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Detalles y búsqueda a la derecha -->
            <div class="col-lg-7 col-md-7">
                <div class="card shadow-sm">
                    <div class="card-body p-3">
                        <h5 class="card-title text-primary fw-bold mb-3">
                            <i class="fas fa-search me-1 text-primary"></i> Búsqueda de Matrimonios Antiguos
                        </h5>
                        <form id="buscar-antiguo" onsubmit="event.preventDefault(); BuscarActasAntiguas();">
                            <div class="mb-3 d-flex">
                                <input type="text" class="form-control form-control-sm me-2 mr-2" id="nombreantiguo" name="nombreantiguo" placeholder="Nombre novio o novia (Ej: Rosa o Antonio)...">
                                <button type="button" class="btn btn-primary btn-sm me-2 mr-2 text-nowrap" onclick="BuscarActasAntiguas()">
                                    <i class="fas fa-search"></i> Buscar
                                </button>
                                <button type="button" class="btn btn-secondary btn-sm text-nowrap" onclick="LimpiarBusquedaActaAntigua()">
                                    Limpiar
                                </button>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-bordered table-hover table-sm text-center align-middle mb-0" style="font-size: 0.86rem; width: 100%;">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Novio</th>
                                            <th>Novia</th>
                                            <th>F. Registro</th>
                                            <th>Modificar</th>
                                            <th>Eliminar</th>
                                        </tr>
                                    </thead>
                                    <tbody id="resultadosActaAntiguas">
                                        @if (Model != null && Model.Any())
                                        {
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@item.nombrenovio</td>
                                                    <td>@item.nombrenovia</td>
                                                    <td>@item.fecharegistro.ToString("dd/MM/yyyy")</td>
                                                    <td>
                                                        <a asp-action="ModifyCursilloMatView" asp-controller="CursilloPreMatrimonial" asp-route-id="@item.id" class="btn btn-warning btn-sm">Actualizar</a>
                                                    </td>
                                                    <td>
                                                        <a asp-action="DeleteCursilloMatView" asp-controller="CursilloPreMatrimonial" asp-route-id="@item.id" class="btn btn-danger btn-sm" id="btnEliminar">Eliminar</a>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="5">No se encontraron resultados.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>

    function buscarCursillos(texto) {
        if (texto === undefined) {
            texto = document.getElementById('busquedaCursillo')?.value || '';
        }
        texto = texto.trim();
        const mensajeError = document.getElementById('mensajeErrorCursillo');
        if (mensajeError) mensajeError.style.display = 'none';

        const url = texto.length > 0 
            ? `/CursilloPreMatrimonial/SearchAprobadoByName?nombrecompleto=${encodeURIComponent(texto)}`
            : `/CursilloPreMatrimonial/SearchAprobado`;

        fetch(url)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Error en la respuesta del servidor');
                }
                return response.json();
            })
            .then(data => {
                const tbody = document.getElementById("tablaCursillos");
                if (!tbody) return;
                tbody.innerHTML = "";

                if (data.length > 0) {
                    data.forEach(item => {
                        const row = `
                            <tr>
                                <td>${item.nombrenovio}</td>
                                <td>${item.nombrenovia}</td>
                                <td>${new Date(item.fechacursillo).toLocaleDateString()}</td>
                                <td><button type="button" class="btn btn-success" onclick="seleccionarCursillo(${item.id})">Seleccionar</button></td>
                            </tr>`;
                        tbody.innerHTML += row;
                    });
                } else {
                    tbody.innerHTML = "<tr><td colspan='4' class='text-center'>No se encontraron cursillos.</td></tr>";
                }
            })
            .catch(error => {
                console.error("Error al buscar cursillos:", error);
                const tbody = document.getElementById("tablaCursillos");
                if (tbody) tbody.innerHTML = `<tr><td colspan='4' class='text-danger text-center'>${error.message}</td></tr>`;
            });
    }

    function limpiarBusquedaCursilloActa() {
        const input = document.getElementById('busquedaCursillo');
        if (input) input.value = '';
        buscarCursillos('');
    }
    
    function seleccionarCursillo(id) {
        fetch(`/CursilloPreMatrimonial/GetById?id=${id}`)
            .then(response => {
                if (!response.ok) {
                    throw new Error("No se pudo obtener el cursillo");
                }
                return response.json();
            })
            .then(data => {
                document.getElementById("cursillo_id").value = id;

                const alerta = document.getElementById("alertaCursillo");
                if (alerta) {
                    alerta.style.display = "none";
                }

                document.getElementById("NombreNovio").value = data.nombrenovio;
                document.getElementById("NombreNovia").value = data.nombrenovia;
                document.getElementById("FechaNacimientoNovio").value = data.fechanacimientonovio ? data.fechanacimientonovio.substring(0, 10) : '';
                document.getElementById("FechaNacimientoNovia").value = data.fechanacimientonovia ? data.fechanacimientonovia.substring(0, 10) : '';
                document.getElementById("FechaMatrimonio").value = data.fechamatrimonio ? data.fechamatrimonio.substring(0, 10) : '';

                mostrarMensajeSeleccion(`Cursillo seleccionado: ${data.nombrenovio} & ${data.nombrenovia}`);
            })
            .catch(error => {
                console.error("Error al obtener los datos del cursillo:", error);
                alert("Hubo un problema al cargar los datos del cursillo.");
            });
    }

    function mostrarMensajeSeleccion(mensaje) {
        let div = document.getElementById("mensajeSeleccion");
        if (!div) {
            div = document.createElement("div");
            div.id = "mensajeSeleccion";
            div.className = "alert alert-success mt-2";
            document.querySelector("body").prepend(div);
        }
        div.innerHTML = mensaje;
        div.style.display = "block";

        setTimeout(() => {
            div.style.display = "none";
        }, 5000);
    }

    function toggleButton() {
        const select = document.getElementById("consanguinidad");
        const button = document.getElementById("printButton");

        // Habilita el botón si el valor del select es "true", de lo contrario lo deshabilita
        button.disabled = select.value === "true";
    }

    function seleccionarActaPreYEnviar(id) {
        fetch(`/ActaMatrimonial/GetById?id=${id}`)
            .then(response => response.json())
            .then(data => {
                console.log(" Datos recibidos:", data);

                // Asignaciones al formulario
                document.getElementById("acta_prematrimonial_id").value = id;
                document.getElementById("hidden_iglesia_id").value = data.iglesia_id ?? '';
                document.getElementById("hidden_ministro_id").value = data.ministro_id ?? '';
                document.getElementById("pagina").value = data.pagina || '';
                document.getElementById("tomo").value = data.tomo || '';
                document.getElementById("fecha_matrimonio").value = data.fechamatrimonio 
                    ? data.fechamatrimonio.substring(0, 10) 
                    : '';
                document.getElementById("errorActaMessage")?.classList.add("d-none");
                // Asignación de acta (esta es la parte importante)
                const inputActa = document.getElementById("input-acta");
                if (inputActa) {
                    inputActa.value = data.acta ?? '';
                    console.log(" Acta cargada:", inputActa.value);
                } else {
                    console.error(" Campo hidden con id='acta' no encontrado en el DOM.");
                }

                console.log(" Datos cargados en el formulario, ahora puedes enviarlo manualmente");

                // Confirmación de lo que se va a enviar
                const formData = new FormData(document.getElementById("form-acta-matrimonial"));
                console.log(" Verificando valores cargados en FormData:");
                for (let [k, v] of formData.entries()) {
                    console.log(`${k} = ${v}`);
                }
            })
            .catch(err => {
                console.error(" Error al obtener acta prematrimonial", err);
            });
    }

    function toggleButtonReligion() {
        const select = document.getElementById("mixtareligion");
        const button = document.getElementById("botonMixta");

        // Habilita el botón si el valor del select es "true", de lo contrario lo deshabilita
        button.disabled = select.value === "true";
    }
    function toggleButtonCultos() {
        const select = document.getElementById("disponibilidadcultos");
        const button = document.getElementById("botonCultos");

        // Habilita el botón si el valor del select es "true", de lo contrario lo deshabilita
        button.disabled = select.value === "true";
    }

    document.getElementById("formularioCursillo").addEventListener("submit", function (event) {
        event.preventDefault(); // Evitar el envío del formulario por defecto

        const form = this;
        const formData = new FormData(form);
        const exitoLabel = document.getElementById("exito");

        // Ocultar mensaje anterior (éxito o error)
        exitoLabel.style.display = "none";
        exitoLabel.className = "";

        fetch(form.action, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Mostrar mensaje de éxito
                exitoLabel.textContent = "Acta registrada con éxito";
                exitoLabel.className = "text-success";
                exitoLabel.style.display = "block";

                // Limpiar formulario
                form.reset();
                ListCursillo('');
                buscarCursillos('');

                // Ocultar mensaje después de 3 segundos
                setTimeout(() => {
                    exitoLabel.style.display = "none";
                }, 3000);
            } else {
                // Mostrar errores
                exitoLabel.className = "text-danger";
                if (Array.isArray(data.errors)) {
                    exitoLabel.textContent = data.errors.join(", ");
                } else {
                    exitoLabel.textContent = data.errors || "Error desconocido.";
                }
                exitoLabel.style.display = "block";
            }
        })
        .catch(error => {
            console.error('Error:', error);
            exitoLabel.className = "text-danger";
            exitoLabel.textContent = "Error de conexión o del servidor.";
            exitoLabel.style.display = "block";
        });
    });

    document.getElementById("acta-prematrimonial").addEventListener("submit", function (event) {
        event.preventDefault(); // Evitar el envío del formulario por defecto

        //  Validación previa: ¿se ha seleccionado un cursillo?
        const cursilloId = document.getElementById("cursillo_id").value;
        const alerta = document.getElementById("alertaCursillo"); // El div de alerta tipo Bootstrap

        if (!cursilloId) {
            // Mostrar alerta si no se ha seleccionado cursillo
            alerta.style.display = "block";
            alerta.innerText = "Debes seleccionar un cursillo antes de registrar.";
            return; //  Cancelar el envío
        } else {
            // Ocultar alerta si estaba visible
            alerta.style.display = "none";
        }

        //  Si todo está bien, continuar con el envío
        var formData = new FormData(this);
        fetch(this.action, {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                // Ocultar mensaje de éxito previo
                document.getElementById("exito2").style.display = "none";

                if (data.success) {
                    document.getElementById("exito2").style.display = "block";
                    setTimeout(function () {
                        document.getElementById("exito2").style.display = "none";
                        const inputBuscar = document.getElementById("nombrecompletonino");
                        if (inputBuscar.value.trim().length >= 3) {
                            ListActaPre();
                        }
                    }, 3000);

                    //  Aquí vacías el formulario y campos adicionales
                    document.getElementById("acta-prematrimonial").reset();
                    document.getElementById("cursillo_id").value = "";

                    limpiarBusquedaCursilloActa(); 
                    ListActaPre('');
                    ListActaPreAOfi(''); 
                    // Opcional: Si hay algún mensaje de advertencia que debe ocultarse
                    document.getElementById("mensajeErrorCursillo").style.display = "none";

                } else {
                    document.getElementById("exito").className = "text-danger";
                    document.getElementById("exito").textContent = Array.isArray(data.errors)
                        ? data.errors.join(", ")
                        : (data.errors || "Error desconocido.");
                    document.getElementById("exito").style.display = "block";
                }
            })
            .catch(error => {
                console.error('Error:', error);
                document.getElementById("exito2").innerText = error;
                document.getElementById("exito2").style.display = "block";
            });
    });

    document.getElementById("form-acta-matrimonial").addEventListener("submit", function (event) {
        event.preventDefault();

        // Validar selección de acta prematrimonial
        const actaPrematrimonialId = document.getElementById("acta_prematrimonial_id").value;
        const errorDiv = document.getElementById("errorActaMessage");

        if (!actaPrematrimonialId) {
            errorDiv.classList.remove("d-none"); // Mostrar mensaje de error
            return; // No enviar formulario
        } else {
            errorDiv.classList.add("d-none"); // Ocultar mensaje si ya se seleccionó
        }

        // Asegúrate que el valor de acta está actualizado
        const actaInput = document.getElementById("acta");
        console.log(" Valor del campo acta antes de enviar:", actaInput.value);

        // Crear FormData con los valores actuales del formulario
        const formData = new FormData(this);

        fetch(this.action, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            document.getElementById("exito3").style.display = "none";

            if (data.success) {
                document.getElementById("exito3").style.display = "block";
                setTimeout(() => {
                    document.getElementById("exito3").style.display = "none";
                }, 3000);
                this.reset();
                limpiarBusquedaActaPrematrimonial();
                ListActaCreada('');
            } else {
                console.error(" Errores en la validación:", data.errors);
                errorDiv.textContent = "Hubo un error al registrar el acta. Verifica los campos.";
                errorDiv.classList.remove("d-none");
            }
        })
        .catch(error => {
            console.error(' Error inesperado:', error);
            errorDiv.textContent = "Error inesperado al enviar el formulario.";
            errorDiv.classList.remove("d-none");
        });
    });

    fetch("/ActasAntiguas/GetMinistros")
        .then(res => res.json())
        .then(data => {
            const select = document.getElementById("ministro_id");
            data.forEach(ministro => {
                const option = document.createElement("option");
                option.value = ministro.id;
                option.textContent = ministro.nombre;
                select.appendChild(option);
            });
        })
        .catch(error => console.error("Error al cargar ministros:", error));

    //  Esto llena el SELECT de iglesias dinámicamente
    fetch("/ActasAntiguas/GetIglesias")
        .then(res => res.json())
        .then(data => {
            const select = document.getElementById("iglesia_id");
            data.forEach(iglesia => {
                const option = document.createElement("option");
                option.value = iglesia.id;
                option.textContent = iglesia.nombre;
                select.appendChild(option);
            });
        })
        .catch(error => console.error("Error al cargar iglesias:", error));

    fetch("/ActasAntiguas/GetMinistros")
        .then(res => res.json())
        .then(data => {
            const select = document.getElementById("ministro_id_antiguo");
            select.innerHTML = '<option value="">Seleccione un ministro</option>';
            data.forEach(ministro => {
                const option = document.createElement("option");
                option.value = ministro.id;
                option.textContent = ministro.nombre;
                select.appendChild(option);
            });
        });

    fetch("/ActasAntiguas/GetIglesias")
        .then(res => res.json())
        .then(data => {
            const select = document.getElementById("iglesia_id_antiguo");
            select.innerHTML = '<option value="">Seleccione una iglesia</option>';
            data.forEach(iglesia => {
                const option = document.createElement("option");
                option.value = iglesia.id;
                option.textContent = iglesia.nombre;
                select.appendChild(option);
            });
        });
    

    //  Esto es tu script para enviar el formulario
    document.getElementById("acta-antig").addEventListener("submit", function (event) {
        event.preventDefault();
        console.log(this.action);
        
        const form = this;
        const formData = new FormData(form);

        fetch(form.action, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            document.getElementById("exito4").style.display = "none";

            if (data.success) {
                // Mostrar mensaje de éxito
                document.getElementById("exito4").style.display = "block";
                document.getElementById("exito4").textContent = "Acta antigua registrada correctamente.";

                // Limpiar el formulario
                form.reset();
                BuscarActasAntiguas('');

                // Ocultar mensaje luego de 3 segundos
                setTimeout(function () {
                    document.getElementById("exito4").style.display = "none";
                }, 3000);
            }
            else {
                document.getElementById("exito").className = "text-danger";
                if (Array.isArray(data.errors)) {
                    document.getElementById("exito").textContent = data.errors.join(", ");
                } else {
                    document.getElementById("exito").textContent = data.errors || "Error desconocido.";
                }
                document.getElementById("exito").style.display = "block";
            }
        })
        .catch(error => {
            console.error('Error:', error);
            document.getElementById("exito4").innerText = error;
            document.getElementById("exito4").style.display = "block";
        });
    });

    function ListCursillo(nombre) {
        if (nombre === undefined) {
            nombre = document.getElementById('nombrecompleto')?.value || '';
        }
        nombre = nombre.trim();
        const resultadosBody = document.getElementById('resultadosCursillo');
        if (!resultadosBody) return;

        fetch(`/CursilloPreMatrimonial/SearchByName?nombrecompleto=${encodeURIComponent(nombre)}`)
            .then(response => response.json())
            .then(data => {
                resultadosBody.innerHTML = ""; // Limpiar resultados anteriores

                if (data.length > 0) {
                    data.forEach(item => {
                        const row = `
                            <tr>
                                <td>${item.nombrenovio}</td>
                                <td>${item.nombrenovia}</td>
                                <td>${new Date(item.fechacursillo).toLocaleDateString()}</td>
                                <td>${new Date(item.fechamatrimonio).toLocaleDateString()}</td>
                                <td>${item.estado}</td>
                                <td><a href="/CursilloPreMatrimonial/ModifyCursilloMatView/${item.id}" class="btn btn-warning">Actualizar</a></td>
                                <td><a href="/CursilloPreMatrimonial/DeleteCursilloMatView/${item.id}" class="btn btn-danger">Eliminar</a></td>
                            </tr>`;
                        resultadosBody.innerHTML += row;
                    });
                } else {
                    resultadosBody.innerHTML = "<tr><td colspan='7' class='text-center'>No se encontraron resultados.</td></tr>";
                }
            })
            .catch(error => {
                console.error('Error en la búsqueda:', error);
                resultadosBody.innerHTML = "<tr><td colspan='7' class='text-danger text-center'>Error al realizar la búsqueda.</td></tr>";
            });
    }

    document.getElementById('busquedaCursillo')?.addEventListener('input', () => {
        const errorCursillo = document.getElementById('mensajeErrorCursillo');
        if (errorCursillo) errorCursillo.style.display = 'none';
    });

    function limpiarBusquedaCursilloGeneral() {
        document.getElementById("nombrecompleto").value = "";
        ListCursillo('');
    }

    function LimpiarBusqueda() {
        document.getElementById('nombrecompletonino').value = '';
        ListActaPre('');
    }

    function ListActaPre(nombre) {
        if (nombre === undefined) {
            nombre = document.getElementById('nombrecompletonino')?.value || '';
        }
        nombre = nombre.trim();
        const mensajeError = document.getElementById('mensajeErrorNombre');
        if (mensajeError) mensajeError.style.display = 'none';

        fetch(`/ActaPrematrimonial/SearchByName?nombrecompleto=${encodeURIComponent(nombre)}`)
            .then(response => response.json())
            .then(data => {
                const resultados = document.getElementById('resultadosActas');
                if (!resultados) return;
                resultados.innerHTML = '';

                if (data.length > 0) {
                    data.forEach(item => {
                        resultados.innerHTML += `
                            <tr>
                                <td>${item.nombrenovio}</td>
                                <td>${item.nombrenovia}</td>
                                <td>${new Date(item.fechamatrimonio).toLocaleDateString()}</td>
                                <td>${item.estado}</td>
                                <td><a href="/ActaPrematrimonial/ModifyActaPrematrimonialView/${item.id}" class="btn btn-warning">Actualizar</a></td>
                                <td><a href="/ActaPrematrimonial/DeleteActaPrematrimonialView/${item.id}" class="btn btn-danger">Eliminar</a></td>
                            </tr>`;         
                    });
                } else {
                    resultados.innerHTML = '<tr><td colspan="7">No se encontraron resultados.</td></tr>';
                }
            })
            .catch(error => {
                console.error('Error al buscar actas:', error);
            });
    }

    document.getElementById('nombrecompletonino')?.addEventListener('input', () => {
        const msg = document.getElementById('mensajeErrorNombre');
        if (msg) msg.style.display = 'none';
    });

    function ListActaPreAOfi(nombre) {
        if (nombre === undefined) {
            nombre = document.getElementById('nombreBuscar')?.value || '';
        }
        nombre = nombre.trim();
        const resultadosBody = document.getElementById('resultadosActa');
        if (!resultadosBody) return;

        fetch(`/ActaMatrimonial/BuscarPorNombre?nombre=${encodeURIComponent(nombre)}`)
            .then(response => response.json())
            .then(data => {
                resultadosBody.innerHTML = "";

                if (data.length > 0) {
                    data.forEach(item => {
                        const row = `
                            <tr>
                                <td>${item.nombreNovio}</td>
                                <td>${item.nombreNovia}</td>
                                <td>${new Date(item.fechaMatrimonio).toLocaleDateString()}</td>
                                <td><button type="button" onclick="seleccionarActaPreYEnviar(${item.id})" class="btn btn-success">Seleccionar</button></td>
                            </tr>`;
                        resultadosBody.innerHTML += row;
                    });
                } else {
                    resultadosBody.innerHTML = "<tr><td colspan='4'>No se encontraron resultados.</td></tr>";
                }
            })
            .catch(error => {
                console.error('Error en la búsqueda:', error);
                resultadosBody.innerHTML = "<tr><td colspan='4'>Ocurrió un error al buscar.</td></tr>";
            });
    }

    function limpiarBusquedaActaPrematrimonial() {
        document.getElementById('nombreBuscar').value = "";
        ListActaPreAOfi('');
    }

    function ListActaCreada(nombre) {
        if (nombre === undefined) {
            nombre = document.getElementById('fechacasadosreg')?.value || '';
        }
        nombre = nombre.trim();
        const resultadosBody = document.getElementById("resultadosActaCreadas");
        if (!resultadosBody) return;

        fetch(`/ActaMatrimonial/BuscarPorNombreMatrimoniales?nombre=${encodeURIComponent(nombre)}`)
            .then(response => response.json())
            .then(data => {
                resultadosBody.innerHTML = "";

                if (data.length > 0) {
                    data.forEach(item => {
                        const row = `
                            <tr>
                                <td>${item.nombreNovio}</td>
                                <td>${item.nombreNovia}</td>
                                <td>${item.padrino1}</td>
                                <td>${item.padrino2}</td>
                                <td>${new Date(item.fechaRegistro).toLocaleDateString()}</td>
                                <td><a href="/ActaMatrimonial/ModifyActamatrimonialView/${item.id}" class="btn btn-warning">Actualizar</a></td>
                                <td><a href="/ActaMatrimonial/DeleteActamatrimonialView/${item.id}" class="btn btn-danger">Eliminar</a></td>
                            </tr>`;
                        resultadosBody.innerHTML += row;
                    });
                } else {
                    resultadosBody.innerHTML = "<tr><td colspan='7'>No se encontraron resultados.</td></tr>";
                }
            })
            .catch(error => {
                console.error('Error en la búsqueda:', error);
                resultadosBody.innerHTML = "<tr><td colspan='7'>Ocurrió un error al buscar.</td></tr>";
            });
    }

    function limpiarBusquedaCreadas() {
        document.getElementById('fechacasadosreg').value = "";
        ListActaCreada('');
    }

    function BuscarActasAntiguas(nombre) {
        if (nombre === undefined) {
            nombre = document.getElementById('nombreantiguo')?.value || '';
        }
        nombre = nombre.trim();
        const resultadosBody = document.getElementById('resultadosActaAntiguas');
        if (!resultadosBody) return;

        fetch(`/ActasAntiguas/SearchByNames?nombrecompleto=${encodeURIComponent(nombre)}`)
            .then(response => response.json())
            .then(data => {
                resultadosBody.innerHTML = "";

                if (data.length > 0) {
                    data.forEach(item => {
                        const row = `
                            <tr>
                                <td>${item.nombrenovio}</td>
                                <td>${item.nombrenovia}</td>
                                <td>${new Date(item.fechamatrimonio || item.fecharegistro).toLocaleDateString()}</td>
                                <td><a href="/ActasAntiguas/ModifyActasAntiguasView/${item.id}" class="btn btn-warning">Actualizar</a></td>
                                <td><a href="/ActasAntiguas/DeleteActasAntiguasView/${item.id}" class="btn btn-danger" id="btnEliminar">Eliminar</a></td>
                            </tr>`;
                        resultadosBody.innerHTML += row;
                    });
                } else {
                    resultadosBody.innerHTML = "<tr><td colspan='6'>No se encontraron resultados.</td></tr>";
                }
            })
            .catch(error => {
                console.error('Error en la búsqueda:', error);
                resultadosBody.innerHTML = "<tr><td colspan='6'> Error al buscar.</td></tr>";
            });
    }

    function LimpiarBusquedaActaAntigua() {
        document.getElementById("nombreantiguo").value = "";
        BuscarActasAntiguas('');
    }

    document.addEventListener("DOMContentLoaded", function () {
        cargarParroquiasMatrimonio();
        ListCursillo('');
        buscarCursillos('');
        ListActaPre('');
        ListActaPreAOfi('');
        ListActaCreada('');
        BuscarActasAntiguas('');
    });
</script>