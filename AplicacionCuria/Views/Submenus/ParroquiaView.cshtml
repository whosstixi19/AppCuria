@{
    ViewData["Title"] = "Gestión de Parroquias";
    Layout = "_Layout";
}

<div class="container-fluid px-2">
    <h2 class="text-center mb-4">Gestión de Parroquias</h2>

    <div class="row justify-content-center align-items-start g-3">
        <!-- Formulario compacto y centrado -->
        <div class="col-lg-4 col-md-5">
            <div class="card shadow-sm">
                <div class="card-body p-3">
                    <form id="formParroquia">
                        <input type="hidden" id="id" name="id" value="0" />
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="nombre" class="form-label mb-1 fw-semibold">Nombre</label>
                                <input class="form-control form-control-sm" id="nombre" name="nombre" required maxlength="255" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="telefono" class="form-label mb-1 fw-semibold">Teléfono</label>
                                <input class="form-control form-control-sm" id="telefono" name="telefono" maxlength="20" />
                            </div>
                        </div>

                        <div class="mb-2">
                            <label for="email" class="form-label mb-1 fw-semibold">Correo electrónico</label>
                            <input type="email" class="form-control form-control-sm" id="email" name="email" maxlength="255" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="sacerdote_id" class="form-label mb-1 fw-semibold">Sacerdote</label>
                                <select class="form-control form-control-sm" id="sacerdote_id" name="sacerdote_id">
                                    <option value="">Seleccione un sacerdote</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="estado" class="form-label mb-1 fw-semibold">Estado</label>
                                <select class="form-control form-control-sm" id="estado" name="estado">
                                    <option value="ACTIVO">ACTIVO</option>
                                    <option value="INACTIVO">INACTIVO</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label for="direccion" class="form-label mb-1 fw-semibold">Dirección</label>
                            <textarea class="form-control form-control-sm" id="direccion" name="direccion" rows="2"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="observaciones" class="form-label mb-1 fw-semibold">Observaciones</label>
                            <textarea class="form-control form-control-sm" id="observaciones" name="observaciones" rows="2"></textarea>
                        </div>

                        <div class="d-flex justify-content-center gap-2">
                            <button type="submit" class="btn btn-primary btn-sm px-4 mr-2">Registrar</button>
                            <button type="button" class="btn btn-secondary btn-sm px-4" id="btnNuevo">Limpiar</button>
                        </div>
                    </form>
                    <div id="msgParroquia" class="mt-2 text-center fw-semibold"></div>
                </div>
            </div>
        </div>

        <!-- Tabla centrada y ajustada al 100% -->
        <div class="col-lg-8 col-md-7">
            <div class="card shadow-sm">
                <div class="card-body p-3">
                    <div class="mb-3">
                        <input type="text" id="busquedaParroquia" class="form-control form-control-sm" placeholder="Buscar por nombre..." />
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-sm text-center align-middle mb-0" style="font-size: 0.86rem; width: 100%;">
                            <thead class="thead-light">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Dirección</th>
                                    <th>Teléfono</th>
                                    <th>Email</th>
                                    <th>Sacerdote</th>
                                    <th>Estado</th>
                                    <th>Observaciones</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tablaParroquias">
                                <!-- Se llena por JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script>
        $(function () {
            cargarSacerdotes();
            cargarParroquias();

            $("#busquedaParroquia").on("input", function () {
                buscarParroquias($(this).val());
            });

            $("#formParroquia").submit(function (e) {
                e.preventDefault();
                let id = $("#id").val();
                let url = id == 0 ? "/Parroquias/Create" : "/Parroquias/Edit/" + id;
                let data = {
                    id: id,
                    nombre: $("#nombre").val(),
                    direccion: $("#direccion").val(),
                    telefono: $("#telefono").val(),
                    email: $("#email").val(),
                    sacerdote_id: $("#sacerdote_id").val(),
                    estado: $("#estado").val(),
                    observaciones: $("#observaciones").val()
                };
                $.post(url, data, function (res) {
                    if (res.success) {
                        cargarParroquias();
                        limpiarFormulario();
                        mostrarMsg("Parroquia guardada correctamente.", true);
                    } else {
                        mostrarMsg(res.message || "Error al guardar.", false);
                    }
                });
            });

            $("#btnNuevo").click(function () {
                limpiarFormulario();
                cargarSacerdotes();
            });
        });

        function cargarParroquias() {
            $.get("/Parroquias/GetParroquias", function (data) {
                renderTabla(data);
            });
        }

        function buscarParroquias(nombre) {
            if (!nombre) {
                cargarParroquias();
                return;
            }
            $.get("/Parroquias/SearchByName", { nombre: nombre }, function (data) {
                renderTabla(data);
            });
        }

        function cargarSacerdotes() {
            $.get("/Parroquias/GetSacerdotesDisponibles", function (data) {
                let options = '<option value="">Seleccione un sacerdote</option>';
                data.forEach(function (s) {
                    options += `<option value="${s.id}">${s.nombre}</option>`;
                });
                $("#sacerdote_id").html(options);
            });
        }

        function renderTabla(data) {
            let html = "";
            data.forEach(function (p) {
                html += `<tr>
                    <td>${p.nombre}</td>
                    <td>${p.direccion ?? ""}</td>
                    <td>${p.telefono ?? ""}</td>
                    <td>${p.email ?? ""}</td>
                    <td>${p.sacerdote_nombre ?? ""}</td>
                    <td>${p.estado ?? ""}</td>
                    <td>${p.observaciones ?? ""}</td>
                    <td>
                        <button class="btn btn-warning btn-sm" onclick="editarParroquia(${p.id})">Editar</button>
                        <button class="btn btn-danger btn-sm" onclick="eliminarParroquia(${p.id})">Eliminar</button>
                    </td>
                </tr>`;
            });
            $("#tablaParroquias").html(html);
        }

        function editarParroquia(id) {
            $.get("/Parroquias/GetParroquias", function (data) {
                let parroquia = data.find(p => p.id === id);
                if (parroquia) {
                    $("#id").val(parroquia.id);
                    $("#nombre").val(parroquia.nombre);
                    $("#direccion").val(parroquia.direccion);
                    $("#telefono").val(parroquia.telefono);
                    $("#email").val(parroquia.email);
                    cargarSacerdotes();
                    setTimeout(function () {
                        $("#sacerdote_id").val(parroquia.sacerdote_id);
                    }, 200);
                    $("#estado").val(parroquia.estado);
                    $("#observaciones").val(parroquia.observaciones);
                }
            });
        }

        function eliminarParroquia(id) {
            if (confirm("¿Seguro que deseas eliminar esta parroquia?")) {
                $.post("/Parroquias/DeleteConfirmed", { id: id }, function (res) {
                    if (res.success) {
                        cargarParroquias();
                        mostrarMsg("Parroquia eliminada.", true);
                    } else {
                        mostrarMsg("No se pudo eliminar.", false);
                    }
                });
            }
        }

        function limpiarFormulario() {
            $("#id").val(0);
            $("#nombre").val("");
            $("#direccion").val("");
            $("#telefono").val("");
            $("#email").val("");
            $("#sacerdote_id").val("");
            $("#estado").val("ACTIVO");
            $("#observaciones").val("");
        }

        function mostrarMsg(msg, exito) {
            $("#msgParroquia").text(msg).removeClass().addClass(exito ? "text-success" : "text-danger");
            setTimeout(() => { $("#msgParroquia").text(""); }, 3000);
        }
    </script>
}