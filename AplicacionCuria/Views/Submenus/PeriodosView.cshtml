@{
    ViewData["Title"] = "Gestión de Periodos";
    Layout = "_Layout";
}

<div class="container-fluid px-2">
    <h2 class="text-center mb-4">Gestión de Periodos</h2>

    <div class="row justify-content-center align-items-start g-3">
        <div class="col-lg-4 col-md-5">
            <div class="card shadow-sm">
                <div class="card-body p-3">
                    <form id="formPeriodo">
                        <input type="hidden" id="id" name="id" value="0" />
                        <div class="mb-2">
                            <label for="nombre" class="form-label mb-1 fw-semibold">Nombre</label>
                            <input class="form-control form-control-sm" id="nombre" name="nombre" required />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="fecha_inicio" class="form-label mb-1 fw-semibold">Fecha Inicio</label>
                                <input type="date" class="form-control form-control-sm" id="fecha_inicio" name="fecha_inicio" required />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="fecha_fin" class="form-label mb-1 fw-semibold">Fecha Fin</label>
                                <input type="date" class="form-control form-control-sm" id="fecha_fin" name="fecha_fin" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="observaciones" class="form-label mb-1 fw-semibold">Observaciones</label>
                            <textarea class="form-control form-control-sm" id="observaciones" name="observaciones" rows="2"></textarea>
                        </div>
                        <div class="d-flex justify-content-center gap-2">
                            <button type="submit" class="btn btn-primary btn-sm px-4 mr-2">Registrar</button>
                            <button type="button" class="btn btn-secondary btn-sm px-4" id="btnNuevo">Nuevo</button>
                        </div>
                    </form>
                    <div id="msgPeriodo" class="mt-2 text-center fw-semibold"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-8 col-md-7">
            <div class="card shadow-sm">
                <div class="card-body p-3">
                    <div class="mb-3">
                        <input type="text" id="busquedaPeriodo" class="form-control form-control-sm" placeholder="Buscar por nombre..." />
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-sm text-center align-middle mb-0" style="font-size: 0.86rem; width: 100%;">
                            <thead class="thead-light">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Fecha Inicio</th>
                                    <th>Fecha Fin</th>
                                    <th>Estado</th>
                                    <th>Observaciones</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tablaPeriodos">
                                <!-- Se llena por JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script>
        $(function () {
            cargarPeriodos();

            $("#busquedaPeriodo").on("input", function () {
                buscarPeriodos($(this).val());
            });

            $("#formPeriodo").submit(function (e) {
                e.preventDefault();
                let id = $("#id").val();
                let url = id == 0 ? "/Periodos/Create" : "/Periodos/Edit/" + id;
                let data = {
                    id: id,
                    nombre: $("#nombre").val(),
                    fecha_inicio: $("#fecha_inicio").val(),
                    fecha_fin: $("#fecha_fin").val(),
                    observaciones: $("#observaciones").val()
                };
                $.post(url, data, function (res) {
                    if (res.success) {
                        cargarPeriodos();
                        limpiarFormulario();
                        mostrarMsg("Periodo guardado correctamente.", true);
                    } else {
                        mostrarMsg("Error al guardar.", false);
                    }
                });
            });

            $("#btnNuevo").click(function () {
                limpiarFormulario();
            });
        });

        function cargarPeriodos() {
            $.get("/Periodos/Search", function (data) {
                renderTabla(data);
            });
        }

        function buscarPeriodos(nombre) {
            if (!nombre) {
                cargarPeriodos();
                return;
            }
            $.get("/Periodos/SearchByName", { nombre: nombre }, function (data) {
                renderTabla(data);
            });
        }

        function renderTabla(data) {
            let html = "";
            data.forEach(function (p) {
                html += `<tr>
                    <td>${p.nombre}</td>
                    <td>${(p.fecha_inicio || "").substring(0,10)}</td>
                    <td>${(p.fecha_fin || "").substring(0,10)}</td>
                    <td>${p.estado ?? ""}</td>
                    <td>${p.observaciones ?? ""}</td>
                    <td>
                        <button class="btn btn-warning btn-sm" onclick="editarPeriodo(${p.id})">Editar</button>
                        <button class="btn btn-danger btn-sm" onclick="eliminarPeriodo(${p.id})">Eliminar</button>
                    </td>
                </tr>`;
            });
            $("#tablaPeriodos").html(html);
        }

        function editarPeriodo(id) {
            $.get("/Periodos/ModifyPeriodoView", { id: id }, function (data) {
                $("#id").val(data.id);
                $("#nombre").val(data.nombre);
                $("#fecha_inicio").val((data.fecha_inicio || "").substring(0,10));
                $("#fecha_fin").val((data.fecha_fin || "").substring(0,10));
                $("#observaciones").val(data.observaciones);
            });
        }

        function eliminarPeriodo(id) {
            if (confirm("¿Seguro que deseas eliminar este periodo?")) {
                $.post("/Periodos/DeleteConfirmed", { id: id }, function (res) {
                    if (res.success) {
                        cargarPeriodos();
                        mostrarMsg("Periodo eliminado.", true);
                    } else {
                        mostrarMsg("No se pudo eliminar.", false);
                    }
                });
            }
        }

        function limpiarFormulario() {
            $("#id").val(0);
            $("#nombre").val("");
            $("#fecha_inicio").val("");
            $("#fecha_fin").val("");
            $("#observaciones").val("");
        }

        function mostrarMsg(msg, exito) {
            $("#msgPeriodo").text(msg).removeClass().addClass(exito ? "text-success" : "text-danger");
            setTimeout(() => { $("#msgPeriodo").text(""); }, 3000);
        }
    </script>
}