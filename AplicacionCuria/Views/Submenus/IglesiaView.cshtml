@{
    ViewData["Title"] = "Gestión de Iglesias";
    Layout = "_Layout";
}

<div class="container-fluid px-2">
    <h2 class="text-center mb-4">Gestión de Iglesias</h2>

    <div class="row justify-content-center align-items-start g-3">
        <!-- Formulario compacto y centrado a 2 columnas internas -->
        <div class="col-lg-4 col-md-5">
            <div class="card shadow-sm">
                <div class="card-body p-3">
                    <form id="formIglesia">
                        <input type="hidden" id="id" name="id" value="0" />
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="nombre" class="form-label mb-1 fw-semibold">Nombre</label>
                                <input class="form-control form-control-sm" id="nombre" name="nombre" required maxlength="255" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="ciudad" class="form-label mb-1 fw-semibold">Ciudad</label>
                                <input class="form-control form-control-sm" id="ciudad" name="ciudad" maxlength="255" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="direccion" class="form-label mb-1 fw-semibold">Dirección</label>
                                <input class="form-control form-control-sm" id="direccion" name="direccion" maxlength="255" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="telefono" class="form-label mb-1 fw-semibold">Teléfono</label>
                                <input class="form-control form-control-sm" id="telefono" name="telefono" maxlength="20" />
                            </div>
                        </div>

                        <div class="mb-2">
                            <label for="email" class="form-label mb-1 fw-semibold">Correo electrónico</label>
                            <input type="email" class="form-control form-control-sm" id="email" name="email" maxlength="255" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="ministro_id" class="form-label mb-1 fw-semibold">Ministro</label>
                                <select class="form-control form-control-sm" id="ministro_id" name="ministro_id">
                                    <option value="">Seleccione un ministro</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="parroquia_id" class="form-label mb-1 fw-semibold">Parroquia</label>
                                <select class="form-control form-control-sm" id="parroquia_id" name="parroquia_id">
                                    <option value="">Seleccione una parroquia</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="denominacion" class="form-label mb-1 fw-semibold">Denominación</label>
                                <input class="form-control form-control-sm" id="denominacion" name="denominacion" maxlength="255" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="estado" class="form-label mb-1 fw-semibold">Estado</label>
                                <select class="form-control form-control-sm" id="estado" name="estado">
                                    <option value="ACTIVO">ACTIVO</option>
                                    <option value="INACTIVO">INACTIVO</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="observaciones" class="form-label mb-1 fw-semibold">Observaciones</label>
                            <textarea class="form-control form-control-sm" id="observaciones" name="observaciones" rows="2"></textarea>
                        </div>

                        <div class="d-flex justify-content-center gap-2">
                            <button type="submit" class="btn btn-primary btn-sm px-4 mr-2">Registrar</button>
                            <button type="button" class="btn btn-secondary btn-sm px-4" id="btnLimpiarIglesia">Limpiar</button>
                        </div>
                    </form>
                    <div id="msgIglesia" class="mt-2 text-center fw-semibold"></div>
                </div>
            </div>
        </div>

        <!-- Tabla centrada y ajustada al 100% sin desplazamiento lateral -->
        <div class="col-lg-8 col-md-7">
            <div class="card shadow-sm">
                <div class="card-body p-3">
                    <div class="mb-3">
                        <input type="text" id="busquedaIglesia" class="form-control form-control-sm" placeholder="Buscar por nombre..." />
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-sm text-center align-middle mb-0" style="font-size: 0.86rem; width: 100%;">
                            <thead class="thead-light">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Dirección</th>
                                    <th>Ciudad</th>
                                    <th>Teléfono</th>
                                    <th>Email</th>
                                    <th>Ministro</th>
                                    <th>Parroquia</th>
                                    <th>Denominación</th>
                                    <th>Estado</th>
                                    <th>Observaciones</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tablaIglesias">
                                <!-- Se llena por JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script>
        $(function () {
            cargarMinistros();
            cargarParroquias();
            cargarIglesias();

            $("#busquedaIglesia").on("input", function () {
                buscarIglesias($(this).val());
            });

            $("#formIglesia").submit(function (e) {
                e.preventDefault();
                let id = $("#id").val();
                let url = id == 0 ? "/Iglesia/Create" : "/Iglesia/Edit/" + id;
                let data = {
                    id: id,
                    nombre: $("#nombre").val(),
                    direccion: $("#direccion").val(),
                    ciudad: $("#ciudad").val(),
                    telefono: $("#telefono").val(),
                    email: $("#email").val(),
                    ministro_id: $("#ministro_id").val(),
                    parroquia_id: $("#parroquia_id").val(),
                    denominacion: $("#denominacion").val(),
                    estado: $("#estado").val(),
                    observaciones: $("#observaciones").val()
                };
                $.post(url, data, function (res) {
                    if (res.success) {
                        cargarIglesias();
                        limpiarFormularioIglesia();
                        mostrarMsgIglesia("Iglesia guardada correctamente.", true);
                    } else {
                        mostrarMsgIglesia(res.message || "Error al guardar.", false);
                    }
                });
            });

            $("#btnLimpiarIglesia").click(function () {
                limpiarFormularioIglesia();
                cargarMinistros();
                cargarParroquias();
            });
        });

        function cargarIglesias() {
            $.get("/Iglesia/GetIglesias", function (data) {
                renderTablaIglesias(data);
            });
        }

        function buscarIglesias(nombre) {
            if (!nombre) {
                cargarIglesias();
                return;
            }
            $.get("/Iglesia/SearchByName", { nombre: nombre }, function (data) {
                renderTablaIglesias(data);
            });
        }

        function cargarMinistros() {
            $.get("/Iglesia/GetMinistrosDisponibles", function (data) {
                let options = '<option value="">Seleccione un ministro</option>';
                data.forEach(function (m) {
                    options += `<option value="${m.id}">${m.nombre}</option>`;
                });
                $("#ministro_id").html(options);
            });
        }

        function cargarParroquias() {
            $.get("/Iglesia/GetParroquiasDisponibles", function (data) {
                let options = '<option value="">Seleccione una parroquia</option>';
                data.forEach(function (p) {
                    options += `<option value="${p.id}">${p.nombre}</option>`;
                });
                $("#parroquia_id").html(options);
            });
        }

        function renderTablaIglesias(data) {
            let html = "";
            data.forEach(function (i) {
                html += `<tr>
                    <td>${i.nombre}</td>
                    <td>${i.direccion ?? ""}</td>
                    <td>${i.ciudad ?? ""}</td>
                    <td>${i.telefono ?? ""}</td>
                    <td class="text-break">${i.email ?? ""}</td>
                    <td>${i.ministro_nombre ?? ""}</td>
                    <td>${i.parroquia_nombre ?? ""}</td>
                    <td>${i.denominacion ?? ""}</td>
                    <td>${i.estado ?? ""}</td>
                    <td>${i.observaciones ?? ""}</td>
                    <td class="text-nowrap">
                        <button class="btn btn-warning btn-sm py-0 px-2" onclick="editarIglesia(${i.id})">Editar</button>
                        <button class="btn btn-danger btn-sm py-0 px-2" onclick="eliminarIglesia(${i.id})">Eliminar</button>
                    </td>
                </tr>`;
            });
            $("#tablaIglesias").html(html);
        }

        function editarIglesia(id) {
            $.get("/Iglesia/GetIglesias", function (data) {
                let iglesia = data.find(i => i.id === id);
                if (iglesia) {
                    $("#id").val(iglesia.id);
                    $("#nombre").val(iglesia.nombre);
                    $("#direccion").val(iglesia.direccion);
                    $("#ciudad").val(iglesia.ciudad);
                    $("#telefono").val(iglesia.telefono);
                    $("#email").val(iglesia.email);
                    cargarMinistros();
                    cargarParroquias();
                    setTimeout(function () {
                        $("#ministro_id").val(iglesia.ministro_id);
                        $("#parroquia_id").val(iglesia.parroquia_id);
                    }, 200);
                    $("#denominacion").val(iglesia.denominacion);
                    $("#estado").val(iglesia.estado);
                    $("#observaciones").val(iglesia.observaciones);
                }
            });
        }

        function eliminarIglesia(id) {
            if (confirm("¿Seguro que deseas eliminar esta iglesia?")) {
                $.post("/Iglesia/DeleteConfirmed", { id: id }, function (res) {
                    if (res.success) {
                        cargarIglesias();
                        mostrarMsgIglesia("Iglesia eliminada.", true);
                    } else {
                        mostrarMsgIglesia("No se pudo eliminar.", false);
                    }
                });
            }
        }

        function limpiarFormularioIglesia() {
            $("#id").val(0);
            $("#nombre").val("");
            $("#direccion").val("");
            $("#ciudad").val("");
            $("#telefono").val("");
            $("#email").val("");
            $("#ministro_id").val("");
            $("#parroquia_id").val("");
            $("#denominacion").val("");
            $("#estado").val("ACTIVO");
            $("#observaciones").val("");
        }

        function mostrarMsgIglesia(msg, exito) {
            $("#msgIglesia").text(msg).removeClass().addClass(exito ? "text-success" : "text-danger");
            setTimeout(() => { $("#msgIglesia").text(""); }, 3000);
        }
    </script>
}
