@model AplicacionCuria.Models.ComprobanteDonacionViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Comprobante de Donación</title>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            margin: 35px 45px;
            font-size: 14px;
            color: #222;
            line-height: 1.6;
        }

        .encabezado {
            text-align: center;
            margin-bottom: 25px;
        }

        .encabezado img {
            max-width: 450px;
            max-height: 110px;
            width: auto;
            height: auto;
            object-fit: contain;
            display: block;
            margin: 0 auto;
        }

        .titulo-doc {
            text-align: center;
            font-size: 20px;
            font-weight: bold;
            letter-spacing: 1px;
            color: #1a365d;
            margin: 15px 0 5px 0;
            text-transform: uppercase;
        }

        .subtitulo-doc {
            text-align: center;
            font-size: 13px;
            color: #555;
            margin-bottom: 25px;
        }

        .recuadro-info {
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            padding: 16px 20px;
            background-color: #f8fafc;
            margin-bottom: 25px;
        }

        .fila-dato {
            margin-bottom: 8px;
            display: flex;
        }

        .tabla-datos {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 25px;
        }

        .tabla-datos td {
            padding: 7px 10px;
            font-size: 14px;
            border-bottom: 1px solid #e2e8f0;
        }

        .tabla-datos td.etiqueta {
            width: 32%;
            font-weight: bold;
            color: #334155;
            background-color: #f1f5f9;
        }

        .tabla-datos td.valor {
            width: 68%;
            color: #0f172a;
        }

        .monto-destacado {
            font-size: 18px;
            font-weight: bold;
            color: #166534;
        }

        .parrafo-constancia {
            font-size: 15px;
            text-align: justify;
            margin: 20px 0;
            line-height: 1.8;
        }

        .firma-container {
            margin-top: 60px;
            text-align: center;
        }

        .firma-box {
            height: 70px;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            margin: 0 auto;
        }

        .img-firma {
            max-height: 65px;
            max-width: 180px;
        }

        .linea-firma {
            width: 250px;
            margin: 5px auto 8px auto;
            border-top: 1px solid #000;
        }

        .agradecimiento {
            text-align: center;
            font-style: italic;
            color: #475569;
            margin-top: 40px;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <div class="encabezado">
        <img src="@(ViewData["LogoParroquia"] as string ?? Url.Content("~/imagenes/logo_cristo_salvador.png"))" alt="Parroquia Cristo Salvador">
    </div>

    <div class="titulo-doc">Comprobante de Donación</div>
    <div class="subtitulo-doc">N° DON-@Model.Id.ToString("D5") &nbsp;|&nbsp; Fecha: @Model.FechaDonacion.ToString("dd") de @Model.FechaDonacion.ToString("MMMM") de @Model.FechaDonacion.ToString("yyyy")</div>

    <p class="parrafo-constancia">
        Por medio del presente comprobante, la <strong>@Model.Parroquia</strong> hace constar que se ha recibido satisfactoriamente la donación voluntaria realizada por el feligrés cuyos datos se detallan a continuación:
    </p>

    <table class="tabla-datos">
        <tr>
            <td class="etiqueta">Donante:</td>
            <td class="valor"><strong>@Model.Donante</strong></td>
        </tr>
        <tr>
            <td class="etiqueta">Cédula de Identidad:</td>
            <td class="valor">@Model.Cedula</td>
        </tr>
        @if (!string.IsNullOrWhiteSpace(Model.Telefono))
        {
            <tr>
                <td class="etiqueta">Teléfono de contacto:</td>
                <td class="valor">@Model.Telefono</td>
            </tr>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Direccion) && Model.Direccion != "S/N")
        {
            <tr>
                <td class="etiqueta">Dirección:</td>
                <td class="valor">@Model.Direccion</td>
            </tr>
        }
        <tr>
            <td class="etiqueta">Concepto de la donación:</td>
            <td class="valor">@Model.Concepto (@Model.TipoServicio)</td>
        </tr>
        <tr>
            <td class="etiqueta">Método de donación:</td>
            <td class="valor">@Model.MetodoDonacion</td>
        </tr>
        <tr>
            <td class="etiqueta">Valor donado:</td>
            <td class="valor monto-destacado">$@Model.Valor.ToString("N2") USD</td>
        </tr>
        @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
        {
            <tr>
                <td class="etiqueta">Observaciones:</td>
                <td class="valor">@Model.Observaciones</td>
            </tr>
        }
    </table>

    <div class="firma-container">
        <div class="firma-box">
            @if (!string.IsNullOrEmpty(Model.FirmaSacerdote))
            {
                <img src="data:image/png;base64,@Model.FirmaSacerdote" alt="Firma Sacerdote" class="img-firma" />
            }
        </div>
        <div class="linea-firma"></div>
        <div style="font-weight: bold; font-size: 14px;">@Model.NombreSacerdote</div>
        <div style="font-size: 13px; color: #444;">Párroco</div>
        <div style="font-size: 12px; color: #666;">@Model.Parroquia - Cuenca, Ecuador</div>
    </div>

    <div class="agradecimiento">
        "Cada uno dé como propuso en su corazón: no con tristeza, ni por necesidad, porque Dios ama al dador alegre." (2 Corintios 9:7)
    </div>
</body>
</html>
