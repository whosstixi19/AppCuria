@model AplicacionCuria.Models.CertificadoMatrimonioImprimir
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Certificado de Matrimonio</title>
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            margin: 20px 60px;
            font-size: 16px;
            line-height: 1.5;
        }

        main {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 100%; /* Ocupar toda la altura */
        }

        .encabezado {
            text-align: center;
        }

        .encabezado img {
            max-width: 100px;
            height: auto;
            display: block;
            margin: 0 auto 5px;
        }

        .encabezado h1, .encabezado h2, .encabezado h3 {
            margin: 3px 0;
        }

        .titulo {
            text-align: center;
            margin-top: 10px;
            font-weight: bold;
            text-decoration: underline;
            font-size: 18px;
        }

        .main-content {
            position: relative;
            margin-top: 20px;
            padding-left: 240px;
            padding-right: 40px;
            font-size: 18px;
        }

        .contenido {
            max-width: 600px;
            text-align: justify;
            margin: 0 auto;
            font-size: 18px;
        }

        .contenidosuperior {
            max-width: 600px;
            text-align: justify;
            margin: 0 auto;
            font-size: 18px;
        }

        .registro-civil {
            position: absolute;
            left: 0;
            top: 0;
            border: 1px solid black;
            padding: 10px;
            width: 160px;
            font-size: 14px;
            line-height: 1.5;
        }

        .firma-footer-container {
            margin-top: auto;
        }

        .firma {
            text-align: center;
            margin-top: 110px;
            height: 180px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        .firma-img-container {
            height: 100px; /* Siempre reserva espacio para la firma */
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
        }

        .img-firma {
            max-height: 100px;
            max-width: 250px;
            height: auto;
        }

        .firma p {
            margin: 0;            /* Eliminamos margen dinámico */
            line-height: 22px;    /* Altura fija para cada línea */
        }


        .negrita {
            font-weight: bold;
        }

        p {
            margin-top: 30px;
            margin-bottom: 30px;
        }

        .footer {
            text-align: center;
            font-size: 12px;
            color: #333;
            border-top: 1px solid #ccc;
            padding: 10px 0;
            background-color: #fff;
            margin-top: 125px;
        }
        .nombre-sacerdote,
        .titulo-parroco {
            margin: 0;
            line-height: 22px;
        }
    </style>
</head>
<body>
    <main>
        <div>
            <!-- ENCABEZADO -->
            <div class="encabezado">
                <img src="~/imagenes/escudo.png" alt="Escudo Parroquia" />
                <h1>ARQUIDIÓCESIS DE CUENCA</h1>
                <h2>VICARÍA URBANA</h2>
                <h3>PARROQUIA SANTA MARÍA DE EL VERGEL</h3>
                <div class="titulo">CERTIFICADO DE MATRIMONIO</div>
            </div>

            <p style="text-align:right;">Cuenca, @DateTime.Now.ToString("dddd dd MMMM yyyy")</p>
            <div class="contenidosuperior"></div>
            <p>
                Yo, el infrascrito, certifico en legal forma, a petición de parte interesada, que en el Tomo 
                <span class="negrita">@Model.Acta.tomo</span> de partidas matrimoniales de este archivo parroquial, 
                pág. <span class="negrita">@Model.Acta.pagina</span>, acta <span class="negrita">@Model.Acta.acta</span>, 
                se halla inscrita con los siguientes datos:
            </p>
            <div class="main-content">
                <!-- CONTENIDO -->
                <div class="contenido">
                    <p>
                        El día <span class="negrita">@Model.Acta.fecharegistro.ToString("dd MMMM yyyy")</span> en la iglesia
                        <span class="negrita">@Model.Acta.observaciones</span>
                    </p>
                    <p>
                        <span class="negrita">@Model.NombreSacerdote</span> presenció y bendijo dentro-fuera de la misa el matrimonio que contrajo el Sr.
                        <span class="negrita">@Model.Acta.nombrenovio</span>
                        con la Srta. <span class="negrita">@Model.Acta.nombrenovia</span>,
                    </p>
                    <p>
                        feligreses de la parroquia de <span class="negrita">@Model.NombreParroquia</span>.
                    </p>
                    <p>
                        Fueron testigos <span class="negrita">@Model.Acta.testigo1</span> y <span class="negrita">@Model.Acta.testigo2</span>.
                    </p>

                    <!-- REGISTRO CIVIL -->
                    <div class="registro-civil">
                        <strong>Registro Civil</strong><br />
                        Tomo: @Model.Acta.tomo <br />
                        Pág: @Model.Acta.pagina <br />
                        Acta: @Model.Acta.acta <br />
                        Lugar y fecha: <br />@Model.Acta.fecharegistro.ToString("yyyy")
                    </div>
                </div>
            </div>
            <p>
                Son datos fielmente tomados del original, al que me remito en caso necesario.
            </p>
            <p>
                Lo certifico.
            </p>
        </div>

        <div class="firma-footer-container">
            <div class="firma">
                <div class="firma-img-container">
                    @if (!string.IsNullOrEmpty(Model.FirmaSacerdote))
                    {
                        <img src="data:image/png;base64,@Model.FirmaSacerdote" alt="Firma Sacerdote" class="img-firma" />
                    }
                </div>
                <p class="nombre-sacerdote">@Model.NombreSacerdote</p>
                <p class="titulo-parroco">PARROCO</p>
            </div>

            <div class="footer">
                <p>Av 12 de Abril y las Herrerias Cuenca - Tel:072814-031 - Email: elvergelcuenca@hotmail.com </p>
            </div>
        </div>
    </main>
</body>
</html>
