@model AplicacionCuria.Models.Agenda
@{
    ViewData["Title"] = "Eliminar Evento de Agenda";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm border-danger">
            <div class="card-body p-4">
                <h4 class="card-title text-danger fw-bold mb-3">
                    <i class="fas fa-trash-alt me-1 text-danger"></i> Eliminar Evento de Agenda
                </h4>

                <p class="text-muted small mb-3">¿Está seguro de que desea eliminar permanentemente este evento de la agenda?</p>

                <form asp-action="DeleteConfirmed" asp-controller="Agenda" asp-route-id="@Model.id" method="post" id="formulario">
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label class="form-label mb-1 fw-semibold small">Fecha</label>
                            <div class="form-control form-control-sm bg-light">@Model.fechaagenda.ToString("yyyy-MM-dd")</div>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label mb-1 fw-semibold small">Hora</label>
                            <div class="form-control form-control-sm bg-light">@Model.hora</div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label mb-1 fw-semibold small">Lugar</label>
                        <div class="form-control form-control-sm bg-light">@Model.lugar</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label mb-1 fw-semibold small">Descripción</label>
                        <div class="form-control form-control-sm bg-light" style="min-height: 60px;">@Model.descripcion</div>
                    </div>

                    <div class="d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-danger btn-sm px-4">Confirmar Eliminación</button>
                        <a href="@Url.Action("MenuAgenda", "Home")" class="btn btn-secondary btn-sm px-3">Cancelar</a>
                    </div>
                    <div class="text-center mt-2">
                        <label id="exito" class="text-success fw-semibold small" style="display: none;">Agenda eliminada con éxito</label>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById("formulario").addEventListener("submit", function (event) {
        event.preventDefault();

        var formData = new FormData(this);

        fetch(this.action, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            const exito = document.getElementById("exito");
            exito.style.display = "none";

            if (data.success) {
                exito.className = "text-success fw-semibold small";
                exito.textContent = "Agenda eliminada con éxito. Redirigiendo...";
                exito.style.display = "block";
                setTimeout(function () {
                    window.location.href = "/Home/MenuAgenda";
                }, 1500);
            } else {
                exito.className = "text-danger fw-semibold small";
                exito.textContent = "Error al eliminar la agenda.";
                exito.style.display = "block";
            }
        })
        .catch(error => {
            console.error('Error:', error);
            const exito = document.getElementById("exito");
            exito.className = "text-danger fw-semibold small";
            exito.innerText = "Error de conexión al eliminar.";
            exito.style.display = "block";
        });
    });
</script>
