@model AplicacionCuria.Models.CursilloMatrimonioImprimir
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Certificado</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            width: 100%;
            font-family: Arial, Helvetica, sans-serif;
            background-color: #FFFFFF;
            padding: 20px 30px;
        }

        .container {
            display: block;
            width: 100%;
            padding: 10px 20px;
            background-color: #FFFFFF;
            text-align: center;
        }

        .pastoral-header {
            font-size: 15px;
            font-weight: bold;
            color: #555;
            text-transform: uppercase;
            margin-bottom: 10px;
            letter-spacing: 0.5px;
        }

        .header {
            font-size: 26px;
            font-weight: bold;
            color: #D62429;
            margin-top: 5px;
            letter-spacing: 1px;
        }

        .sub-header {
            font-size: 17px;
            color: #333;
            margin: 15px auto;
            line-height: 1.6;
            max-width: 680px;
        }

        .sub-header p {
            margin-bottom: 8px;
        }

        .footer {
            font-size: 15px;
            margin-top: 20px;
        }

        .mmmm {
            text-align: center;
            width: 100%;
            margin-bottom: 10px;
        }

        .badge {
            max-height: 110px;
            max-width: 480px;
            object-fit: contain;
            height: auto;
            width: auto;
            display: block;
            margin: 0 auto;
        }

        .tabla-firmas {
            width: 100%;
            margin-top: 25px;
            border-collapse: collapse;
            border: none;
        }

        .tabla-firmas td {
            text-align: center;
            vertical-align: bottom;
            border: none;
            padding: 0;
        }

        .firma-box {
            min-height: 105px;
            display: block;
            margin-bottom: 5px;
        }

        .img-firma {
            max-height: 95px;
            max-width: 220px;
            height: auto;
            width: auto;
            display: block;
            margin: 0 auto;
            object-fit: contain;
        }

        .linea-firma {
            border-top: 1px solid #000;
            width: 75%;
            margin: 0 auto 8px auto;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Imagen del escudo -->
        <div class="pastoral-header">La Pastoral Familiar de la Parroquia @(ViewData["NombreParroquia"] as string ?? Model.Cursillo?.Parroquia?.nombre ?? "Cristo Salvador")</div>

        <div class="mmmm">
            <img src="@(ViewData["LogoParroquia"] as string ?? Url.Content("~/imagenes/logo_certificados.png"))" alt="Escudo" class="badge" />
        </div>

        <!-- Encabezado del certificado -->
        <div class="header">CERTIFICADO</div>
        <div class="sub-header">
            <p>Que los Señores: <strong>@Model.Cursillo.nombrenovio</strong> y <strong>@Model.Cursillo.nombrenovia</strong></p>
            <p>Participaron del <strong>CURSILLO PREMATRIMONIAL</strong></p>
            <p>
                efectuado en esta jurisdicción el 
                <strong>@Model.Cursillo.fechacursillo.ToString("dd") de @Model.Cursillo.fechacursillo.ToString("MMMM") de @Model.Cursillo.fechacursillo.ToString("yyyy")</strong>.
            </p>
            <p>
                Fecha del Matrimonio:  
                <strong>@Model.Cursillo.fechamatrimonio.ToString("dd") de @Model.Cursillo.fechamatrimonio.ToString("MMMM") de @Model.Cursillo.fechamatrimonio.ToString("yyyy")</strong>
            </p>
            <p>Parroquia: <strong>@(ViewData["NombreParroquia"] as string ?? Model.Cursillo?.Parroquia?.nombre ?? "")</strong></p>
        </div>

        <!-- Pie de página con fecha y firma -->
        <div class="footer">
            <p>Cuenca, a @DateTime.Now.ToString("dd") de @DateTime.Now.ToString("MMMM") de @DateTime.Now.ToString("yyyy")</p>

            <table class="tabla-firmas">
                <tr>
                    <td style="width: 46%;">
                        <div class="firma-box">
                            @if (!string.IsNullOrEmpty(Model.FirmaSacerdote))
                            {
                                <img src="data:image/png;base64,@Model.FirmaSacerdote" alt="Firma Sacerdote" class="img-firma" />
                            }
                        </div>
                        <div class="linea-firma"></div>
                        <p style="margin: 0; font-size: 15px; font-weight: bold;">Párroco</p>
                        @if (!string.IsNullOrEmpty(Model.NombreSacerdote))
                        {
                            <p style="margin: 0; font-size: 13px; color: #333;">@Model.NombreSacerdote</p>
                        }
                    </td>
                    <td style="width: 8%;"></td>
                    <td style="width: 46%;">
                        <div class="firma-box">
                            <!-- Espacio en blanco para firma manual -->
                        </div>
                        <div class="linea-firma"></div>
                        <p style="margin: 0; font-size: 15px; font-weight: bold;">Representante Pastoral Familiar</p>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</body>
</html>
