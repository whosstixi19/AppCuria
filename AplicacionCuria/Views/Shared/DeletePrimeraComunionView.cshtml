@model AplicacionCuria.Models.PrimeraComunion





<div class="tab-pane fade show active" id="acta-bautismo" role="tabpanel" aria-labelledby="acta-bautismo-tab">
    <div class="row">
        <!-- Formulario de actualización a la izquierda -->

        <div class="col-md-6">
            <div class="d-flex align-items-center mb-3">
                <a class="btn btn-secondary d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="PrimeraComunionView" aria-label="Regresar al menú de sacramentos">
                    <i class="fas fa-arrow-left me-1"></i>
                    <span>Volver</span>
                </a>
                <h1 class="ms-3">Eliminar Primera Comunion</h1>
            </div>
            <form asp-controller="PrimeraComunion" asp-action="DeleteConfirmed" method="post" id="acta-form">
                <input type="hidden" name="id" value="@Model.id" /> <!-- Enviar ID al controlador -->
                <!-- Nombre completo -->
                <div class="mb-3">
                    <label for="Nombre" class="form-label">Nombre</label>
                    <label type="text" class="form-control" id="Nombre" name="nombre">@Model.nombre</label>
                </div>

                <div class="mb-3">
                    <label for="Apellido" class="form-label">Apellido</label>
                    <label type="text" class="form-control" id="Apellido" name="apellido">@Model.apellido</label>
                </div>
                <div class="mb-3">
                    <label for="fechaNacimiento" class="form-label">Fecha de Nacimiento</label>
                    <label type="date" class="form-control" id="fechaNacimiento" name="fechanacimiento">@Model.fechanacimiento.ToString("yyyy-MM-dd")</label>
                </div>

                <div class="mb-3">
                    <label for="Cedula" class="form-label">Cedula</label>
                    <label type="text" class="form-control" id="Cedula" name="cedula">@Model.cedula</label>
                </div>

                <div class="mb-3">
                    <label for="Direccion" class="form-label">Dirección</label>
                    <label type="text" class="form-control" id="Direccion" name="direccion">@Model.direccion</label>
                </div>

                <div class="mb-3">
                    <label for="Telefono" class="form-label">Telefono</label>
                    <label type="text" class="form-control" id="telefono" name="telefono">@Model.telefono</label>
                </div>

                <div class="mb-3">
                    <label for="fechaPrimeraComunion" class="form-label">Fecha de Primera Comunion</label>
                    <label type="date" class="form-control" id="fechaPrimeraComunion" name="fechaprimeracomunion">@Model.fechaprimeracomunion.ToString("yyyy-MM-dd")</label>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="Parroquia" class="form-label">Parroquia</label>
                        <label ... id="Parroquia" name="parroquia">@ViewBag.ParroquiaNombre</label>

                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="Sacerdote" class="form-label">Sacerdote</label>
                        <label ... id="Sacerdote" name="sacerdote">@ViewBag.SacerdoteNombre</label>
                        
                    </div>
                </div>


                <!-- Botón de actualización -->
                <div class="mb-3">
                    <button type="submit" asp-controller="PrimeraComunion" asp-action="DeleteConfirmed" asp-route-id="@Model.id" class="btn btn-danger">Eliminar</button>
                    <label id="exito" class="text-success" style="display: none;">Primera comunion eliminada con exito</label>

                </div>
            </form>
        </div>
    </div>
</div>


<script>


    document.addEventListener("DOMContentLoaded", function () {


        fetch(`/PrimeraComunion/Valores/${@Model.id}`)
            .then(response => response.json())
            .then(data => {
                // Obtener el valor del ministro del JSON
                const ministro = data.sacerdote;
                const parroquia = data.parroquia;

                // Obtener el elemento select
                console.log(ministro);
                console.log(parroquia);
                const selectElement = document.getElementById('ministro');
                const selectElement2 = document.getElementById('sacerdote');
                selectElement.value = ministro;
                selectElement2.value = parroquia;
            })
            .catch(error => console.error('Error:', error));


    });


    document.getElementById("acta-form").addEventListener("submit", function (event) {
        event.preventDefault(); // Evitar el envío del formulario por defecto

        var formData = new FormData(this);

        fetch(this.action, {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                // Ocultar el label de error al enviar el formulario
                document.getElementById("exito").style.display = "none";

                if (data.success) {
                    // Redirigir a la raíz o hacer otras acciones en caso de éxito

                    document.getElementById("exito").style.display = "block";
                    //location.reload();
                    setTimeout(function () {
                        console.log("Han pasado 5 segundos");
                        window.location.href = "/Home/MenuSacramentos";
                    }, 5000);


                }
            })
            .catch(error => {
                console.error('Error:', error);
                // Opcional: Mostrar un mensaje de error genérico
                document.getElementById("exito").innerText = error;
                document.getElementById("exito").style.display = "block";
            });


    });
</script>