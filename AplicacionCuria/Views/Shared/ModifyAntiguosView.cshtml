@model AplicacionCuria.Models.Antiguos





<div class="tab-pane fade show active" id="acta-bautismo" role="tabpanel" aria-labelledby="acta-bautismo-tab">
    <div class="row">
        <!-- Formulario de actualización a la izquierda -->

        <div class="col-md-6">
            <div class="d-flex align-items-center mb-3">
                <a class="btn btn-secondary d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="BautizadosView" aria-label="Regresar al menú de sacramentos">
                    <i class="fas fa-arrow-left me-1"></i>
                    <span>Volver</span>
                </a>
                <h1 class="ms-3">Modificar Acta</h1>
            </div>
            <form asp-controller="Antiguos" asp-action="Edit" method="post" id="acta-form">
                <input type="hidden" name="id" value="@Model.id" /> <!-- Enviar ID al controlador -->
                <!-- Nombre completo -->
                <div class="mb-3">
                    <label for="NombreCompleto" class="form-label">Nombre completo</label>
                    <input type="text" class="form-control" id="NombreCompleto" name="nombrecompleto" value="@Model.nombrecompleto" required>
                </div>

                <!-- Lugar de nacimiento -->
                <div class="mb-3">
                    <label for="LugarNacimiento" class="form-label">Lugar de nacimiento</label>
                    <input type="text" class="form-control" id="LugarNacimiento" name="lugarnacimiento" value="@Model.lugarnacimiento" required>
                </div>

                <!-- Cédula y sexo -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="Cedula" class="form-label">Cédula</label>
                        <input type="text" class="form-control" id="Cedula" name="cedula" value="@Model.cedula">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Sexo" class="form-label">Sexo</label>
                        <select class="form-select" id="Sexo" name="sexo" required>
                            <option value="Masculino" selected="@(Model.sexo == "Masculino")">Masculino</option>
                            <option value="Femenino" selected="@(Model.sexo == "Femenino")">Femenino</option>
                        </select>
                    </div>
                </div>

                <!-- Fechas -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="FechaNacimiento" class="form-label">Fecha de nacimiento</label>
                        <input type="date" class="form-control" id="FechaNacimiento" name="fechanacimiento" value="@Model.fechanacimiento.ToString("yyyy-MM-dd")" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="FechaBautizo" class="form-label">Fecha de bautizo</label>
                        <input type="date" class="form-control" id="FechaBautizo" name="fechabautizo" value="@Model.fechabautizo.ToString("yyyy-MM-dd")" required>
                    </div>
                </div>

                <!-- Información adicional (padres y padrinos) -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="nombrepadre" class="form-label">Nombre del padre</label>
                        <input type="text" class="form-control" id="nombrepadre" name="nombrepadre" value="@Model.nombrepadre">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="nombremadre" class="form-label">Nombre de la madre</label>
                        <input type="text" class="form-control" id="nombremadre" name="nombremadre" value="@Model.nombremadre">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="Padrino1" class="form-label">Padrino 1</label>
                        <input type="text" class="form-control" id="Padrino1" name="cedulapadrino1" value="@Model.cedulapadrino1">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Padrino2" class="form-label">Padrino 2</label>
                        <input type="text" class="form-control" id="Padrino2" name="cedulapadrino2" value="@Model.cedulapadrino2">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Padrino3" class="form-label">Padrino 3</label>
                        <input type="text" class="form-control" id="Padrino3" name="cedulapadrino3" value="@Model.cedulapadrino3">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Padrino4" class="form-label">Padrino 4</label>
                        <input type="text" class="form-control" id="Padrino4" name="cedulapadrino4" value="@Model.cedulapadrino4">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Padrino5" class="form-label">Padrino 5</label>
                        <input type="text" class="form-control" id="Padrino5" name="cedulapadrino5" value="@Model.cedulapadrino5">
                    </div>
                </div>

                <!-- Datos del acta -->
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="Tomo" class="form-label">Tomo</label>
                        <input type="text" class="form-control" id="Tomo" name="tomo" value="@Model.tomo">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="Pagina" class="form-label">Folio</label>
                        <input type="text" class="form-control" id="Pagina" name="pagina" value="@Model.pagina">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="Acta" class="form-label">Número de Acta</label>
                        <input type="text" class="form-control" id="Acta" name="acta" value="@Model.acta">
                    </div>
                </div>

                <!-- Listados desplegables -->
                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label for="ministro" class="form-label">Ministro</label>
                        <select class="form-select" id="ministro" name="ministro_id" required>
                            <option value="">Seleccione un ministro</option>
                            @foreach (var item in ViewBag.Ministros)
                            {
                                <option value="@item.id" selected="@(item.id == Model.ministro_id)">
                                    @item.nombre 
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="iglesia" class="form-label">Iglesia</label>
                        <select class="form-select" id="iglesia" name="iglesia_id" required>
                            <option value="">Seleccione una iglesia</option>
                            @foreach (var item in ViewBag.Iglesias)
                            {
                                <option value="@item.id" selected="@(item.id == Model.iglesia_id)">
                                    @item.nombre 
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="parroquia" class="form-label">Parroquia</label>
                        <select class="form-select" id="parroquia" name="parroquia_id" required>
                            <option value="">Seleccione una parroquia</option>
                            @foreach (var item in ViewBag.Parroquias)
                            {
                                <option value="@item.id" selected="@(item.id == Model.parroquia_id ? "selected" : null)">
                                    @item.nombre
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="sacerdote" class="form-label">Sacerdote</label>
                        <select class="form-select" id="sacerdote" name="sacerdote_id" required>
                            <option value="">Seleccione un sacerdote</option>
                            @foreach (var item in ViewBag.Sacerdotes)
                            {
                                <option value="@item.id" selected="@(item.id == Model.sacerdote_id ? "selected" : null)">
                                    @item.nombre
                                </option>
                            }
                        </select>
                    </div>

                </div>

                <div class="row">
                    @* <div class="col-md-6 mb-3">
                        <label for="feligreses" class="form-label">Feligreses</label>
                        <select class="form-select" id="feligreses" name="feligreses" required>
                            <option selected="@Model.feligreses">Seleccione un feligres</option>
                            @foreach (var feligres in ViewBag.Feligreses)
                            {
                                <option value="@feligres.id">@feligres.nombre</option>
                            }
                        </select>
                    </div> *@

                    <!-- Registro Civil -->

                    <div class="row registro-civil-container">
                        <h5>Registro Civil</h5>
                        <div class="col-md-3 mb-3">
                            <label for="RegistroCivilAno" class="form-label">Año de Registro Civil</label>
                            <input type="text" class="form-control" id="RegistroCivilAno" name="registrocivilano" value="@Model.registrocivilano" required>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="RegistroCivilTomo" class="form-label">Tomo de Registro Civil</label>
                            <input type="text" class="form-control" id="RegistroCivilTomo" name="registrociviltomo" value="@Model.registrociviltomo" required>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="RegistroCivilFolio" class="form-label">Folio de Registro Civil</label>
                            <input type="text" class="form-control" id="RegistroCivilFolio" name="registrocivilfolio" value="@Model.registrocivilfolio" required>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="RegistroCivilActa" class="form-label">Número de Acta de Registro Civil</label>
                            <input type="text" class="form-control" id="RegistroCivilActa" name="registrocivilacta" value="@Model.registrocivilacta" required>
                        </div>
                        <div class="mb-3">
                            <label for="RegistroCivilFecha" class="form-label">Fecha de Registro Civil</label>
                            <input type="date" class="form-control" id="RegistroCivilFecha" name="registrocivilfecha" value="@Model.registrocivilfecha.ToString("yyyy-MM-dd")" required>
                        </div>
                        <div class="mb-3">
                            <label for="observaciones" class="form-label">Observaciones adicionales</label>
                            <input type="text" class="form-control" id="observaciones" name="observaciones" value="@Model.observaciones">
                        </div>
                    </div>
                </div>

                <!-- Botón de actualización -->
                <div class="mb-3">
                    <button type="submit" asp-controller="Antiguos" asp-action="Edit" asp-route-id="@Model.id" class="btn btn-primary">Actualizar</button>
                    <label id="exito" class="text-success" style="display: none;">Acta antigua Actualizada</label>

                </div>
            </form>
        </div>
    </div>
</div>


<script>
    function cargarMinistros() {
        fetch('/ActaBautismo/GetMinistros')
            .then(response => response.json())
            .then(data => {
                let ministroSelect = document.getElementById('ministro');
                ministroSelect.innerHTML = '<option value="">Seleccione un ministro</option>'; // Limpiar opciones previas

                data.forEach(ministro => {
                    ministroSelect.innerHTML += `<option value="${ministro.id}">${ministro.nombre}</option>`;
                });
            })
            .catch(error => console.log('Error:', error));
    }
    function cargarParroquias() {
        fetch('/ActaBautismo/GetParroquias')
            .then(response => response.json())
            .then(data => {
                let ministroSelect = document.getElementById('Parroquia');
                ministroSelect.innerHTML = '<option value="">Seleccione una Parroquia</option>'; // Limpiar opciones previas

                data.forEach(ministro => {
                    ministroSelect.innerHTML += `<option value="${ministro.id}">${ministro.nombre}</option>`;
                });
            })
            .catch(error => console.log('Error:', error));
    }
    function cargarIglesias() {
        fetch('/ActaBautismo/GetIglesias')
            .then(response => response.json())
            .then(data => {
                let ministroSelect = document.getElementById('iglesia');
                ministroSelect.innerHTML = '<option value="">Seleccione una iglesia</option>'; // Limpiar opciones previas

                data.forEach(ministro => {
                    ministroSelect.innerHTML += `<option value="${ministro.id}">${ministro.nombre}</option>`;
                });
            })
            .catch(error => console.log('Error:', error));
    }
    function cargarSacerdotes() {
        fetch('/ActaBautismo/GetSacerdotes')
            .then(response => response.json())
            .then(data => {
                let ministroSelect = document.getElementById('Sacerdote');
                ministroSelect.innerHTML = '<option value="">Seleccione un sacerdote</option>'; // Limpiar opciones previas

                data.forEach(ministro => {
                    ministroSelect.innerHTML += `<option value="${ministro.id}">${ministro.nombre}</option>`;
                });
            })
            .catch(error => console.log('Error:', error));
    }
    function cargarFeligreses() {
        fetch('/ActaBautismo/GetFeligreses')
            .then(response => response.json())
            .then(data => {
                let ministroSelect = document.getElementById('Feligreses');
                ministroSelect.innerHTML = '<option value="">Seleccione</option>'; // Limpiar opciones previas

                data.forEach(ministro => {
                    ministroSelect.innerHTML += `<option value="${ministro.id}">${ministro.nombre}</option>`;
                });
            })
            .catch(error => console.log('Error:', error));
    }


    document.getElementById("acta-form").addEventListener("submit", function (event) {
        event.preventDefault(); // Evitar el envío del formulario por defecto

        var formData = new FormData(this);

        fetch(this.action, {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                // Ocultar el label de error al enviar el formulario
                document.getElementById("exito").style.display = "none";

                if (data.success) {
                    // Redirigir a la raíz o hacer otras acciones en caso de éxito

                    document.getElementById("exito").style.display = "block";
                    //location.reload();
                    setTimeout(function () {
                        console.log("Han pasado 5 segundos");
                        window.location.href = "/Submenus/BautizadosView";
                    }, 3000);


                }
            })
            .catch(error => {
                console.error('Error:', error);
                // Opcional: Mostrar un mensaje de error genérico
                document.getElementById("exito").innerText = error;
                document.getElementById("exito").style.display = "block";
            });


    });
</script>