@model AplicacionCuria.Models.CertificadoViewModel
@{
    Layout = null;

    string ObtenerSiguienteNivel(string nivelActual)
    {
        var niveles = new System.Collections.Generic.List<string> { "INICIACIÓN", "RECONCILIACIÓN", "COMUNIÓN", "AÑO BÍBLICO", "DISCIPULADO", "CONFIRMACIÓN" };
        int index = niveles.IndexOf(nivelActual);
        if (index >= 0 && index < niveles.Count - 1)
        {
            return niveles[index + 1];
        }
        return "Graduado";
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Certificado de Catequesis</title>
    <style>
    @@page {
        size: A4 landscape;
        margin: 0;
    }

    body {
        margin: 0;
        padding: 15px;
        width: 100%;
        background: #fff;
        font-family: 'Times New Roman', serif;
        box-sizing: border-box;
    }

    .container {
        width: 100%;
        box-sizing: border-box;
        padding: 25px 40px 40px 40px;
        text-align: center;
        position: relative;
        display: block;
    }

        .content {
            display: block;
        }

        .logo {
            display: block;
            margin: 0 auto 15px auto;
            max-height: 120px;
            max-width: 480px;
            width: auto;
            height: auto;
            object-fit: contain;
        }

        .title {
            font-size: 28px;
            font-weight: bold;
            margin-top: 5px;
        }

        .sub-title {
            font-size: 23px;
            margin: 10px 0 10px 0;
        }

        .certifica {
            font-size: 30px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .nombre {
            font-size: 28px;
            font-weight: bold;
            margin: 20px 0 40px 0;
        }

        .detalle {
            font-size: 24px;
            margin: 10px 0;
        }

        .footer {
            margin-top: 30px;    /* Empuja la fecha hacia abajo */
            padding-bottom: 155px; /* Reserva un espacio fijo para la firma */
            font-size: 22px;
        }

        .firma {
            position: absolute;
            bottom: 60px; /* Fija la distancia desde el borde inferior del marco */
            left: 0;
            right: 0;
            text-align: center;
            font-size: 23px;
        }

        .firma-box {
            min-height: 95px;
            display: block;
            margin-bottom: 5px;
        }

        .firma-img {
            display: block;
            max-height: 85px;
            max-width: 220px;
            width: auto;
            height: auto;
            object-fit: contain;
            margin: 0 auto;
        }

        .firma-linea {
            border-top: 1px solid #000;
            width: 260px;
            margin: 5px auto;
        }

        .detalle-container {
            text-align: left;
            margin: 0 auto;
            display: inline-block;
        }
        .marco {
        width: 98%;
        margin: 0 auto;
        border: 8px solid black;
        padding: 20px;
        box-sizing: border-box;
        display: block;
    }
    </style>
</head>
<body>
    <div class="marco">
        <div class="container">
            <div class="content">
                <img src="@(ViewData["LogoParroquia"] as string ?? Url.Content("~/imagenes/logo_certificados.png"))" class="logo" alt="Logo Parroquia">

                <div class="title">Parroquia @(ViewData["NombreParroquia"] as string ?? "Cristo Salvador")</div>
                <div class="sub-title">La Comisión de Catequesis</div>

                <div class="certifica">CERTIFICA</div>
                <div class="nombre">@Model.Apellido @Model.Nombre </div>
                <div class="detalle-container">
                    <div class="detalle">Aprobó el nivel de: <strong>@Model.Nivel</strong></div>
                    <div class="detalle">
                        Paralelo <strong>@Model.Paralelo</strong> con @Model.TituloCatequista:
                        <em>@Model.CatequistasCompletos</em>
                    </div>
                    <div class="detalle">Está promovido al nivel de: <strong>@ObtenerSiguienteNivel(Model.Nivel)</strong></div>
                </div>

                <div class="footer">
                    Cuenca, @DateTime.Now.ToString("d 'de' MMMM 'de' yyyy")
                </div>
            </div>

            <div class="firma">
                <div class="firma-box">
                    @if (Model.FirmaSacerdote != null && Model.FirmaSacerdote.Length > 0)
                    {
                        <img src="data:image/png;base64,@Convert.ToBase64String(Model.FirmaSacerdote)" alt="Firma" class="firma-img" />
                    }
                </div>
                <div class="firma-linea"></div>
                @Model.Sacerdote <br> Párroco
            </div>

        </div>
    </div>
</body>
</html>
