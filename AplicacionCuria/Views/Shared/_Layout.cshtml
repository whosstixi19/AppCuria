
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ECLESOFT</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AplicacionCuria.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">


</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" href="#">ECLESOFT <span class="text-muted">2.0</span></a>

                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- Grupo 1: Secciones principales -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <i class="fas fa-home"></i> Inicio
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="MenuSacramentos">
                                    <i class="fas fa-cross"></i> Sacramentos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="MenuCatequesis">
                                    <i class="fas fa-book"></i> Catequesis
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="MenuCertificado">
                                    <i class="fas fa-certificate"></i> Certificados
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="MenuAgenda">
                                    <i class="fas fa-calendar"></i> Agenda
                                </a>
                            </li>

                            <!-- Grupo 2: Soporte -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="MenuAyudaSocial">
                                    <i class="fas fa-hands-helping"></i> Ayuda Social
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="MenuAyuda">
                                    <i class="fas fa-question-circle"></i> Ayuda
                                </a>
                            </li>

                            <!-- Grupo 3: Admin -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="MenuRegistrar">
                                    <i class="fas fa-user-plus"></i> Registrar
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="MenuPagos">
                                    <i class="fas fa-credit-card"></i> Pagos
                                </a>
                            </li>
                            @if (User.IsInRole("admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Usuarios" asp-action="CrearUsuario">
                                        <i class="fas fa-user-cog"></i> Crear Usuario
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- Usuario actual y logout -->
                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="d-flex align-items-center">
                            <span class="me-2 fw-semibold text-dark">
                                👤 @User.Identity.Name
                            </span>
                            <form asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cerrar sesión</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
            
                @* @if (!User.Identity.IsAuthenticated)
                {
