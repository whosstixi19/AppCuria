        </main>
    </div>

    @* <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - Curia - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
        
    </footer> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
@*     <script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.9.3/dist/umd/popper.min.js"></script>
 *@    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

    <script>
        // --- Protección CSRF: agrega el token a TODAS las peticiones AJAX (fetch y jQuery) ---
        (function () {
            var meta = document.querySelector('meta[name="csrf-token"]');
            var token = meta ? meta.getAttribute('content') : null;

            if (token && window.fetch) {
                var fetchOriginal = window.fetch;
                window.fetch = function (input, init) {
                    init = init ? Object.assign({}, init) : {};
                    var method = (init.method || (input && input.method) || 'GET').toUpperCase();
                    if (method !== 'GET' && method !== 'HEAD') {
                        var headers = new Headers(init.headers || (input && input.headers) || {});
                        if (!headers.has('RequestVerificationToken')) {
                            headers.set('RequestVerificationToken', token);
                        }
                        init.headers = headers;
                    }
                    return fetchOriginal.call(this, input, init);
                };
            }

            if (token && window.jQuery) {
                jQuery(document).ajaxSend(function (event, xhr) {
                    xhr.setRequestHeader('RequestVerificationToken', token);
                });
            }
        })();
    </script>

    <script>
        // Asegurar que el elemento de menú activo permanezca resaltado
        document.addEventListener("DOMContentLoaded", function () {
            var path = window.location.pathname.toLowerCase();
            if (!document.querySelector('.navbar-nav .nav-link.active-section')) {
                var links = document.querySelectorAll('.navbar-nav .nav-link');
                links.forEach(function (link) {
                    var href = link.getAttribute('href');
                    if (href && href !== '#' && href !== '/' && path.startsWith(href.toLowerCase())) {
                        link.classList.add('active', 'active-section');
                    } else if ((path === '/' || path === '/home' || path === '/home/index') && href && href.toLowerCase().includes('/home/index')) {
                        link.classList.add('active', 'active-section');
                    }
                });
            }
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
