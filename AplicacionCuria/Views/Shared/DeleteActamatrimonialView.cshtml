@model AplicacionCuria.Models.ActaDeMatrimonio

<div class="tab-pane fade show active" id="acta-matrimonial" role="tabpanel" aria-labelledby="acta-bautismo-tab">
    <div class="row">
        <!-- Formulario de actualización a la izquierda -->

        <div class="col-md-6">
            <div class="d-flex align-items-center mb-3">
                <a class="btn btn-secondary d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="MatrimoniosView" aria-label="Regresar al menú de sacramentos">
                    <i class="fas fa-arrow-left me-1"></i>
                    <span>Volver</span>
                </a>
                <h1 class="ms-3">Modificar Confirmación</h1>
            </div>

            <form id="form-acta-matrimonial" method="post" action="/ActaMatrimonial/DeleteConfirmed/@Model.id">
                <input type="hidden" name="id" value="@Model.id" />
                <input type="hidden" name="acta_prematrimonial_id" value="@Model.acta_prematrimonial_id" />
                <input type="hidden" name="acta" value="@Model.acta" />
                <input type="hidden" name="tomo" value="@Model.tomo" />
                <input type="hidden" name="pagina" value="@Model.pagina" />

                <h2>Acta Pre Matrimonial</h2>
                <div class="row">
                    <h5>Datos del Novio</h5>

                    <div class="mb-3">
                        <input type="text" id="NombreNovio" name="padrino1" class="form-control" value="@Model.padrino1" readonly />
                    </div>
                    <div class="mb-3">
                        <input type="text" id="LugarBautizoNovio" name="padrino2" class="form-control" value="@Model.padrino2" readonly />
                    </div>
                    <div class="mb-3">
                        <input type="text" id="PadreNovio" name="padrino3" class="form-control" value="@Model.padrino3" readonly />
                    </div>
                    <div class="mb-3">
                        <input type="text" id="MadreNovio" name="padrino4" class="form-control" value="@Model.padrino4" readonly />
                    </div>
                    <div class="mb-3">
                        <label for="FechaBautizoNovio">Fecha de registro:</label>
                        <input type="date" id="FechaBautizoNovio" name="fecharegistro" class="form-control" 
                               value="@(Model.fecharegistro.HasValue ? Model.fecharegistro.Value.ToString("yyyy-MM-dd") : "")" readonly />
                    </div>
                </div>

                <button type="submit" class="btn btn-danger">Eliminar Acta</button>
                <label id="exito" class="text-success" style="display: none;">Acta Eliminada</label>
            </form>
        </div>
    </div>
</div>



<script>

    document.getElementById("form-acta-matrimonial").addEventListener("submit", function (event) {
        event.preventDefault(); // Evitar el envío del formulario por defecto

        var formData = new FormData(this);

        fetch(this.action, {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                // Ocultar el label de error al enviar el formulario
                document.getElementById("exito").style.display = "none";

                if (data.success) {
                    // Redirigir a la raíz o hacer otras acciones en caso de éxito

                    document.getElementById("exito").style.display = "block";
                    //location.reload();
                    setTimeout(function () {
                        console.log("Han pasado 5 segundos");
                        window.location.href = "/Submenus/MatrimoniosView";
                    }, 5000);


                }
            })
            .catch(error => {
                console.error('Error:', error);
                // Opcional: Mostrar un mensaje de error genérico
                document.getElementById("exito").innerText = error;
                document.getElementById("exito").style.display = "block";
            });


    });
</script>