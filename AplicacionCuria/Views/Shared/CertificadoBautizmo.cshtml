@model AplicacionCuria.Models.CursilloPrebautismalImprimir
@{
    Layout = null;
    string etiquetaPadre = ViewBag.Tipo == "padrinos" ? "Padrino" : "Padre";
    string etiquetaMadre = ViewBag.Tipo == "padrinos" ? "Madrina" : "Madre";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Certificado</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            width: 100vw;
            font-family: Arial, Helvetica, sans-serif;
            background-color: #FFFFFF;
        }

        .container {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            height: 150%;
            padding: 10px;
            border: 10px solid #FFFFFF;
            background-color: #FFFFFF;
            box-shadow: 0px 0px 5px #FFFFFF;
            position: center;
            text-align: center;
        }

        .header {
            font-size: 32px;
            font-weight: bold;
            color: #D62429;
            margin-top: 10px;
        }

        .sub-header {
            font-size: 30px;
            color: #333;
            margin: 10px 0 20px;
        }

        .content {
            font-size: 30px;
            color: #000;
            line-height: 1.5;
            margin: 0 15%;
        }

        .line {
            width: 60%;
            height: 2px;
            background-color: black;
            margin: 20px auto;
        }

        .footer {
            font-size: 30px;
            margin-top: 30px;
        }

        .signature {
            font-size: 30px;
            font-weight: bold;
            margin-top: 40px;
        }

        .mmmm {
            display: flex;
            justify-content: space-around; /* Espacio entre los elementos */
            align-items: center;
            width: 100%;
        }

        .badge {
            width: 190px;
            height: auto;
            margin-bottom: 50px;
        }


        .character {
            position: absolute;
            bottom: 20px;
            right: 20px;
            width: 100px;
            height: auto;
        }

        .img-firma {
        max-height: 220px !important;
        width: 300px !important;
        display: block;
        margin-left: 200px;
    }
    </style>
</head>
<body>
    <div class="container">
        <!-- Imagen del escudo -->
        <div class="mmmm">
            <img src="~/imagenes/logo_certificados.png" alt="Escudo" class="badge" />
@*             <img src="~/imagenes/comunion.jpg" alt="Escudo" class="badgee" />
 *@        </div>

        <!-- Encabezado del certificado -->
        <div class="header">Certificado</div>
        <div class="sub-header">
            <p>
                <p>
                    Que los Señores: 
                    <strong>@Model.nombrepadre y @Model.nombremadre</strong>, 
                    @Model.EtiquetaPadre.ToLower() y @Model.EtiquetaMadre.ToLower() de 
                    <strong>@Model.nombrecompletonino.</strong>
                </p>
                <p>Participaron del CURSILLO PREBAUTISMAL</p>
                <p>efectuado en esta jurisdicción el <strong>@Model.fechacursillo.ToString("dd") - 
                @Model.fechacursillo.ToString("MMMM") - @Model.fechacursillo.ToString("yyyy").</strong></p>
                <p>Fecha del bautismo: <strong>@Model.fechabautizo.ToString("dd") - 
                @Model.fechabautizo.ToString("MMMM") - @Model.fechabautizo.ToString("yyyy")</strong></p>
                <p>Parroquia: <strong>@Model.parroquia</strong></p>
            </p>
        </div>

        <!-- Contenido del certificado -->
        <div class="content">
            
        </div>

        <!-- Pie de página con fecha y firma -->
        <div class="footer">
            <p>Cuenca, a @DateTime.Now.ToString("dd") de @DateTime.Now.ToString("MMMM") de @DateTime.Now.ToString("yyyy")</p>
            @*  <div class="signature">__________________________</div>
            <p>Maestro/a</p> *@
            <div>

                ‎
            </div>
            <div>

                ‎
                @if (!string.IsNullOrEmpty(Model.firmaSacerdote))
                {
                    <img src="data:image/png;base64,@Model.firmaSacerdote" 
                        alt="Firma Sacerdote" 
                        class="img-firma" />
                }
            </div>
            <p>________________________ ‎ ‎‎ ‎ ‎ ‎ ‎ ‎  ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ________________________</p>
            <p>‎‎‎ ‎‎ ‎ ‎‎ ‎‎ ‎ ‎‎ ‎‎ ‎ ‎‎ ‎‎ ‎ ‎‎ ‎‎ ‎ ‎  Párroco ‎ ‎ ‎ ‎ ‎ ‎‎‎ ‎ ‎ ‎  ‎ ‎  ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ Representante Pastoral Familiar</p>

        </div>
    </div>
</body>
</html>
