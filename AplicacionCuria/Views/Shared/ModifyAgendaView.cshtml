@model AplicacionCuria.Models.Agenda
@{
    ViewData["Title"] = "Modificar Evento de Agenda";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="card-title text-primary fw-bold mb-3">
                    <i class="fas fa-calendar-check me-1 text-primary"></i> Modificar Evento de Agenda
                </h4>

                <form asp-action="Edit" asp-controller="Agenda" asp-route-id="@Model.id" method="post" id="formulario" autocomplete="off">
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label for="fechaagenda" class="form-label mb-1 fw-semibold small">Fecha del Evento</label>
                            <input type="date" class="form-control form-control-sm" id="fechaagenda" name="fechaagenda" value="@Model.fechaagenda.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="hora" class="form-label mb-1 fw-semibold small">Hora</label>
                            <input type="time" class="form-control form-control-sm" id="hora" name="hora" value="@Model.hora" required />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label for="lugar" class="form-label mb-1 fw-semibold small">Lugar</label>
                        <input type="text" class="form-control form-control-sm" id="lugar" name="lugar" value="@Model.lugar" required />
                    </div>

                    <div class="mb-3">
                        <label for="descripcion" class="form-label mb-1 fw-semibold small">Descripción</label>
                        <textarea class="form-control form-control-sm" id="descripcion" name="descripcion" rows="3" required>@Model.descripcion</textarea>
                    </div>

                    <div class="d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-primary btn-sm px-4">Guardar Cambios</button>
                        <a href="@Url.Action("MenuAgenda", "Home")" class="btn btn-secondary btn-sm px-3">Cancelar</a>
                    </div>
                    <div class="text-center mt-2">
                        <label id="exito" class="text-success fw-semibold small" style="display: none;">Agenda Actualizada con éxito</label>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById("formulario").addEventListener("submit", function (event) {
        event.preventDefault();

        var formData = new FormData(this);

        fetch(this.action, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            const exito = document.getElementById("exito");
            exito.style.display = "none";

            if (data.success) {
                exito.className = "text-success fw-semibold small";
                exito.textContent = "Agenda Actualizada con éxito. Redirigiendo...";
                exito.style.display = "block";
                setTimeout(function () {
                    window.location.href = "/Home/MenuAgenda";
                }, 1500);
            } else {
                exito.className = "text-danger fw-semibold small";
                exito.textContent = "Error al actualizar la agenda.";
                exito.style.display = "block";
            }
        })
        .catch(error => {
            console.error('Error:', error);
            const exito = document.getElementById("exito");
            exito.className = "text-danger fw-semibold small";
            exito.innerText = "Error de conexión al guardar los cambios.";
            exito.style.display = "block";
        });
    });
</script>
