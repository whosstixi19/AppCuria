@model AplicacionCuria.Models.CursilloPreMatrimonial





<div class="tab-pane fade show active" id="acta-bautismo" role="tabpanel" aria-labelledby="acta-bautismo-tab">
    <div class="row">
        <!-- Formulario de actualización a la izquierda -->

        <div class="col-md-6">
            <div class="d-flex align-items-center mb-3">
                <a class="btn btn-secondary d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="MatrimoniosView" aria-label="Regresar al menú de sacramentos">
                    <i class="fas fa-arrow-left me-1"></i>
                    <span>Volver</span>
                </a>
                <h1 class="ms-3">Modificar Cursillo</h1>
            </div>

            <form asp-action="Edit" asp-controller="CursilloPreMatrimonial" method="post" id="formularioCursillo">
                <h2>Cursillo Pre Matrimonial</h2>
                <div class="row">
                    <!-- Columna para datos del Novio -->
                    <div class="col-md-6">
                        <h4>Datos del Novio</h4>
                        <div class="mb-3">
                            <label for="cursillo_nombrenovio">Nombre del Novio:</label>
                            <input type="text" id="cursillo_nombrenovio" name="nombrenovio" value="@Model.nombrenovio" required class="form-control">
                        </div>
                        <div class="mb-3">
                            <label for="cursillo_cedulanovio">Cédula del Novio:</label>
                            <input type="text" id="cursillo_cedulanovio" name="cedulanovio" value="@Model.cedulanovio" required class="form-control">
                        </div>
                        <div class="mb-3">
                            <label for="cursillo_telefononovio">Teléfono del Novio:</label>
                            <input type="tel" id="cursillo_telefononovio" name="telefononovio" value="@Model.telefononovio" required class="form-control">
                        </div>
                        <div class="mb-3">
                            <label for="fechanacimientonovio">Fecha de Nacimiento del Novio:</label>
                            <input type="date" id="fechanacimientonovio" name="fechanacimientonovio" value="@Model.fechanacimientonovio.ToString("yyyy-MM-dd")" required class="form-control">
                        </div>
                    </div>

                    <!-- Columna para datos de la Novia -->
                    <div class="col-md-6">
                        <h4>Datos de la Novia</h4>
                        <div class="mb-3">
                            <label for="cursillo_nombrenovia">Nombre de la Novia:</label>
                            <input type="text" id="cursillo_nombrenovia" name="nombrenovia" value="@Model.nombrenovia" required class="form-control">
                        </div>
                        <div class="mb-3">
                            <label for="cursillo_cedulanovia">Cédula de la Novia:</label>
                            <input type="text" id="cursillo_cedulanovia" name="cedulanovia" value="@Model.cedulanovia" required class="form-control">
                        </div>
                        <div class="mb-3">
                            <label for="cursillo_telefononovia">Teléfono de la Novia:</label>
                            <input type="tel" id="cursillo_telefononovia" name="telefononovia" value="@Model.telefononovia" required class="form-control">
                        </div>
                        <div class="mb-3">
                            <label for="fechanacimientonovia">Fecha de Nacimiento de la Novia:</label>
                            <input type="date" id="fechanacimientonovia" name="fechanacimientonovia" value="@Model.fechanacimientonovia.ToString("yyyy-MM-dd")" required class="form-control">
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="fechacursillo">Fecha de Cursillo:</label>
                    <input type="date" id="fechacursillo" name="fechacursillo" value="@Model.fechacursillo.ToString("yyyy-MM-dd")" required class="form-control">
                </div>
                <div class="mb-3">
                    <label for="fechamatrimonio">Fecha de Matrimonio:</label>
                    <input type="date" id="fechamatrimonio" name="fechamatrimonio" value="@Model.fechamatrimonio.ToString("yyyy-MM-dd")" required class="form-control">
                </div>

                <div class="mb-3 d-flex align-items-center">
                    <label for="estado" class="form-label">Estado del Cursillo</label>
                    
                    <select class="form-select" id="estado" name="estado" required>
                        <option value="Cursando" selected="@(Model.estado == "Cursando")">Cursando</option>
                        <option value="Aprobado" selected="@(Model.estado == "Aprobado")">Aprobado</option>
                        <option value="Retirado" selected="@(Model.estado == "Retirado")">Retirado</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="parroquia" class="form-label">Parroquia</label>
                    <select class="form-select" id="parroquia" name="parroquia" required>
                        <option value="">-- Seleccione una parroquia --</option>
                    </select>
                    <span class="text-danger" id="parroquiaError"></span>
                </div>

                <div class="mb-3">
                    <label for="observaciones" class="form-label">Observaciones:</label>
                    <textarea id="observaciones" name="observaciones" class="form-control" rows="4">@Model.observaciones</textarea>
                </div>

                <button type="submit" asp-controller="CursilloPreMatrimonial" asp-action="Edit" class="btn btn-primary mt-3" asp-route-id="@Model.id">Actualizar Cursillo</button>
                <label id="exito" class="text-success" style="display: none;">Cursillo Actualizado</label>
            </form>

        </div>
    </div>
</div>


<script>

    function cargarParroquiasCursillo(selectedId = null) {
        fetch('/CursilloPreMatrimonial/GetParroquias')
            .then(response => response.json())
            .then(data => {
                const select = document.getElementById('parroquia');
                select.innerHTML = '<option value="">-- Seleccione una parroquia --</option>';
                data.forEach(p => {
                    const option = document.createElement('option');
                    option.value = p.id;
                    option.textContent = p.nombre;
                    if (selectedId && p.id === selectedId) {
                        option.selected = true;
                    }
                    select.appendChild(option);
                });
            })
            .catch(error => console.error('Error al cargar parroquias:', error));
    }

    document.addEventListener("DOMContentLoaded", () => {
        cargarParroquiasCursillo(@Model.parroquia);
    });



    document.addEventListener("DOMContentLoaded", function () {


        fetch(`/Confirmacion/Valores/${@Model.id}`)
            .then(response => response.json())
            .then(data => {
                // Obtener el valor del ministro del JSON
                const ministro = data.sacerdote;
                const parroquia = data.parroquia;

                // Obtener el elemento select
                console.log(ministro);
                console.log(parroquia);
                const selectElement = document.getElementById('Sacerdote');
                const selectElement2 = document.getElementById('Parroquia');
                selectElement.value = ministro;
                selectElement2.value = parroquia;
            })
            .catch(error => console.error('Error:', error));


    });


    document.getElementById("acta-form").addEventListener("submit", function (event) {
        event.preventDefault(); // Evitar el envío del formulario por defecto

        var formData = new FormData(this);

        fetch(this.action, {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                // Ocultar el label de error al enviar el formulario
                document.getElementById("exito").style.display = "none";

                if (data.success) {
                    // Redirigir a la raíz o hacer otras acciones en caso de éxito

                    document.getElementById("exito").style.display = "block";
                    //location.reload();
                    setTimeout(function () {
                        console.log("Han pasado 5 segundos");
                        window.location.href = "/Home/MenuSacramentos";
                    }, 5000);


                }
            })
            .catch(error => {
                console.error('Error:', error);
                // Opcional: Mostrar un mensaje de error genérico
                document.getElementById("exito").innerText = error;
                document.getElementById("exito").style.display = "block";
            });


    });
</script>