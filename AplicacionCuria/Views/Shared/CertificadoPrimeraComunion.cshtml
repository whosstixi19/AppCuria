@model AplicacionCuria.Models.PrimeraComunionImprimir
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Certificado de Primera Comunión</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            width: 100%;
            font-family: Arial, Helvetica, sans-serif;
            background-color: #FFFFFF;
            padding: 20px 30px;
        }

        .container {
            display: block;
            width: 100%;
            padding: 10px 20px;
            background-color: #FFFFFF;
            text-align: center;
        }

        .header {
            font-size: 26px;
            font-weight: bold;
            color: #D62429;
            margin-top: 8px;
            letter-spacing: 0.5px;
        }

        .sub-header {
            font-size: 18px;
            color: #333;
            margin: 10px 0 15px;
        }

        .content {
            font-size: 17px;
            color: #000;
            line-height: 1.6;
            margin: 0 10%;
        }

        .footer {
            font-size: 15px;
            margin-top: 25px;
        }

        .firma {
            text-align: center;
            margin-top: 25px;
        }

        .firma-box {
            min-height: 65px;
            display: block;
            margin-bottom: 5px;
        }

        .img-firma {
            max-height: 65px;
            max-width: 200px;
            width: auto;
            height: auto;
            object-fit: contain;
            display: block;
            margin: 0 auto;
        }

        .linea-firma {
            border-top: 1px solid #000;
            width: 220px;
            margin: 0 auto 5px auto;
        }

        .mmmm {
            width: 100%;
            text-align: center;
            margin-bottom: 10px;
        }

        .badge {
            max-height: 85px;
            max-width: 120px;
            object-fit: contain;
            height: auto;
            width: auto;
            display: inline-block;
            margin: 0 25px;
            vertical-align: middle;
        }

        .badgee {
            max-height: 85px;
            max-width: 120px;
            object-fit: contain;
            height: auto;
            width: auto;
            display: inline-block;
            margin: 0 25px;
            vertical-align: middle;
        }

        .fecha {
            margin-top: 15px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Imagen del escudo -->
        <div class="mmmm">
            <img src="@(ViewData["LogoParroquia"] as string ?? Url.Content("~/imagenes/escudo.png"))" alt="Escudo" class="badge" />
            <img src="~/imagenes/comunion.jpg" alt="Primera Comunión" class="badgee" />
        </div>
       
        <!-- Encabezado del certificado -->
        <div class="header">CERTIFICADO DE PRIMERA COMUNIÓN</div>
        <div class="sub-header">Este certificado es otorgado a</div>

        <!-- Contenido del certificado -->
        <div class="content">
            <p><strong>Nombre del Alumno:</strong> @Model.Alumno.nombre @Model.Alumno.apellido</p>
            <p>Por haber recibido el sacramento de la Primera Comunión y demostrar su compromiso con la fe católica.</p>
        </div>

        <!-- Pie de página con fecha y firma -->
        <div class="footer">
            <div class="firma">
                <div class="firma-box">
                    @if (!string.IsNullOrEmpty(Model.FirmaSacerdote))
                    {
                        <img src="data:image/png;base64,@Model.FirmaSacerdote" alt="Firma Sacerdote" class="img-firma" />
                    }
                </div>
                <div class="linea-firma"></div>
                <p style="margin: 0; font-weight: bold;">@Model.NombreSacerdote</p>
                <p style="margin: 0;">SACERDOTE</p>
            </div>
            <p class="fecha">Cuenca, a @DateTime.Now.ToString("dd") de @DateTime.Now.ToString("MMMM") de @DateTime.Now.ToString("yyyy")</p>
            <p style="margin-top: 10px; font-style: italic;">"Yo soy el pan de vida. El que viene a mí nunca tendrá hambre, y el que cree en mí nunca tendrá sed."</p>
            <p><em>(Juan 6:35)</em></p>
        </div>
    </div>
</body>
</html>
