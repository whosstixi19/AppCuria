@model AplicacionCuria.Models.Usuario

@{
    ViewData["Title"] = "Inicio de Sesión";
    var email = ViewBag.Email ?? "";
    var errorType = ViewBag.ErrorType ?? "";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow rounded-3">
                <div class="card-body">
                    <img src="~/imagenes/logoiglesia.jpg" alt="Logo Iglesia" width="120" class="mb-3 d-block mx-auto" />
                    <h3 class="text-center mb-4">Inicio de Sesión</h3>

                    <form asp-controller="Auth" asp-action="Login" method="post">
                        <div class="mb-3">
                            <label for="Email" class="form-label">Correo electrónico</label>
                            <input type="text" class="form-control" id="Email" name="Email" value="@email" required />
                        </div>

                        <div class="mb-3">
                            <label for="Password" class="form-label">Contraseña</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="Password" name="Password" required />
                                <button class="btn btn-outline-secondary" type="button" id="btnTogglePassword" tabindex="-1" title="Mostrar/ocultar contraseña">
                                    <i class="fas fa-eye" id="iconTogglePassword"></i>
                                </button>
                            </div>
                            @if (ViewBag.Error != null)
                            {
                                <span id="errorMessage" class="text-danger">@ViewBag.Error</span>
                            }
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Iniciar Sesión</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        const errorType = "@errorType";
        const emailInput = document.getElementById('Email');
        const passwordInput = document.getElementById('Password');
        const errorMessage = document.getElementById('errorMessage');

        window.addEventListener('DOMContentLoaded', function () {
            if (errorType === "email") {
                emailInput.value = "";
                passwordInput.value = "";
                emailInput.focus();
            } else if (errorType === "password") {
                passwordInput.value = "";
                passwordInput.focus();
            }
        });

        function clearError() {
            if (errorMessage) {
                errorMessage.style.display = 'none';
            }
        }

        emailInput?.addEventListener('input', clearError);
        passwordInput?.addEventListener('input', clearError);

        const btnTogglePassword = document.getElementById('btnTogglePassword');
        const iconTogglePassword = document.getElementById('iconTogglePassword');
        btnTogglePassword?.addEventListener('click', function () {
            const isPassword = passwordInput.getAttribute('type') === 'password';
            passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
            iconTogglePassword.classList.toggle('fa-eye', !isPassword);
            iconTogglePassword.classList.toggle('fa-eye-slash', isPassword);
        });
    </script>
}
